<script>
  // Comparison table (.quick_compare) follows the selected variant.
  //
  // Each .quick_compare is tagged data-variant-id="<variant id>". Horizon's size
  // buttons have value="King" (the size name) and data-variant-id="<variant id>",
  // so we match on the variant id. A table tagged with the size name instead
  // (data-variant-id="King") also works.
  //
  // Sources of the selected variant, in order:
  //   1. Horizon's 'variant:update' event (fires after every variant change)
  //   2. the size button that changed (its data-variant-id)
  //   3. on page load: the buy form's id, ?variant= in the URL, or the checked buttons
  // The last choice is re-applied when Horizon re-renders the page.
  (function () {
    if (window.__tgCompareInit) return;
    window.__tgCompareInit = true;

    var current = { id: null, size: null };

    function key(v) { return String(v == null ? '' : v).toLowerCase().replace(/\s+/g, ' ').trim(); }

    function apply() {
      var boxes = document.querySelectorAll('.quick_compare');
      if (!boxes.length || (!current.id && !current.size)) return;

      function matches(box) {
        var tag = box.getAttribute('data-variant-id');
        if (tag == null) return false;
        if (current.id && String(tag) === String(current.id)) return true;
        return !!current.size && key(tag) === key(current.size);
      }

      // No table for this variant: leave the current one showing instead of hiding all
      var any = false;
      for (var i = 0; i < boxes.length; i++) if (matches(boxes[i])) { any = true; break; }
      if (!any) return;

      for (var j = 0; j < boxes.length; j++) {
        var want = matches(boxes[j]) ? 'block' : 'none';
        if (boxes[j].style.display !== want) boxes[j].style.display = want;
      }
    }

    function sizeFromPicker() {
      var picker = document.querySelector('variant-picker[data-template-product-match="true"]') ||
                   document.querySelector('.variant-picker-wrap variant-picker');
      if (!picker) return null;
      var sets = picker.querySelectorAll('fieldset');
      for (var i = 0; i < sets.length; i++) {
        var legend = sets[i].querySelector('legend');
        if (legend && key(legend.textContent).indexOf('size') === 0) {
          var c = sets[i].querySelector('input[type="radio"]:checked');
          return c ? c.value : null;
        }
      }
      return null;
    }

    function variantFromPage() {
      var form = document.querySelector('form[id^="BuyButtons-ProductForm"] input[name="id"]') ||
                 document.querySelector('form[action*="/cart/add"] input[name="id"]');
      if (form && form.value) return form.value;
      var p = new URLSearchParams(window.location.search).get('variant');
      if (p) return p;
      var picker = document.querySelector('variant-picker[data-template-product-match="true"]') ||
                   document.querySelector('.variant-picker-wrap variant-picker');
      var json = picker && picker.querySelector('script[type="application/json"]');
      if (json) {
        try { return JSON.parse(json.textContent).id; } catch (e) {}
      }
      return null;
    }

    function set(id, size) {
      if (id) current.id = String(id);
      current.size = size || sizeFromPicker();
      apply();
    }

    // 1. Horizon announces the new variant after every change
    document.addEventListener('variant:update', function (e) {
      var v = e.detail && e.detail.resource;
      if (v && v.id) set(v.id, null);
    });

    // 2. A size (or other option) button was chosen
    document.addEventListener('change', function (e) {
      var input = e.target;
      if (!input || input.type !== 'radio' || !input.closest('label.variant-option__button-label')) return;

      document.querySelectorAll('.size-option').forEach(function (btn) {
        btn.classList.remove('selected');
      });
      input.classList.add('selected');

      set(input.getAttribute('data-variant-id'), null);
    });

    // 3. Page load
    function init() { set(variantFromPage(), null); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
    window.addEventListener('load', init);

    // Horizon swaps page sections on a variant change: put the right table back
    var queued = false;
    new MutationObserver(function () {
      if (queued) return;
      queued = true;
      requestAnimationFrame(function () { queued = false; apply(); });
    }).observe(document.body, { childList: true, subtree: true });
  })();
</script>


<script>
(function() {
  function positionSizeGuide() {
    var link = document.querySelector('.variant-size-guide-link');
    if (!link) return;
    var wrap = link.closest('.variant-picker-wrap');
    if (!wrap) return;

    var sizeLabel = null;
    var allEls = wrap.querySelectorAll('*');

    // Find exact "size" label
    for (var i = 0; i < allEls.length; i++) {
      var el = allEls[i];
      if (el.children.length > 0) continue;
      var txt = el.textContent.trim().toLowerCase();
      if (txt === 'size') {
        sizeLabel = el;
        break;
      }
    }

    // Fallback — partial match
    if (!sizeLabel) {
      for (var j = 0; j < allEls.length; j++) {
        var el2 = allEls[j];
        if (el2.children.length > 0) continue;
        var txt2 = el2.textContent.trim().toLowerCase();
        if (txt2.includes('size') && txt2.length < 20) {
          sizeLabel = el2;
          break;
        }
      }
    }

    if (!sizeLabel) return;

    var wrapRect  = wrap.getBoundingClientRect();
    var labelRect = sizeLabel.getBoundingClientRect();
    var linkRect  = link.getBoundingClientRect();

    var top = labelRect.top - wrapRect.top + (labelRect.height / 2) - (linkRect.height / 2);

    link.style.top = Math.round(top) + 'px';
    link.classList.add('is-positioned');
  }

  function run() {
    setTimeout(positionSizeGuide, 100);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }

  window.addEventListener('load', positionSizeGuide);

  document.addEventListener('change', function(e) {
    if (e.target && e.target.type === 'radio' && e.target.closest('.variant-picker-wrap')) {
      setTimeout(positionSizeGuide, 100);
    }
  });

  var observer = new MutationObserver(function() {
    setTimeout(positionSizeGuide, 100);
  });

  function watch() {
    var wrap = document.querySelector('.variant-picker-wrap');
    if (wrap) observer.observe(wrap, { childList: true, subtree: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', watch);
  } else {
    watch();
  }
})();
</script>


<script>
/* ── V1 #4 size chips with dimensions + #6 calm stock line ── */
(function() {
  if (window.__tgChipsInit) return;
  window.__tgChipsInit = true;

  var CHECK_SVG = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';

  function key(v) { return String(v || '').toLowerCase().replace(/\s+/g, ' ').trim(); }

  function dims() { return window.TangelosSizeDims || {}; }

  function isSizeFieldset(fs) {
    var name = window.TangelosSizeOptionName || 'size';
    var legend = fs.querySelector('legend');
    if (legend && key(legend.textContent).indexOf(name) === 0) return true;
    var radios = fs.querySelectorAll('input[type="radio"]');
    for (var i = 0; i < radios.length; i++) {
      if (dims()[key(radios[i].value)]) return true;
    }
    return false;
  }

  function labelFor(input, fs) {
    var label = input.closest('label');
    if (!label && input.id) label = fs.querySelector('label[for="' + input.id + '"]');
    if (!label && input.nextElementSibling && input.nextElementSibling.tagName === 'LABEL') label = input.nextElementSibling;
    return label;
  }

  var STOCK_TEXT = { 'in': 'In stock', 'order': 'Available to order', 'out': 'Out of stock' };

  function updateStock(wrap) {
    var line = wrap.querySelector('[data-tg-stock]');
    var dataEl = wrap.querySelector('[data-tg-variants]');
    if (!line || !dataEl) return;

    var data;
    try { data = JSON.parse(dataEl.textContent); } catch (e) { return; }

    var selected = [];
    var groups = wrap.querySelectorAll('fieldset, select');
    for (var g = 0; g < groups.length; g++) {
      var grp = groups[g];
      if (grp.tagName === 'SELECT') {
        if (grp.closest('fieldset')) continue;
        selected.push(grp.value);
      } else {
        var checked = grp.querySelector('input[type="radio"]:checked');
        if (checked) {
          selected.push(checked.value);
        } else {
          var sel = grp.querySelector('select');
          if (sel) selected.push(sel.value);
        }
      }
    }

    var match = null;
    for (var i = 0; i < data.variants.length && !match; i++) {
      var opts = data.variants[i].options;
      if (opts.length !== selected.length) continue;
      var same = true;
      for (var o = 0; o < opts.length; o++) {
        if (String(opts[o]) !== String(selected[o])) { same = false; break; }
      }
      if (same) match = data.variants[i];
    }

    var state = match ? match.state : 'out';
    var parts = [];
    if (data.sizePos > -1 && selected[data.sizePos] != null) parts.push(selected[data.sizePos]);
    for (var p = 0; p < selected.length; p++) {
      if (p !== data.sizePos) parts.push(selected[p]);
    }

    var statusEl = line.querySelector('[data-tg-stock-status]');
    var metaEl = line.querySelector('[data-tg-stock-meta]');
    var statusText = match ? STOCK_TEXT[state] : 'Unavailable';
    var metaText = parts.length ? '· ' + parts.join(' · ') : '';
    var cls = 'tg-stock tg-stock--' + (match ? state : 'out');

    var qtyEl = line.querySelector('[data-tg-stock-qty]');
    var qtyText = (match && state === 'in' && match.qty > 0) ? '· ' + match.qty + ' left' : '';

    if (line.className !== cls) line.className = cls;
    if (statusEl && statusEl.textContent !== statusText) statusEl.textContent = statusText;
    if (qtyEl) {
      if (qtyEl.textContent !== qtyText) qtyEl.textContent = qtyText;
      if (qtyEl.hidden !== !qtyText) qtyEl.hidden = !qtyText;
    }
    if (metaEl && metaEl.textContent !== metaText) metaEl.textContent = metaText;
  }

  function upgrade() {
    var allWraps = document.querySelectorAll('.variant-picker-wrap');
    for (var aw = 0; aw < allWraps.length; aw++) updateStock(allWraps[aw]);

    if (!window.TangelosSizeDims) return;
    for (var w = 0; w < allWraps.length; w++) {
      var sets = allWraps[w].querySelectorAll('fieldset');
      for (var s = 0; s < sets.length; s++) {
        var fs = sets[s];
        if (!fs.querySelector('input[type="radio"]') || !isSizeFieldset(fs)) continue;
        if (!fs.classList.contains('tg-size-fieldset')) fs.classList.add('tg-size-fieldset');

        var radios = fs.querySelectorAll('input[type="radio"]');
        for (var r = 0; r < radios.length; r++) {
          var input = radios[r];
          var label = labelFor(input, fs);
          if (!label) continue;

          if (!label.classList.contains('tg-size-chip')) label.classList.add('tg-size-chip');
          label.classList.toggle('tg-selected', input.checked);
          label.classList.toggle('tg-unavailable',
            input.disabled ||
            input.classList.contains('disabled') ||
            input.getAttribute('data-option-available') === 'false');

          var d = dims()[key(input.value)];
          if (d && !label.querySelector('.tg-dim')) {
            var span = document.createElement('span');
            span.className = 'tg-dim';
            span.textContent = d;
            label.appendChild(span);
          }
          if (!label.querySelector('.tg-check')) {
            var check = document.createElement('span');
            check.className = 'tg-check';
            check.setAttribute('aria-hidden', 'true');
            check.innerHTML = CHECK_SVG;
            label.appendChild(check);
          }
        }
      }
    }
  }

  var queued = false;
  function queue() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(function() { queued = false; upgrade(); });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', upgrade);
  } else {
    upgrade();
  }

  // Horizon re-renders the picker on each variant change, so re-apply after every change.
  document.addEventListener('change', function(e) {
    if (e.target && e.target.type === 'radio' && e.target.closest('.variant-picker-wrap')) queue();
  });
  new MutationObserver(queue).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>


