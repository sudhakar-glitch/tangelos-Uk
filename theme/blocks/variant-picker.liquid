<script>
(function () {
  'use strict';

  // Prevent double-binding if this block is rendered more than once on the page
  if (window.__upsellAddonsInit) return;
  window.__upsellAddonsInit = true;

  // ── CONFIG ──────────────────────────────────────────────────────────────
  const SIZE_RADIO_SELECTOR = 'input[type="radio"]';
  const POPUP_ID            = 'upsell-image-popup';
  const ZOOM_IMAGE_WIDTH    = 1600;

  // Percale + Muslin products: pillowcases follow the selected size
  // (King / Super King -> King pillowcases, every other size -> Standard).
  const PILLOW_FOLLOWS_SIZE = {% if product.title contains 'Percale' or product.title contains 'Muslin' %}true{% else %}false{% endif %};

  // Size of the variant the page opens on — used when no size radio is checked yet.
  const INITIAL_SIZE = {{ product.selected_or_first_available_variant.option1 | json }};
  // ────────────────────────────────────────────────────────────────────────

  let _isMuslinDuvet = null;
  function isMuslinDuvet() {
    if (_isMuslinDuvet === null) {
      const h1 = document.querySelector('h1');
      const t  = (h1 ? h1.textContent : '').toLowerCase();
      _isMuslinDuvet = t.indexOf('muslin') !== -1 && t.indexOf('duvet') !== -1;
    }
    return _isMuslinDuvet;
  }

  function setText(el, text) {
    if (el) el.textContent = text;
  }

  function parseVariants(item) {
    try {
      const parsed = JSON.parse(item.dataset.variants || '[]');
      return Array.isArray(parsed) ? parsed : [];
    } catch (err) {
      console.warn('[upsell] Invalid data-variants JSON on', item, err);
      return [];
    }
  }

  function imageUrl(img) {
    if (!img) return '';
    if (typeof img === 'string') return img;
    return img.src || img.url || '';
  }

  // £25 for whole pounds, £24.99 otherwise
  function formatMoney(cents) {
    const n = Number(cents);
    if (isNaN(n)) return '';
    return '£' + (n % 100 === 0 ? (n / 100).toFixed(0) : (n / 100).toFixed(2));
  }

  function buildLabelParts(title, price, compareAtPrice) {
    let heading = title;
    if (title.includes('Fitted Sheet')) {
      heading = 'Complete the Bed';
    } else if (title.includes('Pillowcase')) {
      heading = 'Complete the Look';
    } else if (title.includes('Mattress Protector')) {
      heading = 'Protect Your Mattress';
    }
    return {
      heading,
      subtitle: title,
      priceNow: formatMoney(price),
      priceWas: Number(compareAtPrice) > Number(price) ? formatMoney(compareAtPrice) : ''
    };
  }

  // ── Stock badge (main product, selected size) ───────────────────────────
  let _mainStock = null;
  let _lastSize  = null;
  let _freshReq  = null;

  function getMainStock() {
    if (_mainStock === null) {
      try {
        const el = document.getElementById('upsell-main-stock');
        _mainStock = el ? JSON.parse(el.textContent) : [];
      } catch (e) {
        _mainStock = [];
      }
    }
    return _mainStock;
  }

  function refreshStock() {
    if (_freshReq) return _freshReq;
    const url = window.location.pathname + '?view=stock&_t=' + Date.now();
    _freshReq = fetch(url, { cache: 'no-store', credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.text() : ''; })
      .then(function (txt) {
        const data = JSON.parse(txt);
        if (Array.isArray(data) && data.length) _mainStock = data;
      })
      .catch(function () { /* keep the page's own numbers */ })
      .then(function () { if (_lastSize !== null) renderStockBadge(_lastSize); });
    return _freshReq;
  }

  function renderStockBadge(selectedSize) {
    const badge     = document.getElementById('upsell-stock-badge');
    const badgeText = document.getElementById('upsell-stock-text');
    if (!badge || !badgeText) return;

    const want    = normSize(selectedSize);
    const matched = getMainStock().find(v => normSize(v.size) === want);
    badge.dataset.painted = '1';

    if (!matched || !matched.tracked) {
      badge.style.display = 'none';
      return;
    }

    if (matched.inventory > 0) {
      badgeText.textContent = 'Only ' + matched.inventory + ' left in ' + matched.size;
      badgeText.style.color = matched.inventory <= 5 ? '#e07000' : '';
    } else {
      badgeText.textContent = 'Out of stock in ' + matched.size;
      badgeText.style.color = '#cc0000';
    }
    badge.style.display = 'inline-flex';
  }

  function updateStockBadge(selectedSize) {
    _lastSize = selectedSize;
    renderStockBadge(selectedSize);
    refreshStock();
  }

  if (window.MutationObserver) {
    new MutationObserver(function () {
      const badge = document.getElementById('upsell-stock-badge');
      if (badge && !badge.dataset.painted && _lastSize !== null) renderStockBadge(_lastSize);
    }).observe(document.body, { childList: true, subtree: true });
  }

  // ── Upsell items ────────────────────────────────────────────────────────
  function normSize(s) {
    return String(s || '').toLowerCase().replace(/[^a-z]/g, '');
  }

  function findBySize(variants, want) {
    return variants.find(v => normSize(v.size) === want) ||
           variants.find(v => normSize(v.size).indexOf(want) === 0);
  }

  function findVariant(variants, title, selectedSize) {
    const isPillow = /pillow\s*case/i.test(title);

    if (isPillow && PILLOW_FOLLOWS_SIZE) {
      const size = normSize(selectedSize);
      const want = (size === 'king' || size === 'superking') ? 'king' : 'standard';
      return findBySize(variants, want) || findBySize(variants, 'standard') || variants[0];
    }

    const pillowOnMuslin = isMuslinDuvet() && isPillow;
    const sizeToMatch    = pillowOnMuslin ? 'Standard' : selectedSize;

    let matched = variants.find(v => v.size === sizeToMatch);

    if (!matched && pillowOnMuslin) {
      matched = variants.find(v => v.size && String(v.size).toLowerCase().indexOf('standard') !== -1);
    }
    return matched || variants[0];
  }

  function resetAddButton(item) {
    const btn = item.querySelector('.upsell-add-btn');
    if (!btn) return;
    btn.classList.remove('is-added');
    setText(btn.querySelector('.upsell-add-btn-label'), 'Add Now');
    btn.setAttribute('aria-pressed', 'false');
  }

  function updateUpsells(selectedSize) {
    document.querySelectorAll('.upsell-addon-item').forEach(function (item) {
      try {
        const title   = item.dataset.productTitle || '';
        const matched = findVariant(parseVariants(item), title, selectedSize);

        if (!matched) {
          item.style.display = 'none';
          return;
        }

        const checkbox = item.querySelector('.upsell-addon-checkbox');
        if (checkbox) {
          checkbox.value             = matched.id;
          checkbox.dataset.variantId = matched.id;
          checkbox.dataset.price     = matched.price;
          checkbox.checked           = false;
        }
        resetAddButton(item);

        const parts = buildLabelParts(title, matched.price, matched.compare_at_price);
        setText(item.querySelector('.upsell-addon-heading'),   parts.heading);
        setText(item.querySelector('.upsell-addon-price-now'), parts.priceNow);
        setText(item.querySelector('.upsell-addon-price-was'), parts.priceWas);

        const sizeEl = item.querySelector('.selected-pill-sizes');
        if (sizeEl) {
          const size = matched.size && matched.size !== 'Default Title' ? String(matched.size).trim() : '';
          sizeEl.textContent = size ? 'Size: ' + size : '';
          sizeEl.hidden = !size;
        }

        const image = item.querySelector('.upsell-addon-image');
        const src   = imageUrl(matched.image);
        if (image && src) {
          image.src = src;
          image.removeAttribute('srcset');
          image.dataset.fullSrc = src;
        }

        item.style.display = '';
      } catch (err) {
        console.warn('[upsell] Could not update item', item, err);
      }
    });

    updateStockBadge(selectedSize);
  }

  // ── Add Now toggle ──────────────────────────────────────────────────────
  function toggleAddButton(btn) {
    const item     = btn.closest('.upsell-addon-item');
    const checkbox = item && item.querySelector('.upsell-addon-checkbox');
    if (!checkbox) return;

    const nowAdded = !checkbox.checked;
    checkbox.checked = nowAdded;
    btn.classList.toggle('is-added', nowAdded);
    setText(btn.querySelector('.upsell-add-btn-label'), nowAdded ? 'Added' : 'Add Now');
    btn.setAttribute('aria-pressed', String(nowAdded));
  }

  // ── Image zoom ──────────────────────────────────────────────────────────
  function usable(src) {
    return src && src.indexOf('data:') !== 0 ? src : '';
  }

  function largestFromSrcset(srcset) {
    let best = '';
    let bestW = 0;
    (srcset || '').split(',').forEach(function (entry) {
      const parts = entry.trim().split(/\s+/);
      if (!parts[0]) return;
      const w = parseInt(parts[1], 10) || 1;
      if (w >= bestW) { bestW = w; best = parts[0]; }
    });
    return best;
  }

  function getZoomSource(img) {
    return usable(img.dataset.fullSrc) ||
           usable(largestFromSrcset(img.getAttribute('srcset') || img.dataset.srcset)) ||
           usable(img.currentSrc) ||
           usable(img.dataset.src) ||
           usable(img.getAttribute('src')) ||
           '';
  }

  function upscaleShopifyUrl(src) {
    if (!src || !/cdn\.shopify\.com|\/cdn\/shop\//.test(src)) return src;
    try {
      const url = new URL(src, window.location.href);
      url.pathname = url.pathname.replace(
        /_(\d+x\d*|x\d+|pico|icon|thumb|small|compact|medium|large|grande)(_crop_[a-z]+)?(@\dx)?(?=\.[a-z0-9]+$)/i,
        ''
      );
      url.searchParams.set('width', ZOOM_IMAGE_WIDTH);
      url.searchParams.delete('height');
      url.searchParams.delete('crop');
      return url.toString();
    } catch (err) {
      return src;
    }
  }

  function injectFallbackStyles() {
    if (document.getElementById('upsell-popup-fallback-css')) return;
    const p = '#' + POPUP_ID;
    const css =
      ':where(' + p + '){position:fixed;inset:0;z-index:2147483000;display:none;align-items:center;justify-content:center;padding:20px;box-sizing:border-box}' +
      ':where(' + p + '.is-open){display:flex}' +
      ':where(' + p + ' .upsell-image-popup-backdrop){position:absolute;inset:0;background:rgba(0,0,0,.75);cursor:zoom-out}' +
      ':where(' + p + ' .upsell-image-popup-inner){position:relative;z-index:1;max-width:min(92vw,900px);max-height:90vh}' +
      ':where(' + p + ' .upsell-image-popup-img){position:relative;z-index:1;display:block;max-width:100%;max-height:90vh;width:auto;height:auto;object-fit:contain;background:#fff;border-radius:4px}' +
      ':where(' + p + ' .upsell-image-popup-close){position:absolute;top:10px;right:10px;z-index:2;width:36px;height:36px;padding:0;border:0;border-radius:50%;background:#fff;color:#000;font-size:22px;line-height:36px;text-align:center;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.25)}' +
      ':where(html.upsell-popup-lock),:where(html.upsell-popup-lock body){overflow:hidden}';
    const style = document.createElement('style');
    style.id = 'upsell-popup-fallback-css';
    style.textContent = css;
    document.head.insertBefore(style, document.head.firstChild);
  }

  function getPopup(createIfMissing) {
    let popup = document.getElementById(POPUP_ID);

    if (!popup && createIfMissing) {
      popup = document.createElement('div');
      popup.id = POPUP_ID;
      popup.className = 'upsell-image-popup';
      popup.setAttribute('aria-hidden', 'true');
      popup.innerHTML =
        '<div class="upsell-image-popup-backdrop"></div>' +
        '<div class="upsell-image-popup-inner">' +
          '<button type="button" class="upsell-image-popup-close" aria-label="Close">&times;</button>' +
          '<img class="upsell-image-popup-img" alt="">' +
        '</div>';
    }
    if (!popup) return null;

    if (popup.parentNode !== document.body) document.body.appendChild(popup);

    if (!popup.querySelector('.upsell-image-popup-img')) {
      const img = document.createElement('img');
      img.className = 'upsell-image-popup-img';
      popup.appendChild(img);
    }
    popup.setAttribute('role', 'dialog');
    popup.setAttribute('aria-modal', 'true');
    return popup;
  }

  let lastFocused = null;

  function openPopup(src, fallbackSrc, alt) {
    const popup = getPopup(true);
    if (!popup || !src) return;

    const img = popup.querySelector('.upsell-image-popup-img');
    img.onerror = function () {
      img.onerror = null;
      if (fallbackSrc && fallbackSrc !== src) img.src = fallbackSrc;
    };
    img.removeAttribute('srcset');
    img.removeAttribute('loading');
    img.alt = alt || '';
    img.src = src;

    lastFocused = document.activeElement;
    popup.classList.add('is-open');
    popup.setAttribute('aria-hidden', 'false');
    document.documentElement.classList.add('upsell-popup-lock');

    const closeBtn = popup.querySelector('.upsell-image-popup-close');
    if (closeBtn) closeBtn.focus({ preventScroll: true });
  }

  function closeImagePopup() {
    const popup = document.getElementById(POPUP_ID);
    if (!popup || !popup.classList.contains('is-open')) return;

    if (lastFocused && typeof lastFocused.focus === 'function') {
      lastFocused.focus({ preventScroll: true });
    }
    popup.classList.remove('is-open');
    popup.setAttribute('aria-hidden', 'true');
    document.documentElement.classList.remove('upsell-popup-lock');
  }

  // ── Delegated events ────────────────────────────────────────────────────
  document.addEventListener('click', function (e) {
    const zoomBtn = e.target.closest && e.target.closest('.upsell-thumb-zoom');
    if (!zoomBtn) return;

    e.preventDefault();
    e.stopPropagation();

    const item = zoomBtn.closest('.upsell-addon-item');
    const img  = item && item.querySelector('.upsell-addon-image');
    if (!img) return;

    const original = getZoomSource(img);
    openPopup(upscaleShopifyUrl(original), original, img.alt);
  }, true);

  document.addEventListener('click', function (e) {
    if (!e.target.closest) return;

    const addBtn = e.target.closest('.upsell-add-btn');
    if (addBtn) {
      e.preventDefault();
      toggleAddButton(addBtn);
      return;
    }

    const popup = document.getElementById(POPUP_ID);
    if (popup && popup.classList.contains('is-open') &&
        (e.target === popup ||
         e.target.closest('.upsell-image-popup-backdrop') ||
         e.target.closest('.upsell-image-popup-close'))) {
      e.preventDefault();
      closeImagePopup();
    }
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeImagePopup();
  });

  document.addEventListener('change', function (e) {
    const t = e.target;
    if (t && t.matches && t.matches(SIZE_RADIO_SELECTOR) && t.checked) {
      updateUpsells(t.value);
    }
  });

  // ── Init ────────────────────────────────────────────────────────────────
  function init() {
    injectFallbackStyles();
    getPopup(false);

    const initialRadio = document.querySelector(SIZE_RADIO_SELECTOR + ':checked');
    updateUpsells(initialRadio ? initialRadio.value : INITIAL_SIZE);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

        {% else %}
         <div class="checkbox-products" data-variant-id="{{ variant.id }}" style="display:none">
        <ul>
          {% for item_product in flavors.value %}
            <li>
              {% assign fv = item_product.variants.first %}
              <label class="pretty-checkbox">
              <input class="upsell-addon-checkbox" type="checkbox" name="product-id" data-price="{{ fv.price }}" value="{{ fv.id }}" data-variant-id="{{ fv.id }}">
               {% if item_product.title contains 'Fitted Sheet' %}
              <span> Add {{ item_product.title }}  for {{ fv.compare_at_price | money | split: '.' | first }} & save {{ fv.price | money | split: '.' | first }} with this order</span>
                {% endif %}
                {% if item_product.title contains 'Pillowcase' %}
               <span> Complete the look with a pair of {{ item_product.title }} - {{ fv.price | money | split: '.' | first }} </span>
                {% endif %}
                 {% if item_product.title contains 'Mattress Protectors' %}
               <span>Add {{ item_product.title }} worth for  {{ fv.compare_at_price | money | split: '.' | first }} & save {{ fv.price | money | split: '.' | first }} with this order</span>
                {% endif %}
               </label>
        </li>
          {% endfor %}
        </ul>
        </div>
        {% endif %}
