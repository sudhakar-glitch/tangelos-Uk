{% endfor %}


{% stylesheet %}
  /* ── Size guide popup ── */
  .popup-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .popup-overlay.active {
    display: flex;
  }

  .popup-inner {
    background: #fff;
    padding: 40px;
    max-width: 700px;
    width: 90%;
    max-height: 80vh;
    overflow-y: auto;
    border-radius: 8px;
    position: relative;
    animation: popupFadeIn 0.3s ease;
  }

  .popup-close {
    position: absolute;
    top: 12px;
    right: 16px;
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    line-height: 1;
  }

  @keyframes popupFadeIn {
    from { opacity: 0; transform: translateY(-20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Picker layout ── */
  .variant-picker-wrap {
    position: relative;
  }

  .variant-picker__form {
    margin-top: 15px;
  }

  /* Size guide — hidden until JS positions it correctly */
  .variant-size-guide-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.45);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(0,0,0,0.25);
    transition: color 0.2s ease;
    position: absolute;
    right: 0;
    z-index: 1;
    line-height: 1;
    visibility: hidden;
  }

  .variant-size-guide-link.is-positioned {
    visibility: visible;
  }

  .variant-size-guide-link:hover {
    color: rgba(0,0,0,0.8);
    text-decoration-color: rgba(0,0,0,0.5);
  }

  a.sizeguide.variant-size-guide-link.is-positioned {
    position: unset;
    float: right;
  }

  .variant-option.variant-option--buttons.variant-option--swatches {
    display: flex;
    flex-direction: column;
    padding-bottom: 0;
  }

  /* Top space before size variant */
  .variant-option + .variant-option {
    margin-top: 45px;
  }

  /* ── Color swatch size 30px ── */
  .variant-picker-wrap [class*="swatch"],
  .variant-picker-wrap [class*="color-swatch"],
  .variant-picker-wrap [data-swatch],
  .variant-picker-wrap input[type="radio"] + label[style*="background"],
  .variant-picker-wrap .swatch,
  .variant-picker-wrap .color-swatch {
    width: 30px !important;
    height: 30px !important;
    min-width: 30px !important;
    min-height: 30px !important;
    border-radius: 50% !important;
  }

  /* ── V1 #4 · Size chips with dimensions ── */
  .variant-picker-wrap .tg-size-fieldset {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .variant-picker-wrap .tg-size-fieldset > legend {
    grid-column: 1 / -1;
  }

  .variant-picker-wrap .tg-size-chip {
    position: relative !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    justify-content: center !important;
    gap: 2px;
    width: auto !important;
    height: auto !important;
    min-width: 0 !important;
    min-height: 56px !important;
    margin: 0 !important;
    padding: 10px 40px 10px 14px !important;
    border: 1px solid #DCD6CC !important;
    border-radius: 8px !important;
    background: #FFFFFF !important;
    color: #1A1A1A !important;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.25;
    text-align: left;
    letter-spacing: 0;
    text-transform: none;
    box-shadow: none !important;
    cursor: pointer;
    transition: border-color 150ms ease, background-color 150ms ease;
  }

  .variant-picker-wrap .tg-size-chip > *:not(input):not(.tg-dim):not(.tg-check):not(svg) {
    position: relative;
    z-index: 1;
    color: inherit !important;
    background: transparent !important;
  }

  /* Theme's radio sits over the chip: keep it clickable but invisible */
  .variant-picker-wrap .tg-size-chip input[type="radio"] {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    opacity: 0 !important;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
    z-index: 2;
  }

  /* Theme's own selected fill (pseudo-elements) is replaced by ours */
  .variant-picker-wrap .tg-size-chip.tg-selected::before,
  .variant-picker-wrap .tg-size-chip.tg-selected::after,
  .variant-picker-wrap .tg-size-chip:has(input:checked)::before,
  .variant-picker-wrap .tg-size-chip:has(input:checked)::after {
    display: none !important;
  }

  .variant-picker-wrap .tg-size-chip:hover {
    border-color: #1A1A1A !important;
  }

  .variant-picker-wrap .tg-size-chip .tg-dim {
    position: relative;
    z-index: 1;
    display: block;
    font-size: 12px;
    font-weight: 400;
    color: #6B665E;
  }

  .variant-picker-wrap .tg-size-chip .tg-check {
    position: absolute;
    top: 50%;
    right: 14px;
    display: none;
    width: 18px;
    height: 18px;
    margin-top: -9px;
    border-radius: 50%;
    background: #1A1A1A;
    color: #FFFFFF;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .variant-picker-wrap .tg-size-chip.tg-selected,
  .variant-picker-wrap .tg-size-chip:has(input:checked) {
    background: #F4EFE6 !important;
    border: 1.5px solid #1A1A1A !important;
    color: #1A1A1A !important;
  }

  .variant-picker-wrap .tg-size-chip.tg-selected .tg-dim,
  .variant-picker-wrap .tg-size-chip:has(input:checked) .tg-dim {
    color: #4F4A43;
  }

  .variant-picker-wrap .tg-size-chip.tg-selected .tg-check,
  .variant-picker-wrap .tg-size-chip:has(input:checked) .tg-check {
    display: inline-flex;
  }

  .variant-picker-wrap .tg-size-chip.tg-unavailable {
    opacity: 0.45;
  }

  .variant-picker-wrap .tg-size-chip:has(input:focus-visible) {
    outline: 2px solid #1A1A1A;
    outline-offset: 2px;
  }

  /* ── V1 #6 · Calm, honest availability ── */
  .variant-picker-wrap .tg-stock {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin: 14px 0 0;
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: 0;
    color: #6B665E;
  }

  .variant-picker-wrap .tg-stock__dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .variant-picker-wrap .tg-stock__status {
    font-weight: 500;
  }

  .variant-picker-wrap .tg-stock--in .tg-stock__dot,
  .variant-picker-wrap .tg-stock--in .tg-stock__status {
    color: #2F6B45;
