{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{%- comment -%}
  ============================================================================
  TANGELOS · VARIANT PICKER BLOCK (merged version)

  Merged from:
    A) the current live block (colour swatches, size guide popup, feature grid,
       upsell "Add Now" rows, Build The Full Set, comparison table scripts)
    B) the V1 redesign block (size chips with dimensions #4, calm stock line #6)

  Fixes in this version
   1. Colour swatches are no longer wrapped in a Liquid product form. That form
      used undefined variables from an old theme (product_form_id, class_frm,
      isProductDefault, pr_variants) and added a second /cart/add form.
   2. Swatch markup is now <ul><li><a> (was <ul><a><li>, invalid HTML).
   3. Size guide close button: removed onclick="closePopup()" (closePopup is
      not global, so it threw an error). jQuery handles the close.
   4. Size guide link: opens the popup only (it also opened the URL in a new
      tab at the same time).
   5. `assign page = pages['size-guide']` renamed to sg_page so it no longer
      overwrites Shopify's global `page` object.
   6. Removed the ?size= URL rewrite on every size click.
   7. Removed the duplicated gift-text / Percale-badge timers (the gift line
      was inserted twice) and the duplicated <style> block.
   8. jQuery and vanilla click handlers are delegated, so they keep working
      after Horizon re-renders the variant picker on a variant change.
   9. Size click now reads the radio's value, not the label text. The V1 size
      chips add dimensions inside the label, which broke .new_section_price.
  10. Build The Full Set auto_add = false: tiles only select, everything goes
      in on Add to cart (matches the intended behaviour).
  11. V1 size chips with dimensions (#4) and calm stock line (#6) added.
  12. Stock line now shows the quantity left for the selected variant
      ("In stock · 12 left · King") and updates on every size/colour change.
  ============================================================================
{%- endcomment -%}

{%- comment -%} ---------- feature grid: one block, data driven ---------- {%- endcomment -%}
{%- liquid
  assign fg_icons = ''
  assign fg_labels = ''

  if product.title contains 'Muslin'
    assign fg_icons = 'Soft_Breathable.svg?v=1787906052,Class_I_Baby_safe.svg?v=1787906052,100__Organic_Cotton.svg?v=1787906052,365_Days_retruns.svg?v=1787906051'
    assign fg_labels = 'Soft &amp; Breathable,Class I Baby Safe,100% Organic Cotton,365-Day Returns'
  elsif product.title contains 'Percale'
    assign fg_icons = 'Crisp_Cool.svg?v=1787906052,Class_I_Baby_safe.svg?v=1787906052,100__Organic_Cotton.svg?v=1787906052,365_Days_retruns.svg?v=1787906051'
    assign fg_labels = 'Crisp &amp; Cool,Class I Baby Safe,100% Organic Cotton,365-Day Returns'
  elsif product.title contains 'Sateen'
    assign fg_icons = 'Soft_Smooth.svg?v=1787906052,Class_I_Baby_safe.svg?v=1787906052,100__Organic_Cotton.svg?v=1787906052,365_Days_retruns.svg?v=1787906051'
    assign fg_labels = 'Soft &amp; Smooth,Class I Baby Safe,100% Organic Cotton,365-Day Returns'
  elsif product.title contains 'Linen'
    assign fg_icons = 'Naturally_Breathable.svg?v=1787906051,Soften_with_Every_wash.svg?v=1787906052,European_Flax_Linen.svg?v=1787906052,365_Days_retruns.svg?v=1787906051'
    assign fg_labels = 'Naturally Breathable,Softens with Every Wash,European Flax Linen,365-Day Returns'
  endif
-%}

{% comment %} {%- if fg_icons != blank -%}
  {%- assign fg_icon_list = fg_icons | split: ',' -%}
  {%- assign fg_label_list = fg_labels | split: ',' -%}
  <div class="feature-grid">
    {%- for icon in fg_icon_list -%}
      <div class="feature-item">
        <img src="https://cdn.shopify.com/s/files/1/0647/5930/0256/files/{{ icon }}"
             width="24" height="24" loading="lazy" alt="" class="feature-item__icon">
        <span class="feature-item__text">{{ fg_label_list[forloop.index0] }}</span>
      </div>
    {%- endfor -%}
  </div>
{%- endif -%} {% endcomment %}

<style>
/* ============================ feature grid ============================ */
.feature-grid{margin-bottom:10px;display:grid;grid-template-columns:repeat(2,1fr);gap:14px 24px}
.feature-item{display:flex;align-items:center;gap:10px}
.feature-item__icon{width:22px;height:22px;object-fit:contain;flex-shrink:0}
.feature-item__text{font-size:14px;line-height:1.3}
@media screen and (max-width:749px){
  .feature-grid{gap:10px 16px}
  .feature-item__text{font-size:13px}
}

/* ============================ colour swatches ============================ */
ul.swatch-view.swatch-view-custom-image {
  display: flex;
  list-style: none;
  gap: 10px;
  padding-left: 0;
}
ul.swatch-view.swatch-view-custom-image li.swatch-view-item .swatch-custom-image.swatch-group-selector .star-set-image {
  border-radius: 40px;
}
.swatch-custom-image.swatch-group-selector.swatch-selected {
  border: 1px solid #707070;
  border-radius: 40px;
}
.swatch-custom-image.swatch-group-selector img {
  border-radius: 40px;
}
.swatch-view-link {
  display: block;
}
a.open-sizeguide.link.sizeguide.variant-size-guide-link.is-positioned {
  text-decoration: underline;
}

/* ============================ comparison table ============================ */
body .quick_compare table tr th {
  text-transform: uppercase !important;
  color: #1a1a1a;
  border-radius: 4px 4px 0 0;
  font-size: 10px;
  letter-spacing: 0.2em;
  font-weight: 500;
  padding: 15px 15px;
  text-align: left;
}
body .quick_compare table tr td {
  font-size: 10px;
  letter-spacing: 0.2em;
  font-weight: 500;
  text-transform: uppercase;
  padding: 15px 15px;
  text-align: start;
  color: #1a1a1a;
}
</style>

{%- comment -%} ---------- colour swatches (links to sibling colour products) ---------- {%- endcomment -%}
{%- if product.metafields.custom.color_swatches.value != blank -%}
  <div data-callBackVariant class="tg-colour-swatches">
    <div class="swatch-single swatch-preset-982014 swatch-view-stack custom_color_switches" data-group-index="0">

      {%- for metaobject in product.metafields.custom.color_swatches.value -%}
        {%- if metaobject.product.value.handle == product.handle -%}
          {%- assign sw_parts = metaobject.color_name.value | split: ' - ' -%}
          <label class="swatch-label swatch-label-custom-image">
            <span class="swatch-option-name">Colour</span>
            <span class="swatch-variant-name">
              <span class="swatch-split-symbol">-</span> {{ sw_parts[1] }}
            </span>
          </label>
        {%- endif -%}
      {%- endfor -%}

      {%- liquid
        assign sw_images = ''
        for sw_img in product.metafields.custom.multi_color_images.value
          assign sw_images = sw_images | append: sw_img | append: ','
        endfor
        assign sw_images = sw_images | split: ','
      -%}

      <ul class="swatch-view swatch-view-custom-image" aria-label="Colour">
        {%- for metaobject in product.metafields.custom.color_swatches.value -%}
          {%- liquid
            assign sw_product = metaobject.product.value
            assign sw_label = metaobject.color_name.value | split: ' - ' | last | strip
            assign sw_current = false
            if sw_product.handle == product.handle
              assign sw_current = true
            endif
            assign sw_id = metaobject.color_name.value | strip | replace: ' ', '_'
            assign sw_index = forloop.index0
          -%}
          <li class="swatch-view-item" orig-value="{{ sw_label | escape }}">
            <a href="{{ sw_product.url }}" class="swatch-view-link" aria-label="{{ sw_label | escape }}"{% if sw_current %} aria-current="true"{% endif %}>
              <div class="swatch-custom-image swatch-group-selector{% if sw_current %} swatch-selected{% endif %}" type="image" data-value="{{ sw_label | escape }}" orig-value="{{ sw_label | escape }}" swatch-url="{{ sw_product.url }}" swatch-option="group4633946" current-product="{{ sw_current }}">
                {%- if sw_images.size == 0 -%}
                  <div id="{{ sw_id }}" style="width:25px;height:25px;background-color:{{ metaobject.background_color.value }};" class="star-set-image" swatch-inside="true">
                    <i class="hidden"></i>
                  </div>
                {%- else -%}
                  <div style="width:25px;height:25px;">
                    <img
                      src="https://www.tangelos.co.uk/cdn/shop/{{ sw_images[sw_index] }}"
                      loading="lazy"
                      width="25"
                      height="25"
                      alt=""
                      class="product-grid-thumbnail">
                  </div>
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>

    </div>
  </div>
{%- endif -%}


{% unless product_resource == blank %}

  {%- comment -%} V1 #6 · stock state of the selected variant {%- endcomment -%}
  {%- liquid
    assign tg_has_size = false
    assign tg_size_pos = 0
    for option in product_resource.options_with_values
      assign tg_name = option.name | downcase | strip
      if tg_name == 'size'
        assign tg_has_size = true
        assign tg_size_pos = forloop.index0
      endif
    endfor

    assign tg_v = product_resource.selected_or_first_available_variant
    assign tg_state = 'out'
    if tg_v.available
      assign tg_state = 'in'
      if tg_v.inventory_management == 'shopify' and tg_v.inventory_quantity <= 0
        assign tg_state = 'order'
      endif
    endif

    assign tg_qty = 0
    if tg_state == 'in' and tg_v.inventory_management == 'shopify' and tg_v.inventory_quantity > 0
      assign tg_qty = tg_v.inventory_quantity
    endif

    assign tg_meta = ''
    if tg_has_size
      assign tg_meta = tg_v.options[tg_size_pos]
    endif
    for opt_value in tg_v.options
      if tg_has_size and forloop.index0 == tg_size_pos
        continue
      endif
      if tg_meta == ''
        assign tg_meta = opt_value
      else
        assign tg_meta = tg_meta | append: ' · ' | append: opt_value
      endif
    endfor
  -%}

  <div class="variant-picker-wrap{% if block.settings.show_size_guide and block.settings.size_guide_url != blank %} has-size-guide{% endif %}">

    {%- if block.settings.show_size_guide and block.settings.size_guide_url != blank -%}
      <a href="{{ block.settings.size_guide_url }}" class="open-sizeguide link sizeguide variant-size-guide-link"{% if block.settings.size_guide_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
        {%- if block.settings.size_guide_icon -%}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 21H3M21 3v18M3 3h18M9 9h.01M15 9h.01M9 15h.01M15 15h.01"/>
          </svg>
        {%- endif -%}
        {{ block.settings.size_guide_label | default: 'Size Guide' }}
      </a>

      {%- assign sg_page = pages['size-guide'] -%}
      <div id="page-popup" class="popup-overlay">
        <div class="popup-inner" role="dialog" aria-modal="true" aria-label="Size guide">
          <button type="button" class="popup-close" aria-label="Close">&#x2715;</button>
          <div class="popup-content">{{ sg_page.content }}</div>
        </div>
      </div>
    {%- endif -%}

    {% render 'variant-main-picker', product_resource: product_resource, section: section, product: product %}

    

    {%- unless product_resource.has_only_default_variant -%}
      <p class="tg-stock tg-stock--{{ tg_state }}" data-tg-stock aria-live="polite">
        <span class="tg-stock__dot" aria-hidden="true"></span>
        <span class="tg-stock__status" data-tg-stock-status>
          {%- case tg_state -%}
            {%- when 'in' -%}In stock
            {%- when 'order' -%}Available to order
            {%- else -%}Out of stock
          {%- endcase -%}
        </span>
        <span class="tg-stock__qty" data-tg-stock-qty{% if tg_qty == 0 %} hidden{% endif %}>{% if tg_qty > 0 %}· {{ tg_qty }} left{% endif %}</span>
        <span class="tg-stock__meta" data-tg-stock-meta>· {{ tg_meta | escape }}</span>
      </p>

      <script type="application/json" data-tg-variants>
        {
          "sizePos": {% if tg_has_size %}{{ tg_size_pos }}{% else %}-1{% endif %},
          "variants": [
            {%- for v in product_resource.variants -%}
              {%- liquid
                assign tg_vs = 'out'
                if v.available
                  assign tg_vs = 'in'
                  if v.inventory_management == 'shopify' and v.inventory_quantity <= 0
                    assign tg_vs = 'order'
                  endif
                endif
              -%}
              {"id": {{ v.id }}, "state": {{ tg_vs | json }}, "qty": {% if tg_vs == 'in' and v.inventory_management == 'shopify' and v.inventory_quantity > 0 %}{{ v.inventory_quantity }}{% else %}0{% endif %}, "options": {{ v.options | json }}}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endunless -%}

  </div>

  {%- comment -%}
    V1 #4 · Size chips with real dimensions, per fabric and product type.
    Defaults come from the Size Guide page (pages/size-guide).
    A variant's metafield custom.dimensions (single line text, e.g. "138 × 198 cm")
    overrides the default for that size.
    Sets (duvet set, cover set) show the duvet cover size.
  {%- endcomment -%}
  {%- if tg_has_size -%}
    {%- liquid
      assign tg_t = product_resource.title | downcase

      # Default: Percale / Sateen / Linen duvet covers and their sets
      assign tg_dims = '{"single":"140 × 200 cm","double":"200 × 200 cm","king":"225 × 220 cm","super king":"260 × 220 cm","superking":"260 × 220 cm"}'

      if tg_t contains 'muslin'
        if tg_t contains 'square'
          assign tg_dims = '{"square":"65 × 65 cm"}'
        elsif tg_t contains 'pillowcase'
          assign tg_dims = '{"standard":"50 × 66 cm","king":"50 × 90 cm"}'
        else
          assign tg_dims = '{"single":"138 × 198 cm","double":"198 × 198 cm","king":"223 × 218 cm","super king":"258 × 218 cm","superking":"258 × 218 cm"}'
        endif
      elsif tg_t contains 'waffle blanket'
        assign tg_dims = '{"single":"150 × 250 cm","double":"200 × 225 cm","king":"220 × 250 cm"}'
      elsif tg_t contains 'waffle throw'
        assign tg_dims = '{"double":"150 × 200 cm"}'
      elsif tg_t contains 'airy voile quilt'
        assign tg_dims = '{"single":"190 × 250 cm","double":"220 × 250 cm","king / superking":"270 × 250 cm","king/superking":"270 × 250 cm","king":"270 × 250 cm","super-king":"270 × 250 cm"}'
      elsif tg_t contains 'linen cotton quilt'
        assign tg_dims = '{"king/superking":"270 × 250 cm","king / superking":"270 × 250 cm","king":"270 × 250 cm","super king":"270 × 250 cm"}'
      elsif tg_t contains 'lightweight blanket'
        assign tg_dims = '{}'
      elsif tg_t contains 'mattress protector'
        assign tg_dims = '{"single":"90 × 190 cm · 23 cm","double":"140 × 190 cm · 30 cm","king":"150 × 200 cm · 30 cm","super king":"180 × 200 cm · 30 cm","superking":"180 × 200 cm · 30 cm"}'
      elsif tg_t contains 'pillow protector'
        assign tg_dims = '{"standard":"47 × 70 cm","king":"47 × 85 cm"}'
      elsif tg_t contains 'fitted sheet'
        assign tg_dims = '{"single":"90 × 190 cm · 40 cm ","double":"140 × 190 cm · 40 cm","king":"150 × 200 cm · 40 cm","super king":"180 × 200 cm · 40 cm","superking":"180 × 200 cm · 40 cm"}'
      elsif tg_t contains 'flat sheet'
        assign tg_dims = '{"single":"180 × 275 cm","double":"230 × 275 cm","king":"275 × 275 cm","super king":"305 × 275 cm","superking":"305 × 275 cm"}'
      elsif tg_t contains 'oxford pillowcase'
        assign tg_dims = '{"standard":"50 × 75 cm · 7 cm border","king":"50 × 90 cm · 7 cm border"}'
      elsif tg_t contains 'pillowcase'
        assign tg_dims = '{"standard":"50 × 75 cm","king":"50 × 90 cm"}'
      endif
    -%}
    <script>
      window.TangelosSizeDims = Object.assign(
        {{ tg_dims }},
        {
          {%- for variant in product_resource.variants -%}
            {%- assign tg_dim = variant.metafields.custom.dimensions.value -%}
            {%- if tg_dim != blank -%}
              {{ variant.options[tg_size_pos] | downcase | strip | json }}: {{ tg_dim | json }},
            {%- endif -%}
          {%- endfor -%}
        }
      );
      window.TangelosSizeOptionName = {{ product_resource.options[tg_size_pos] | downcase | strip | json }};
    </script>
  {%- endif -%}

{% endunless %}



{% for variant in product.variants %}
      {% assign flavors = variant.metafields.custom.checkbox_products_muslin_duvet_cover %}
      {% if flavors != blank %}
        {% if forloop.first %}

<div class="checkbox-products" data-variant-id="{{ variant.id }}" >
  <!-- Stock badge — updated by JS on size change -->
   {% comment %} <p class="upsell-stock-badge" id="upsell-stock-badge" style="display:none;">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
    <span id="upsell-stock-text"></span>
  </p> {% endcomment %}

  {%- comment -%}
    Stock of the product being viewed (the muslin duvet cover / cover set),
    one entry per size. The stock badge reads ONLY this list, never the
    upsell products. "tracked" is false when Shopify isn't tracking stock or
    the variant can be sold when out of stock; then no badge is shown.
  {%- endcomment -%}
  <script type="application/json" id="upsell-main-stock">
    [
      {%- for main_variant in product.variants -%}
        {
          "id": {{ main_variant.id }},
          "size": {{ main_variant.option1 | json }},
          "inventory": {{ main_variant.inventory_quantity | default: 0 }},
          "available": {{ main_variant.available }},
          "tracked": {% if main_variant.inventory_management == 'shopify' and main_variant.inventory_policy == 'deny' %}true{% else %}false{% endif %}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>

  <ul id="upsell-addon-list" >
    {% for item_product in flavors.value %}
      {% assign default_image = item_product.featured_image | image_url: width: 200 %}
      {% assign variants_json = '[' %}
      {% for variant in item_product.variants %}
        {% assign v_image_obj = variant.featured_image | default: item_product.featured_image %}
        {% assign v_image = v_image_obj | image_url: width: 400 %}
        {% assign variants_json = variants_json | append: '{"id":' | append: variant.id | append: ',"price":' | append: variant.price | append: ',"compare_at_price":' | append: variant.compare_at_price | append: ',"size":"' | append: variant.option1 | append: '","image":"' | append: v_image | append: '","inventory":' | append: variant.inventory_quantity | append: '}' %}
        {% unless forloop.last %}{% assign variants_json = variants_json | append: ',' %}{% endunless %}
      {% endfor %}
      {% assign variants_json = variants_json | append: ']' %}

      <li
        class="upsell-addon-item"
        data-product-title="{{ item_product.title | escape }}"
        data-variants='{{ variants_json }}'
      >
        <div class="upsell-addon-row">

          <!-- Thumbnail with hover magnifier -->
          <div class="upsell-addon-thumb-wrap">
            <img
              class="upsell-addon-image"
              src="{{ default_image }}"
              alt="{{ item_product.title | escape }}"
              width="70"
              height="70"
              loading="lazy"
            >
            <button type="button" class="upsell-thumb-zoom" aria-label="View image">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
            </button>
          </div>

          <!-- Info block -->
          <div class="upsell-addon-info">
            <span class="upsell-addon-heading"></span>
            <span class="upsell-addon-subtitle">{{ item_product.title | escape }}<span class="selected-pill-sizes" hidden></span></span>
            <div class="upsell-addon-price">
              <div>
                <span class="upsell-addon-price-now"></span>
                <span class="upsell-addon-price-was"></span>
              </div>
              <div>
                <div class="upsell-addon-action">
                  <input
                    class="upsell-addon-checkbox"
                    type="checkbox"
                    name="product-id"
                    data-price=""
                    value=""
                    data-variant-id=""
                    style="display:none;"
                  >
                  <button type="button" class="upsell-add-btn" aria-pressed="false">
                    <span class="upsell-add-btn-label">Add Now</span>
                    <span class="upsell-add-btn-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="9 12 11 14 15 10"/>
                      </svg>
                    </span>
                  </button>
                </div>
              </div>
            </div>
          </div>

        </div>
      </li>
    {% endfor %}
  </ul>

{% comment %} ===== Build The Full Set — variant-aware bundle ===== {% endcomment %}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign default_tier = 0
  assign heading      = 'Build The Full Set'
  assign badge_label  = ''
  assign auto_add     = false

  assign has_any = false
  for variant in product.variants
    if variant.metafields.custom.checkbox_products_muslin_duvet_cover.value.size > 0
      assign has_any = true
      break
    endif
  endfor
-%}

{%- if has_any -%}
<div
  class="build-full-set"
  id="BuildFullSet-{{ product.id }}"
  data-build-full-set
  data-current-variant="{{ current_variant.id }}"
  data-default-tier="{{ default_tier }}"
  data-single-upsell-tier="5"
  data-multi-upsell-tier="5"
  data-currency="{{ cart.currency.iso_code }}"
  data-auto-add="{{ auto_add }}"
  data-next-tier-template="Add {count} more &amp; save {percent}%"
  data-all-added-label="You&#39;re saving the max!"
  hidden
  style="--bfs-card-bg:#ffffff;--bfs-accent:#33513a;--bfs-badge-bg:#e7f0e7;--bfs-badge-text:#2f5233;"
>
  <script type="application/json" data-bfs-map>
  {
    "self": {
      "title": {{ product.title | json }},
      "image": {{ product.featured_image | image_url: width: 300 | json }},
      "tier": {{ product.metafields.custom.bundle_tier_percent.value | default: default_tier }}
    },
    "variants": {
      {%- for variant in product.variants -%}
      "{{ variant.id }}": {
        "self": {
          "variantId": {{ variant.id }},
          "variantTitle": {{ variant.title | json }},
          "option1": {{ variant.option1 | json }},
          "price": {{ variant.price }},
          "compare": {{ variant.compare_at_price | default: variant.price }},
          "available": {{ variant.available }},
          "tier": {{ variant.metafields.custom.bundle_tier_percent.value | default: product.metafields.custom.bundle_tier_percent.value | default: default_tier }}
        },
        "items": [
          {%- for p in variant.metafields.custom.checkbox_products_muslin_duvet_cover.value -%}
            {
              "title": {{ p.title | json }},
              "image": {{ p.featured_image | image_url: width: 300 | json }},
              "variants": [
                {%- for x in p.variants -%}
                {
                  "variantId": {{ x.id }},
                  "variantTitle": {{ x.title | json }},
                  "option1": {{ x.option1 | json }},
                  "price": {{ x.price }},
                  "compare": {{ x.compare_at_price | default: x.price }},
                  "available": {{ x.available }}
                }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    }
  }
  </script>

  <div class="build-full-set__card">
    <span class="build-full-set__badge" data-bfs-badge
      {% if badge_label != blank %}data-custom-label="{{ badge_label | escape }}"{% endif %} hidden></span>

    <div class="build-full-set__header">
      <h3 class="build-full-set__heading">{{ heading }}</h3>
    </div>

    <div class="build-full-set__items" data-bfs-items></div>

    <div class="build-full-set__progress-wrap" data-bfs-progress-wrap>
      <div class="build-full-set__progress-row">
        <span class="build-full-set__progress-label">Total Saved <span data-bfs-achieved>0</span>%</span>
        <span class="build-full-set__progress-next" data-bfs-next></span>
      </div>
      <div class="build-full-set__progress-track-wrap">
        <div class="build-full-set__progress-track" data-bfs-track></div>
        <span class="build-full-set__progress-pill" data-bfs-pill hidden>0%</span>
      </div>
      <div class="build-full-set__progress-ticks" data-bfs-ticks></div>
    </div>
  </div>

  <div class="build-full-set__subtotal">
    <span class="build-full-set__subtotal-label">Sub total</span>
    <span class="build-full-set__subtotal-values">
      <s data-bfs-original hidden></s>
      <strong data-bfs-final></strong>
    </span>
  </div>
</div>

<style>
.build-full-set{max-width:560px;margin:24px auto;font-size:14px;box-sizing:border-box}
.build-full-set[hidden]{display:none}
.build-full-set *,.build-full-set *::before,.build-full-set *::after{box-sizing:border-box}
.build-full-set__card{position:relative;background:var(--bfs-card-bg);border:1px solid rgba(0,0,0,.08);border-radius:14px;padding:28px 22px 22px}
.build-full-set__badge{position:absolute;top:0;right:16px;transform:translateY(-50%);background:var(--bfs-badge-bg);color:var(--bfs-badge-text);font-size:13px;font-weight:600;padding:7px 13px;border-radius:8px}
.build-full-set__badge[hidden]{display:none}
.build-full-set__heading{margin:0 0 20px;font-size:22px;font-weight:500;color:var(--bfs-accent)}

.build-full-set__items{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
@media(max-width:600px){.build-full-set__items{grid-template-columns:repeat(2,minmax(0,1fr))}}
.build-full-set__item{min-width:0}
.build-full-set__tile{display:flex;flex-direction:column;width:100%;padding:0;border:0;background:none;text-align:left;cursor:pointer;font:inherit;color:inherit}
.build-full-set__tile:focus-visible{outline:2px solid var(--bfs-accent);outline-offset:3px}
.build-full-set__tile[disabled]{cursor:wait;opacity:.6}
.build-full-set__item[data-required="true"] .build-full-set__tile{cursor:default}

.build-full-set__thumb{position:relative;display:block;width:100%;aspect-ratio:1/1;border-radius:10px;overflow:hidden;background:#f1f1ef}
.build-full-set__thumb img{width:100%;height:100%;object-fit:cover;display:block;transition:opacity .2s}
.build-full-set__state-icon{position:absolute;top:8px;right:8px;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:var(--bfs-accent);transition:background .2s}
.build-full-set__item[data-selected="false"] .build-full-set__state-icon{background:rgba(0,0,0,.35)}
.build-full-set__state-icon svg path{stroke:#fff}
.build-full-set__item[data-selected="true"] [data-bfs-icon-plus]{display:none}
.build-full-set__item[data-selected="false"] [data-bfs-icon-check]{display:none}

.build-full-set__meta{display:flex;flex-direction:column;gap:2px;padding-top:12px}
.build-full-set__title{font-size:14px;font-weight:600;line-height:1.35;color:var(--bfs-accent)}
.build-full-set__variant{font-size:13px;color:#767676}
.build-full-set__price{font-size:13px;color:#2b2b2b;margin-top:2px;}
.build-full-set__price s{opacity:.5;margin-right:5px; text-decoration: auto;}
.build-full-set__status{margin-top:6px}
.build-full-set__status span{display:inline-block;font-size:12px;font-weight:500;padding:4px 9px;border-radius:5px;background:var(--bfs-badge-bg);color:var(--bfs-badge-text)}
.build-full-set__status span[hidden]{display:none}

.build-full-set__progress-wrap{margin-top:26px}
.build-full-set__progress-wrap[hidden]{display:none}
.build-full-set__progress-row{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:10px;color:var(--bfs-accent)}
.build-full-set__progress-next{font-weight:700;text-align:right}
.build-full-set__progress-track-wrap{position:relative}
.build-full-set__progress-track{display:flex;height:12px;border-radius:3px;background:#dce5dd;overflow:hidden}
.build-full-set__segment{border-right:2px solid var(--bfs-card-bg);background:transparent;transition:background .25s}
.build-full-set__segment:last-child{border-right:0}
.build-full-set__segment.is-filled{background:var(--bfs-accent)}
.build-full-set__segment.is-alt.is-filled{background:#2b4531}
.build-full-set__progress-pill{position:absolute;top:50%;transform:translate(-100%,-50%);background:#1f2d24;color:#fff;font-size:11px;font-weight:700;padding:2px 7px;border-radius:4px;transition:left .3s}
.build-full-set__progress-pill[hidden]{display:none}
.build-full-set__progress-ticks{display:flex;margin-top:7px}
.build-full-set__tick{font-size:12.5px;color:#2b2b2b;transition:opacity .2s}

.build-full-set__subtotal{display:flex;justify-content:space-between;align-items:baseline;gap:10px;padding:18px 4px 0;font-size:16px;color:var(--bfs-accent)}
.build-full-set__subtotal-values s{opacity:.45;margin-right:8px}
.build-full-set__subtotal-values s[hidden]{display:none}
.build-full-set__subtotal-values strong{font-size:19px}
@media(prefers-reduced-motion:reduce){.build-full-set *{transition:none!important}}
</style>
<script>
(function () {
  'use strict';
  var root = document.getElementById('BuildFullSet-{{ product.id }}');
  if (!root || root.dataset.bfsReady) return;
  root.dataset.bfsReady = '1';

  var DATA        = JSON.parse(root.querySelector('[data-bfs-map]').textContent);
  var wrap        = root.querySelector('[data-bfs-items]');
  var badgeEl     = root.querySelector('[data-bfs-badge]');
  var achievedEl  = root.querySelector('[data-bfs-achieved]');
  var nextEl      = root.querySelector('[data-bfs-next]');
  var trackEl     = root.querySelector('[data-bfs-track]');
  var pillEl      = root.querySelector('[data-bfs-pill]');
  var ticksEl     = root.querySelector('[data-bfs-ticks]');
  var origEl      = root.querySelector('[data-bfs-original]');
  var finalEl     = root.querySelector('[data-bfs-final]');
  var progressEl  = root.querySelector('[data-bfs-progress-wrap]');

  // Upsell rates. The main product gets no bundle % — its markdown is
  // already in its own price, so adding one here would double-count it.
  var singleTier  = parseInt(root.dataset.singleUpsellTier, 10) || 5;
  var multiTier   = parseInt(root.dataset.multiUpsellTier, 10) || 5;

  // autoAdd true  = tapping a tile writes to the cart immediately
  // autoAdd false = tiles only select; everything goes in on Add to cart
  var autoAdd     = root.dataset.autoAdd === 'true';
  var nextTpl     = root.dataset.nextTierTemplate || 'Add {count} more & save {percent}%';
  var maxLabel    = root.dataset.allAddedLabel || "You're saving the max!";
  var routes      = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

  // 'automatic' — an automatic discount / Shopify Function reduces the cart.
  // 'code'      — attach a discount code per tier via /discount/CODE.
  var discountMode = root.dataset.discountMode || 'automatic';

  // strictSize true  = drop an upsell when no variant matches the chosen size
  // strictSize false = fall back to the product's first available variant
  var strictSize   = root.dataset.strictSize === 'true';
  var DEBUG        = root.dataset.debug === 'true' || /[?&]bfs_debug=1/.test(window.location.search);

  var fmt = (function () {
    try {
      return new Intl.NumberFormat(undefined, {
        style: 'currency', currency: root.dataset.currency || 'GBP', currencyDisplay: 'narrowSymbol'
      });
    } catch (e) { return null; }
  })();
  function money(c) { c = c || 0; return fmt ? fmt.format(c / 100) : '£' + (c / 100).toFixed(2); }

  var CHECK = '<svg data-bfs-icon-check width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2.5 7.5L5.5 10.5L11.5 3.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  var PLUS  = '<svg data-bfs-icon-plus width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 1V11M1 6H11" stroke="white" stroke-width="1.8" stroke-linecap="round"/></svg>';

  var ESCAPES = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return ESCAPES[c]; }); }

  var cartIds = [];
  var tiles = [];
  var basis = [];
  var totalPercent = 0;
  var currentKey = null;

  /* ---------------- variant matching ---------------- */

  // Pillowcases are always Standard, whatever duvet size the shopper picked.
  // Exception: Percale + Muslin products, King / Super King -> King pillowcases.
  var ALWAYS_STANDARD = /pillow\s*case/i;

  // Percale and Muslin pages: pillowcases follow the selected size.
  var PILLOW_FOLLOWS_SIZE = /percale|muslin/i.test(DATA.self.title || '');

  // Duvet sizes fall back to Standard when a product doesn't carry that size.
  var SIZE_ALIASES = {
    'single':     ['single', 'standard'],
    'double':     ['double', 'standard'],
    'king':       ['king', 'standard'],
    'super king': ['super king', 'superking', 'standard']
  };

  function normLabel(s) {
    return String(s || '').toLowerCase().replace(/[^a-z]/g, ''); // "Super King" -> "superking"
  }

  function matchVariant(item, wantSize) {
    var vs = (item.variants || []).filter(function (v) { return v.available; });
    if (!vs.length) return null;

    function findByLabel(label) {
      var target = String(label).toLowerCase().trim();
      return vs.filter(function (v) {
        return String(v.option1 || v.variantTitle || '').toLowerCase().trim() === target;
      })[0];
    }

    // Exact label first, then "starts with" — so "King (50x90cm)" counts as
    // King, but "Super King" never counts as King.
    function findBySize(label) {
      var want = normLabel(label);
      return vs.filter(function (v) { return normLabel(v.option1 || v.variantTitle) === want; })[0] ||
             vs.filter(function (v) { return normLabel(v.option1 || v.variantTitle).indexOf(want) === 0; })[0];
    }

    if (ALWAYS_STANDARD.test(item.title || '')) {
      var sizeKey = normLabel(wantSize);
      var isKingSize = sizeKey === 'king' || sizeKey === 'superking';
      if (PILLOW_FOLLOWS_SIZE && isKingSize) {
        var king = findBySize('king');
        if (king) return king;
      }
      var std = findByLabel('standard') || findBySize('standard');
      if (std) return std;
    }

    var want = String(wantSize || '').toLowerCase().trim();
    var candidates = SIZE_ALIASES[want] || [want];
    for (var i = 0; i < candidates.length; i++) {
      var hit = findByLabel(candidates[i]);
      if (hit) return hit;
    }

    // Loose match next: "Single Deep" or "Single (90x190)" still counts as Single.
    for (var j = 0; j < candidates.length; j++) {
      var needle = String(candidates[j]).toLowerCase().trim();
      var loose = vs.filter(function (v) {
        return String(v.option1 || v.variantTitle || '').toLowerCase().indexOf(needle) > -1;
      })[0];
      if (loose) return loose;
    }

    // Single-variant products (Default Title) always qualify.
    if (vs.length === 1) return vs[0];

    if (strictSize) {
      if (DEBUG) console.warn('[build-full-set] no "' + wantSize + '" variant for', item.title);
      return null;
    }
    if (DEBUG) console.info('[build-full-set] falling back to', vs[0].variantTitle, 'for', item.title);
    return vs[0];
  }

  /* ---------------- render ---------------- */

  function tileHTML(o, i, required, selected) {
    var tier  = +o.tier || 0;
    var label = o.variantTitle === 'Default Title' ? 'Single' : o.variantTitle;

    var noDiscount = tier <= 0;
    var discounted = noDiscount ? o.price : Math.round(o.price * (1 - tier / 100));
    var price = '<span class="build-full-set__price">' +
      (noDiscount
        ? (o.compare > o.price ? '<s>' + money(o.compare) + '</s>' : '') + '<b>' + money(o.price) + '</b>'
        : '<s>' + money(o.price) + '</s><b>' + money(discounted) + '</b>'
      ) + '</span>';

    return '<div class="build-full-set__item' + (selected ? ' is-selected' : '') + '" data-bfs-item' +
        ' data-item-id="i' + i + '"' +
        ' data-variant-id="' + o.variantId + '"' +
        ' data-price-cents="' + o.price + '"' +
        ' data-compare-cents="' + (o.compare || o.price) + '"' +
        ' data-tier-percent="' + tier + '"' +
        ' data-required="' + (required ? 'true' : 'false') + '"' +
        ' data-no-discount="' + (noDiscount ? 'true' : 'false') + '"' +
        ' data-selected="' + (selected ? 'true' : 'false') + '">' +
        '<button type="button" class="build-full-set__tile" data-bfs-toggle aria-pressed="' + !!selected + '" aria-label="Toggle ' + esc(o.title) + ' in bundle">' +
          '<span class="build-full-set__thumb">' +
            (o.image ? '<img src="' + o.image + '" alt="' + esc(o.title) + '" width="300" height="300" loading="lazy" decoding="async">' : '') +
            '<span class="build-full-set__state-icon">' + CHECK + PLUS + '</span>' +
          '</span>' +
          '<span class="build-full-set__meta">' +
            '<span class="build-full-set__title">' + esc(o.title) + '</span>' +
            '<span class="build-full-set__variant">' + esc(label) + '</span>' +
            price +
            '<span class="build-full-set__status">' +
              '<span data-bfs-in-cart' + (selected ? '' : ' hidden') + '>In your cart</span>' +
              '<span data-bfs-off' + (selected || noDiscount ? ' hidden' : '') + '>' + tier + '% Off</span>' +
            '</span>' +
          '</span>' +
        '</button>' +
      '</div>';
  }

  function build(variantId) {
    var entry = DATA.variants[String(variantId)];
    if (!entry) { root.hidden = true; return; }
    currentKey = String(variantId);

    var wantSize = entry.self.option1 || entry.self.variantTitle;

    var self = {
      title: DATA.self.title,
      image: DATA.self.image,
      tier: 0,
      variantId: entry.self.variantId,
      variantTitle: entry.self.variantTitle,
      price: entry.self.price,
      compare: entry.self.compare
    };

    var matched = [];
    (entry.items || []).forEach(function (o) {
      var v = matchVariant(o, wantSize);
      if (v) matched.push({ item: o, variant: v });
    });

    if (!matched.length) {
      if (DEBUG) console.warn('[build-full-set] no upsells resolved for variant', variantId);
      root.hidden = true;
      return;
    }

    var upsellTier = matched.length === 1 ? singleTier : multiTier;

    var html = [tileHTML(self, 0, true, true)];
    matched.forEach(function (m, i) {
      html.push(tileHTML({
        title: m.item.title,
        image: m.item.image,
        tier: upsellTier,
        variantId: m.variant.variantId,
        variantTitle: m.variant.variantTitle,
        price: m.variant.price,
        compare: m.variant.compare
      }, i + 1, false, cartIds.indexOf(m.variant.variantId) > -1));
    });

    wrap.innerHTML = html.join('');
    tiles = Array.prototype.slice.call(wrap.querySelectorAll('[data-bfs-item]'));

    totalPercent = tiles.reduce(function (s, t) { return s + (+t.dataset.tierPercent || 0); }, 0);
    basis = [];
    var segs = '', ticks = '';
    tiles.forEach(function (t, i) {
      var tier = +t.dataset.tierPercent || 0;
      var b = totalPercent > 0 ? (tier / totalPercent) * 100 : 0;
      basis.push(b);
      if (tier <= 0) return;
      segs  += '<div class="build-full-set__segment" data-seg="' + i + '" style="flex-basis:' + b + '%"></div>';
      ticks += '<span class="build-full-set__tick" data-tick="' + i + '" style="flex-basis:' + b + '%"></span>';
    });
    trackEl.innerHTML = segs;
    ticksEl.innerHTML = ticks;

    if (badgeEl) {
      var custom = badgeEl.dataset.customLabel;
      badgeEl.textContent = custom || ('Save ' + totalPercent + '%');
      badgeEl.hidden = totalPercent <= 0;
    }
    if (progressEl) progressEl.hidden = totalPercent <= 0;

    root.hidden = false;
    recalc();
  }

  /* ---------------- totals ---------------- */

  function recalc() {
    var achieved = 0, net = 0, netFixed = 0, netDiscountable = 0;
    var selected = 0, remaining = 0;

    tiles.forEach(function (t) {
      var tier = +t.dataset.tierPercent || 0;
      if (t.dataset.selected !== 'true') {
        if (tier > 0) remaining++;
        return;
      }
      var cents = (+t.dataset.priceCents || 0);
      achieved += tier;
      net += cents;
      if (t.dataset.noDiscount === 'true') netFixed += cents;
      else netDiscountable += cents;
      selected++;
    });

    if (achieved > totalPercent) achieved = totalPercent;

    var filledCount = 0;
    tiles.forEach(function (t) {
      if ((+t.dataset.tierPercent || 0) > 0 && t.dataset.selected === 'true') filledCount++;
    });

    var segEls  = trackEl.querySelectorAll('[data-seg]');
    var tickEls = ticksEl.querySelectorAll('[data-tick]');
    var pillLeft = 0;

    for (var i = 0; i < segEls.length; i++) {
      var lit = i < filledCount;
      segEls[i].classList.toggle('is-filled', lit);
      var idx = +segEls[i].dataset.seg;
      if (lit) pillLeft += (basis[idx] || 0);
      if (tickEls[i]) {
        var tickIdx = +tickEls[i].dataset.tick;
        tickEls[i].textContent = lit
          ? 'Saved ' + (+tiles[tickIdx].dataset.tierPercent || 0) + '%'
          : '';
      }
    }

    var final = netFixed + Math.round(netDiscountable * (1 - achieved / 100));

    achievedEl.textContent = achieved;

    if (achieved > 0) {
      pillEl.hidden = false;
      pillEl.style.left = pillLeft + '%';
      pillEl.textContent = achieved + '%';
    } else {
      pillEl.hidden = true;
    }

    nextEl.textContent = remaining > 0
      ? nextTpl.replace('{count}', remaining).replace('{percent}', totalPercent)
      : maxLabel;

    origEl.textContent = money(net);
    origEl.hidden = !(selected > 0 && net > final);
    finalEl.textContent = money(final);

    root.dispatchEvent(new CustomEvent('bundle:updated', {
      bubbles: true,
      detail: {
        achievedPercent: achieved, totalPercent: totalPercent,
        netCents: net, fixedCents: netFixed, discountableCents: netDiscountable,
        finalCents: final, selectedCount: selected
      }
    }));
  }

  function paint(tile, on) {
    tile.dataset.selected = on ? 'true' : 'false';
    tile.classList.toggle('is-selected', on);
    var btn = tile.querySelector('[data-bfs-toggle]');
    if (btn) btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    var a = tile.querySelector('[data-bfs-in-cart]');
    var b = tile.querySelector('[data-bfs-off]');
    if (a) a.hidden = !on;
    if (b) b.hidden = on || tile.dataset.noDiscount === 'true';
  }

  /* ---------------- cart ---------------- */

  var cartQty = {};
  var PRODUCT_TITLE = DATA.self.title || 'Main Product';

  function readCart() {
    return fetch(routes + 'cart.js', { headers: { Accept: 'application/json' }, cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function (c) {
        cartIds = [];
        cartQty = {};
        c.items.forEach(function (i) {
          if (cartIds.indexOf(i.variant_id) < 0) cartIds.push(i.variant_id);
          cartQty[i.variant_id] = (cartQty[i.variant_id] || 0) + i.quantity;
        });
        return c;
      })
      .catch(function () { return null; });
  }

  function cartSectionIds() {
    var ids = [];
    document.querySelectorAll('cart-items-component[data-section-id]').forEach(function (el) {
      if (el.dataset.sectionId && ids.indexOf(el.dataset.sectionId) < 0) ids.push(el.dataset.sectionId);
    });
    return ids;
  }

  function postCart(path, body) {
    var sections = cartSectionIds();
    if (sections.length) {
      body.sections = sections.join(',');
      body.sections_url = window.location.pathname;
    }
    return fetch(routes + path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(body)
    }).then(function (r) {
      return r.json().then(function (b) {
        if (!r.ok) throw new Error(b.description || b.message || 'Cart request failed');
        return b;
      });
    });
  }

  function addLines(items) {
    return postCart('cart/add.js', { items: items });
  }

  function removeLine(id) {
    return fetch(routes + 'cart.js', { cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var line = cart.items.filter(function (l) { return String(l.variant_id) === String(id); })[0];
        if (!line) return null;
        return postCart('cart/change.js', { id: line.key, quantity: 0 });
      });
  }

  /* ---------------- discount ---------------- */

  var DISCOUNT_CODES = (function () {
    try { return JSON.parse(root.dataset.discountCodes || '{}'); } catch (e) { return {}; }
  })();

  function applyDiscount(percent) {
    if (discountMode !== 'code') return Promise.resolve(null);
    var code = DISCOUNT_CODES[String(percent)];
    if (!code) return Promise.resolve(null);
    return fetch(routes + 'discount/' + encodeURIComponent(code), { credentials: 'same-origin' })
      .catch(function () { return null; });
  }

  function verifyDiscount(cart, expectedPercent) {
    if (!cart || !expectedPercent) return;
    var applied = (cart.total_discount || 0) > 0 ||
                  (cart.cart_level_discount_applications || []).length > 0;
    if (applied) {
      if (DEBUG) console.info('[build-full-set] cart discount applied:', money(cart.total_discount));
      return;
    }
    console.warn(
      '[build-full-set] The widget shows ' + expectedPercent + '% off but the cart has no discount.\n' +
      'Create an automatic discount in Shopify Admin (Discounts > Amount off products > Automatic), ' +
      'or deploy the bundle-tier-discount Shopify Function that reads the _bundle_tier property.'
    );
  }

  /* ---------------- Horizon cart drawer ---------------- */

  var themeEvents = null;
  function loadThemeEvents() {
    if (themeEvents) return Promise.resolve(themeEvents);
    return import('@theme/events')
      .then(function (m) { themeEvents = m; return m; })
      .catch(function () { return null; });
  }

  function announceCart(cart, sections, sourceId) {
    var data = {
      source: 'build-full-set',
      itemCount: cart ? cart.item_count : 0,
      productId: {{ product.id | json }},
      sections: sections
    };
    return loadThemeEvents().then(function (m) {
      var evt = (m && m.CartAddEvent)
        ? new m.CartAddEvent(cart || {}, String(sourceId || ''), data)
        : new CustomEvent('cart:update', {
            bubbles: true,
            detail: { resource: cart || {}, sourceId: String(sourceId || ''), data: data }
          });
      document.dispatchEvent(evt);
    });
  }

  {% comment %} function openDrawer() {
    var drawer = document.querySelector('cart-drawer-component');
    if (!drawer) {
      window.location.href = routes + 'cart';
      return;
    }
    var dialog = drawer.querySelector('dialog');
    if (dialog && dialog.open) return;
    if (typeof drawer.open === 'function') drawer.open();
  }

  function resetAddNowButtons() {
    document.querySelectorAll('.upsell-addon-item .upsell-addon-checkbox:checked').forEach(function (cb) {
      cb.checked = false;
      var item = cb.closest('.upsell-addon-item');
      var btn = item && item.querySelector('.upsell-add-btn');
      if (!btn) return;
      btn.classList.remove('is-added');
      btn.setAttribute('aria-pressed', 'false');
      var label = btn.querySelector('.upsell-add-btn-label');
      if (label) label.textContent = 'Add Now';
    });
  } {% endcomment %}

  /* ---------------- tile toggling ---------------- */

  wrap.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-bfs-toggle]');
    if (!btn) return;
    var tile = btn.closest('[data-bfs-item]');
    if (!tile || tile.dataset.required === 'true' || btn.disabled) return;

    var on = tile.dataset.selected !== 'true';
    var id = tile.dataset.variantId;

    if (!autoAdd || !id) { paint(tile, on); recalc(); return; }

    btn.disabled = true;
    (on
      ? addLines([{ id: +id, quantity: 1, properties: { _bundle_tier: +tile.dataset.tierPercent || 0 } }])
      : removeLine(id)
    )
      .then(function (res) {
        paint(tile, on);
        return readCart().then(function (cart) {
          recalc();
          return announceCart(cart, res && res.sections, id);
        });
      })
      .catch(function (err) {
        console.error('[build-full-set]', err);
        alert(err.message || 'Sorry, your cart could not be updated.');
      })
      .then(function () { btn.disabled = false; });
  });

  /* ---------------- Add to cart integration ---------------- */

  function mainLineFrom(fd) {
    var line = { id: +fd.get('id'), quantity: parseInt(fd.get('quantity'), 10) || 1 };
    var sellingPlan = fd.get('selling_plan');
    if (sellingPlan) line.selling_plan = +sellingPlan;
    var props = {};
    fd.forEach(function (value, key) {
      var m = /^properties\[(.+)\]$/.exec(key);
      if (m && typeof value === 'string' && value !== '') props[m[1]] = value;
    });
    if (Object.keys(props).length) line.properties = props;
    return line;
  }

  function bundleAchieved() {
    var achieved = 0;
    tiles.forEach(function (t) {
      if (t.dataset.selected === 'true') achieved += (+t.dataset.tierPercent || 0);
    });
    return achieved;
  }

  function selectedUpsellLines(achieved, parentVariantId) {
    var parent = String(parentVariantId);
    var lines = [];
    var seen = {};

    if (!root.hidden) {
      tiles.forEach(function (t) {
        if (t.dataset.required === 'true' || t.dataset.selected !== 'true') return;
        var vid = +t.dataset.variantId;
        if (!vid || seen[vid] || cartIds.indexOf(vid) > -1) return;
        seen[vid] = true;
        lines.push({
          id: vid,
          quantity: 1,
          properties: {
            _bundle_id: root.id,
            _bundle_tier: +t.dataset.tierPercent || 0,
            _bundle_total: achieved,
            _parent_variant: parent
          }
        });
      });
    }

    document.querySelectorAll('.upsell-addon-item .upsell-addon-checkbox:checked').forEach(function (cb) {
      var vid = +(cb.dataset.variantId || cb.value);
      if (!vid || seen[vid]) return;
      seen[vid] = true;
      lines.push({ id: vid, quantity: 1, properties: { 'Added with': PRODUCT_TITLE, _parent_variant: parent } });
    });

    return lines;
  }

  if (!window.__bfsSubmitBound) {
    window.__bfsSubmitBound = true;
    var busy = false;

    window.addEventListener('submit', function (e) {
      var form = e.target;
      if (!form || form.tagName !== 'FORM') return;
      if (!/\/cart\/add/.test(form.getAttribute('action') || '')) return;

      var fd = new FormData(form);
      var mainId = fd.get('id');
      if (!mainId || !DATA.variants[String(mainId)]) return;

      if (busy) return;

      var achieved, upsells, main;
      try {
        achieved = bundleAchieved();
        upsells = selectedUpsellLines(achieved, mainId);
        main = mainLineFrom(fd);
      } catch (err) {
        console.error('[build-full-set]', err);
        return;
      }
      if (!upsells.length) return;

      e.preventDefault();
      e.stopImmediatePropagation();
      busy = true;
      var release = setTimeout(function () { busy = false; }, 15000);

      var submitBtn = form.querySelector('[type="submit"]');
      var wasDisabled = submitBtn ? submitBtn.disabled : false;
      if (submitBtn) { submitBtn.setAttribute('aria-busy', 'true'); submitBtn.disabled = true; }

      var qtyBefore = cartQty[main.id] || 0;
      var skippedMsg = '';

      if (DEBUG) console.info('[build-full-set] adding', [main].concat(upsells));

      applyDiscount(achieved)
        .then(function () { return addLines([main].concat(upsells)); })
        .catch(function (err) {
          skippedMsg = err.message || '';
          return readCart().then(function () {
            if ((cartQty[main.id] || 0) > qtyBefore) return {};
            return addLines([main]);
          });
        })
        .then(function (res) {
          return readCart().then(function (cart) {
            verifyDiscount(cart, achieved);
            tiles.forEach(function (t) {
              paint(t, t.dataset.required === 'true' || cartIds.indexOf(+t.dataset.variantId) > -1);
            });
            recalc();
            resetAddNowButtons();
            return announceCart(cart, res && res.sections, mainId);
          });
        })
        .then(function () {
          {% comment %} openDrawer(); {% endcomment %}
          if (skippedMsg) alert(skippedMsg);
        })
        .catch(function (err) {
          console.error('[build-full-set]', err);
          alert(err.message || 'Sorry, this item could not be added to your cart.');
        })
        .then(function () {
          clearTimeout(release);
          busy = false;
          if (submitBtn) { submitBtn.removeAttribute('aria-busy'); submitBtn.disabled = wasDisabled; }
        });
    }, true);
  }

  /* ---------------- variant switching ---------------- */

  function currentVariantId() {
    var inputs = document.querySelectorAll('form[action*="/cart/add"] [name="id"]');
    for (var i = 0; i < inputs.length; i++) {
      if (inputs[i].value && DATA.variants[inputs[i].value]) return inputs[i].value;
    }
    var p = new URLSearchParams(window.location.search).get('variant');
    if (p && DATA.variants[p]) return p;
    return root.dataset.currentVariant;
  }

  var queued = false;
  function check() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(function () {
      queued = false;
      var id = currentVariantId();
      if (id && String(id) !== currentKey) build(id);
    });
  }

  document.addEventListener('change', check, true);
  ['variant:update', 'variant:change', 'variantChange', 'product:variant-change'].forEach(function (evt) {
    document.addEventListener(evt, check);
  });
  window.addEventListener('popstate', check);

  var productArea = document.querySelector('product-form-component');
  if (productArea && window.MutationObserver) {
    new MutationObserver(check).observe(productArea, { attributes: true, childList: true, subtree: true });
  }

  function onExternalCartChange(e) {
    var d = e.detail || {};
    if (d.source === 'build-full-set' || (d.data && d.data.source === 'build-full-set')) return;
    readCart().then(function () {
      if (autoAdd) {
        tiles.forEach(function (t) {
          paint(t, t.dataset.required === 'true' || cartIds.indexOf(+t.dataset.variantId) > -1);
        });
      }
      recalc();
    });
  }
  document.addEventListener('cart:update', onExternalCartChange);
  document.addEventListener('cart:updated', onExternalCartChange);

  readCart().then(function () { build(currentVariantId()); });
})();
</script>
{%- endif -%}


