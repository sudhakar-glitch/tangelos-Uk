    },
    {
      "type": "paragraph",
      "content": "This section displays FAQs from the product's `custom.product_faqs` metafield."
    }
  ],
  "presets": [
    {
      "name": "Product FAQs"
    }
  ],
  "blocks": []
}
{% endschema %}
