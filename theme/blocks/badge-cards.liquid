        { "value": "cotton", "label": "Cotton" },
        { "value": "shield", "label": "Shield / Safe" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "heart", "label": "Heart" },
        { "value": "droplet", "label": "Droplet" },
        { "value": "sparkle", "label": "Sparkle" },
        { "value": "check", "label": "Check" },
        { "value": "half_circle", "label": "Half circle" },
        { "value": "circle", "label": "Circle" },
        { "value": "none", "label": "No icon" }
      ]
    },
    { "type": "image_picker", "id": "image_1", "label": "Custom icon image" },
    { "type": "textarea", "id": "text_1", "label": "Text", "default": "Soft &\nbreathable" },

    { "type": "header", "content": "Badge 2" },
    {
      "type": "select", "id": "icon_2", "label": "Icon", "default": "cotton",
      "options": [
        { "value": "breathable", "label": "Breathable (air)" },
        { "value": "cotton", "label": "Cotton" },
        { "value": "shield", "label": "Shield / Safe" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "heart", "label": "Heart" },
        { "value": "droplet", "label": "Droplet" },
        { "value": "sparkle", "label": "Sparkle" },
        { "value": "check", "label": "Check" },
        { "value": "half_circle", "label": "Half circle" },
        { "value": "circle", "label": "Circle" },
        { "value": "none", "label": "No icon" }
      ]
    },
    { "type": "image_picker", "id": "image_2", "label": "Custom icon image" },
    { "type": "textarea", "id": "text_2", "label": "Text", "default": "100% organic\ncotton" },

    { "type": "header", "content": "Badge 3" },
    {
      "type": "select", "id": "icon_3", "label": "Icon", "default": "shield",
      "options": [
        { "value": "breathable", "label": "Breathable (air)" },
        { "value": "cotton", "label": "Cotton" },
        { "value": "shield", "label": "Shield / Safe" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "heart", "label": "Heart" },
        { "value": "droplet", "label": "Droplet" },
        { "value": "sparkle", "label": "Sparkle" },
        { "value": "check", "label": "Check" },
        { "value": "half_circle", "label": "Half circle" },
        { "value": "circle", "label": "Circle" },
        { "value": "none", "label": "No icon" }
      ]
    },
    { "type": "image_picker", "id": "image_3", "label": "Custom icon image" },
    { "type": "textarea", "id": "text_3", "label": "Text", "default": "OEKO-TEX\nClass I baby safe" },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#F3EFE7" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#3E6B4F" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#2B2B2B" },
    { "type": "range", "id": "card_radius", "label": "Corner radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 16, "max": 56, "step": 2, "unit": "px", "default": 22 },
    { "type": "header", "content": "Icon background" },
