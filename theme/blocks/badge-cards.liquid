    { "type": "range", "id": "margin_top", "label": "Top space", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "margin_bottom", "label": "Bottom space", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 12 }
  ],
  "presets": [
    { "name": "Badge cards" }
  ]
