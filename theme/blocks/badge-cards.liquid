    { "type": "color", "id": "icon_bg", "label": "Icon background color", "default": "#FFFFFF" },
    {
      "type": "select", "id": "icon_bg_shape", "label": "Shape", "default": "circle",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "rounded", "label": "Rounded square" }
