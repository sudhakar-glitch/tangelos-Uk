{%- comment -%}
  Tangelos · Delivery answered before checkout  (V1 · #10 Delivery estimate, A6)
  ---------------------------------------------------------------------------------
  One approved promise, shown the same way everywhere.
  Three rows: delivery window · free delivery · returns. Every line is editable in the
  theme editor; leave a row's title empty to hide that row.
  Put this file in  blocks/delivery-promise.liquid , then add the "Delivery promise" block
  under Buy buttons in the product template.
{%- endcomment -%}

{%- liquid
  assign s = block.settings
  assign has_any = false
  if s.row1_title != blank or s.row2_title != blank or s.row3_title != blank
    assign has_any = true
  endif
-%}

{%- if has_any -%}
  <div
    class="tg-dp spacing-style"
    style="{% render 'spacing-style', settings: s %}"
    {{ block.shopify_attributes }}
  >
    <ul class="tg-dp__list" role="list">
      {%- if s.row1_title != blank -%}
        <li class="tg-dp__row">
          <span class="tg-dp__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6.5h11v9H3z"/><path d="M14 9.5h3.6l3.4 3.4v2.6h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>
          </span>
          <span class="tg-dp__text">
            <span class="tg-dp__title">{{ s.row1_title }}</span>
            {%- if s.row1_text != blank -%}
              <span class="tg-dp__sub">{{ s.row1_text }}</span>
            {%- endif -%}
          </span>
        </li>
      {%- endif -%}

      {%- if s.row2_title != blank -%}
        <li class="tg-dp__row">
          <span class="tg-dp__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/><path d="M7 14.5h4"/></svg>
          </span>
          <span class="tg-dp__text">
            <span class="tg-dp__title">{{ s.row2_title }}</span>
            {%- if s.row2_text != blank -%}
              <span class="tg-dp__sub">{{ s.row2_text }}</span>
            {%- endif -%}
          </span>
        </li>
      {%- endif -%}

      {%- if s.row3_title != blank -%}
        <li class="tg-dp__row">
          <span class="tg-dp__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 0 2.4-5.7"/><path d="M4 4.5v4h4"/></svg>
          </span>
          <span class="tg-dp__text">
            <span class="tg-dp__title">{{ s.row3_title }}</span>
            {%- if s.row3_text != blank -%}
              {%- if s.row3_link != blank -%}
               <a href="#delivery-returns" data-dr-open class="ethics-btn tg-dp__sub tg-dp__link">{{ s.row3_text }}</a>
              {%- else -%}
                <span class="tg-dp__sub">{{ s.row3_text }}</span>
              {%- endif -%}
            {%- endif -%}
          </span>
        </li>
      {%- endif -%}
    </ul>
  </div>

{% comment %}
  Delivery & Returns side panel (standalone)
  Open it from any link or button with the attribute data-dr-open, e.g.
  <a href="#delivery-returns" data-dr-open class="ethics-btn tg-dp__sub tg-dp__link">{{ s.row3_text }}</a>
{% endcomment %}

<div class="dr-overlay" id="drOverlay" hidden></div>

<aside class="dr-panel" id="drPanel" role="dialog" aria-modal="true" aria-labelledby="drTitle" aria-hidden="true">

  <div class="dr-header">
    <h2 class="dr-title" id="drTitle">Delivery &amp; Returns</h2>
    <button type="button" class="dr-x" data-dr-close aria-label="Close">&times;</button>
  </div>

  <div class="dr-body">  

    <!-- Wrong item -->
    <div class="dr-text">
<div class="content-block--page  py-5 ">
<!-- Returns policy: paste into a Custom Liquid block, a page, or the Delivery & Returns panel -->
<div class="tg-returns">
  <p class="tg-returns__lead"><strong>365-Day Returns:</strong> You can return your bedding within 365 days of delivery.</p>
  <ul class="tg-returns__list">
    <li><strong>UK Only:</strong> Returns are accepted within the UK only.</li>
    <li><strong>Product Condition:</strong> Wash care labels must remain attached. Products with any odour are non-refundable.</li>
    <li><strong>Final Sale:</strong> Final sale items are non-refundable, and promotions cannot be transferred to another order.</li>
    <li><strong>Return Approval:</strong> Tangelos reserves the right to accept or reject returns based on product condition.</li>
    <li><strong>Incorrect Items:</strong> Contact <a href="mailto:care@tangelos.co.uk">care@tangelos.co.uk</a> immediately if you send the wrong item. Recovery is not guaranteed, and no compensation is provided.</li>
    <li><strong>Processing Time:</strong> Allow up to 14 business days after carrier receipt and weighing.</li>
    <li><strong>Refund Timeline:</strong> Refunds appear on your credit card within 48 hours of refund notification. Email confirmation will be sent once processed.</li>
    <li><strong>Missing Returns:</strong> Proof of shipment and receipt via tracking is required if we haven't received your return.</li>
    <li><strong>Lost Packages:</strong> If tracking doesn't confirm shipment or delivery, file a claim with the carrier before a refund can be processed.</li>
  </ul>
</div>

