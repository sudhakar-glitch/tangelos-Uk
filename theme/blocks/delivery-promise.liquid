<style>
.dr-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.35); backdrop-filter: blur(2px); z-index: 10000; }
.dr-overlay[hidden] { display: none !important; }
.dr-panel { position: fixed; top: 0px !important; right: 0; bottom: 0; width: 500px; max-width: 100%; background: #fff; border-left: 1px solid #e0ddd9; z-index: 10001; display: flex; flex-direction: column; transform: translateX(100%); transition: transform 0.35s cubic-bezier(0.4,0,0.2,1); visibility: hidden; }
.dr-panel.is-open { transform: translateX(0); visibility: visible; }

.dr-header { display: flex; justify-content: space-between; align-items: center; padding: 28px 32px 20px; border-bottom: 1px solid #eee; flex-shrink: 0; }
.dr-title { margin: 0; font-size: 20px; font-weight: 400; color: #1a1a1a; letter-spacing: 0.01em; }
.dr-x { background: none; border: none; font-size: 24px; color: #bbb; cursor: pointer; line-height: 1; padding: 0; width: 24px !important; transition: color 0.2s; }
.dr-x:hover { color: #1a1a1a; }

.dr-body { flex: 1; overflow-y: auto; padding: 28px 32px 32px; }
.dr-label { margin: 28px 0 12px; font-size: 9px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #1a1a1a; }
.dr-label:first-child { margin-top: 0; }

.dr-rows { border: 1px solid #ece9e4; border-radius: 4px; }
.dr-row { display: flex; align-items: flex-start; gap: 14px; padding: 16px 18px; }
.dr-row + .dr-row { border-top: 1px solid #f0ede8; }
.dr-icon { flex: 0 0 34px; height: 34px; border-radius: 50%; background: #f4efe6; display: flex; align-items: center; justify-content: center; }
.dr-icon svg { width: 17px; height: 17px; stroke: #1a1a1a; fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.dr-row-title { margin: 0 0 3px; font-size: 13px; font-weight: 600; color: #1a1a1a; line-height: 1.35; }
.dr-row-sub { margin: 0; font-size: 12px; line-height: 1.5; color: #777; }

.dr-text p, .dr-text li { font-size: 12px; line-height: 1.75; color: #777; }
.dr-text p { margin: 0 0 10px; }
.dr-text ul { margin: 0 0 10px; padding-left: 18px; }
.dr-text a { color: #1a1a1a; text-decoration: underline; text-underline-offset: 2px; }

.dr-footer { padding: 16px 32px; border-top: 1px solid #eee; flex-shrink: 0; }
.dr-close-btn { width: 100%; background: #1a1a1a; color: #fff; border: none;  font-size: 9px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; padding: 16px; cursor: pointer; transition: background 0.2s; }
.dr-close-btn:hover { background: #333; }
a.ethics-btn.tg-dp__sub.tg-dp__link {
    background: unset;
    text-align: start;
    padding: 0;
    text-transform: capitalize;
        font-weight: 400;
        letter-spacing: normal;
}


@media (max-width: 480px) {
  .dr-panel { top: 0 !important; width: 100%; }
  .dr-header, .dr-body, .dr-footer { padding-left: 20px; padding-right: 20px; }
}
</style>

<script>
(function () {
  var panel = document.getElementById('drPanel');
  var overlay = document.getElementById('drOverlay');
  if (!panel || !overlay || window.tgDrReady) return;
  window.tgDrReady = true;
  // Move to <body> so no theme section (transform/overflow) can trap or hide it
  document.body.appendChild(overlay);
  document.body.appendChild(panel);
  var lastFocus = null;

  function setTop() {
    if (window.innerWidth <= 480) { panel.style.top = ''; return; }
    var header = document.querySelector('header') || document.querySelector('.site-header') || document.querySelector('.header');
    if (header) panel.style.top = header.offsetHeight + 'px';
  }

  function open() {
    lastFocus = document.activeElement;
    setTop();
    overlay.hidden = false;
    panel.classList.add('is-open');
    panel.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    var x = panel.querySelector('.dr-x');
    if (x) setTimeout(function () { x.focus(); }, 50);
  }

  function close() {
    if (!panel.classList.contains('is-open')) return;
    panel.classList.remove('is-open');
    panel.setAttribute('aria-hidden', 'true');
    overlay.hidden = true;
    document.body.style.overflow = '';
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }

  // Capture phase: runs before the theme's own click code on the link,
  // and stops that code so only this panel opens.
  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-dr-open]')) {
      e.preventDefault();
      e.stopImmediatePropagation();
      open();
      return;
    }
    if (e.target.closest('[data-dr-close]') || e.target === overlay) close();
  }, true);
  window.tgOpenDelivery = open;
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  window.addEventListener('resize', setTop);
})();
</script>



{%- endif -%}

{% stylesheet %}
  .tg-dp {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    margin-top: 16px;
    color: #1A1A1A;
    letter-spacing: 0;
  }

  .tg-dp__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid #DCD6CC;
    border-radius: 10px;
    background: #FFFFFF;
    overflow: hidden;
  }

  .tg-dp__row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: 0;
    padding: 12px 16px;
  }

  .tg-dp__row + .tg-dp__row {
    border-top: 1px solid #ECE7DE;
  }

  .tg-dp__icon {
    flex: none;
    display: inline-flex;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    color: #4F4A43;
  }

  .tg-dp__text {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tg-dp__title {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .tg-dp__sub {
    font-size: 12px;
    line-height: 1.4;
    color: #6B665E;
    overflow-wrap: anywhere;
  }

  .tg-dp__link {
    color: #6B665E;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(0, 0, 0, 0.25);
  }

  .tg-dp__link:hover {
    color: #1A1A1A;
  }
{% endstylesheet %}

