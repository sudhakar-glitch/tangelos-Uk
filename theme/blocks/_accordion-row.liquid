
{% assign block_settings = block.settings %}

{% capture accordion_row_children %}
  <details
    class="details"
    data-testid="accordion-details"
    {% if block_settings.open_by_default %}
      open
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <summary class="details__header">
      {% render 'icon-or-image',
        icon: block_settings.icon,
        image_upload: block_settings.image_upload,
        width: block_settings.width,
        class_name: 'details__icon'
      %}
      {{ block_settings.heading }}
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
      <span class="svg-wrapper icon-plus">
        {{- 'icon-plus.svg' | inline_asset_content -}}
      </span>
    </summary>
{% assign title_downcase = product.title | downcase %}

    <div class="details-content new-cnt">
     
{% if block_settings.heading =="View Certificationaas" %}
<div class="tab-pane active" id="pane-certs">
      <div class="cert-card">
        <div class="cert-card-header">
          <div class="cert-card-title">GOTS Certified</div>
          <div class="cert-status">Active</div>
        </div>
        <div class="cert-meta">Global Organic Textile Standard</div>
        <div class="cert-body">Ensures the organic status of textiles from harvesting of the raw materials through environmentally and socially responsible manufacturing.</div>
        <div class="cert-footer">
          <div class="cert-license">License No: GCL-3209</div>
          
        </div>
      </div>
      <div class="cert-card">
        <div class="cert-card-header">
          <div class="cert-card-title">OEKO-TEX® Standard 100</div>
          <div class="cert-status">Active</div>
        </div>
        <div class="cert-meta">Class 1 (Baby Safe) · 15.HIN.75800</div>
        <div class="cert-body">Every component — every thread, button and accessory — has been tested and is certified harmless for human health.</div>
        <div class="cert-footer">
          <div class="cert-license">License No: 15.HIN.75800</div>
          
        </div>
      </div>
      
    </div> 
  {% endif %}


 {% if block_settings.heading =="View Certifications" %}
{% assign current_product_name = product.title | downcase %}

{% if current_product_name contains 'linen' %}
  <div class="main-descriptions">
        <div class="descriptions">
            <div class="des">
           <img style="margin: auto; width: 31%;" width="873" height="496" src="https://cdn.shopify.com/s/files/1/0647/5930/0256/files/oeko-tex.png" class="linen_gots">
            </div>
          </div>
<style>
.details-content.new-cnt .main-descriptions .image-block--height-fit.spacing-style.size-style {
display: none;
}
</style>
 {% endif %}
{% endif %}



      {% if block_settings.heading =="Material Specifications" %}
{% comment %} Descriptions {% endcomment %}
<div class="main-descriptions">
        <div class="descriptions">
            <div class="des">
           {{ product.description }}
            </div>
            {% comment %} <div class="highlights"> {{ product.metafields.custom.product_highlight.value }} </div> {% endcomment %}
          </div>
      
        {% comment %} <div class="informations">
          {% assign features = product.metafields.custom.additional_information.value %}
{% if features %}
  <ul>
    {% for child in features.children[0].children %}
      <li>
        {% for subchild in child.children %}
          {% if subchild.bold %}
            <strong>{{ subchild.value }}</strong>
          {% else %}
            {{ subchild.value }}
          {% endif %}
        {% endfor %}
      </li>
    {% endfor %}
  </ul>
{% endif %}
 </div> {% endcomment %}


      {% else %}
         {% content_for 'blocks' %}
      {% endif %}



{% assign current_product_name = product.title | downcase %}

{% if current_product_name contains 'linen'%}

{% endif %}


{% if current_product_name contains 'cover set'%}
<style>
  .accordion--caret.border-style.spacing-style.accordion--dividers accordion-custom:nth-child(4)
  {
    display:block !important;
  }
</style>
{% endif %}

  <script>
  document.addEventListener('DOMContentLoaded', function () {
  if (typeof jQuery === 'undefined') {
    console.error('jQuery not loaded');
    return;
  }

  (function ($) {
    $(document).ready(function () {
      setTimeout(function() {
    var h1Text = $('h1').first().text();

  if (!h1Text.includes('Duvet Set') && !h1Text.includes('Cover Set')) {
    $('.accordion--caret.border-style.spacing-style.accordion--dividers accordion-custom').each(function () {
      var summaryText = $(this).find('summary').first().text().trim();

      if (summaryText.includes("What's Included")) {
        $(this).hide();
      }
    });
  }
        
            }, 1000);
    });
  })(jQuery);
});
  </script>
  
    </div>
  </details>
{% endcapture %}
{% render 'accordion-custom-component',
  children: accordion_row_children,
  open_by_default_on_desktop: block_settings.open_by_default,
  open_by_default_on_mobile: block_settings.open_by_default
%}

{% stylesheet %}
  .details__icon {
    height: auto;
    margin-inline-end: var(--margin-xs);
  }
{% endstylesheet %}




