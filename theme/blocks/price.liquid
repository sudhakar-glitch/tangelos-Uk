<script>
  window.__SaveBadgeVariants = window.__SaveBadgeVariants || {};
  window.__SaveBadgeVariants['{{ product_resource.id }}'] = [
    {%- for variant in product_resource.variants -%}
      {
        "id": {{ variant.id }},
        "price": {{ variant.price | default: 0 }},
        "compare_at_price": {{ variant.compare_at_price | default: 0 }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];
</script>

<script>
(function () {
  var BLOCK_ID   = '{{ block.id }}';
  var PRODUCT_ID = '{{ product_resource.id }}';

  function updateBadge(variantId) {
{% comment %} var pct_ampunt =0; {% endcomment %}

    var badge = document.getElementById('price-save-badge-' + BLOCK_ID);
    if (!badge) return;
    var variants = window.__SaveBadgeVariants[PRODUCT_ID];
    if (!variants) return;
    var variant = variants.find(function(v) { return v.id === variantId; });
    if (!variant) return;
    if (variant.compare_at_price > variant.price) {
      var pct = Math.floor((variant.compare_at_price - variant.price) * 100 / variant.compare_at_price);

      badge.textContent = 'SAVE ' + pct + '%';
      badge.style.display = '';
    } else {
      badge.style.display = 'none';
    }
  }

  function currentVariantId() {
    var urlId = parseInt(new URLSearchParams(window.location.search).get('variant'), 10);
    if (urlId) return urlId;
    var input = document.querySelector('form[action*="/cart/add"] input[name="id"]');
    if (input) return parseInt(input.value, 10);
    return null;
  }

  /* Listen for variant changes */
  ['variant:change', 'variant:changed', 'variantSelected'].forEach(function(evt) {
    document.addEventListener(evt, function(e) {
      var id = e.detail && (e.detail.id || (e.detail.variant && e.detail.variant.id));
      updateBadge(id || currentVariantId());
    });
  });

  /* Fallback: poll URL every 200ms */
  var _last = null;
  setInterval(function() {
    var id = currentVariantId();
    if (id && id !== _last) { _last = id; updateBadge(id); }
  }, 200);

  /* Init on load */
  var id = currentVariantId();
  if (id) updateBadge(id);
})();
</script>



<script>
  window.__VariantPrices = window.__VariantPrices || {};
  window.__VariantPrices['{{ product_resource.id }}'] = [
    {%- for variant in product_resource.variants -%}
      {
        "id": {{ variant.id }},
        "price": {{ variant.price | default: 0 }},
        "compare_at_price": {{ variant.compare_at_price | default: 0 }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];
</script>

<script>
(function () {
  var PRODUCT_ID = '{{ product_resource.id }}';
  var BLOCK_ID   = '{{ block.id }}';

  function formatMoney(cents) {
    var amount = (cents / 100).toFixed(2).replace('.00', '');
    return '£' + amount;
  }

  function updatePrice(variantId) {
    var variants = window.__VariantPrices[PRODUCT_ID];
    if (!variants) return;
    var variant = variants.find(function(v) { return v.id === variantId; });
    if (!variant) return;

    var priceEl = document.querySelector('product-price[data-block-id="' + BLOCK_ID + '"]');
    if (!priceEl) return;

    var isOnSale = variant.compare_at_price > variant.price;

    /* ── Sale containers ── */
    var saleContainer    = priceEl.querySelector('.price__sale');
    var regularContainer = priceEl.querySelector('.price__regular');

    /* ── Price elements ── */
    var salePriceEl  = priceEl.querySelector('.price-item--sale');
    var regularEl    = priceEl.querySelector('.price__regular .price-item--regular');
    var compareEl    = priceEl.querySelector('.price-item--regular:not(.price__regular .price-item--regular), s .price-item--regular, .price__compare .price-item--regular');

    if (isOnSale) {
      /* Show sale layout */
      if (saleContainer)    saleContainer.style.display    = '';
      if (regularContainer) regularContainer.style.display = 'none';

      /* Update sale price */
      if (salePriceEl) {
        salePriceEl.innerHTML = formatMoney(variant.price);
      }

      /* Update compare-at price — strip GBP currency code */
      if (compareEl) {
        compareEl.innerHTML = formatMoney(variant.compare_at_price);
      }

      /* Fallback: find any <s> strikethrough element */
      var strikeEl = priceEl.querySelector('s');
      if (strikeEl) {
        var bdi = strikeEl.querySelector('bdi');
        if (bdi) {
          bdi.textContent = formatMoney(variant.compare_at_price);
        } else {
          strikeEl.textContent = formatMoney(variant.compare_at_price);
        }
      }

    } else {
      /* Show regular layout */
      if (saleContainer)    saleContainer.style.display    = 'none';
      if (regularContainer) regularContainer.style.display = '';

      /* Update regular price */
      if (regularEl) {
        var bdi = regularEl.querySelector('bdi');
        if (bdi) {
          bdi.textContent = formatMoney(variant.price);
        } else {
          regularEl.textContent = formatMoney(variant.price);
        }
      }
    }

    /* ── Update save badge ── */
    var badge = document.getElementById('price-save-badge-' + BLOCK_ID);
    if (badge) {
      if (isOnSale) {
        var pct = Math.floor((variant.compare_at_price - variant.price) * 100 / variant.compare_at_price);

        badge.textContent = 'SAVE ' + pct + '%';
        badge.style.display = '';
      } else {
        badge.style.display = 'none';
      }
    }

    /* ── Strip GBP currency code anywhere in price block ── */
    setTimeout(function() {
      var walker = document.createTreeWalker(priceEl, NodeFilter.SHOW_TEXT, null, false);
      var node;
      while ((node = walker.nextNode())) {
        if (/\s?GBP/i.test(node.textContent)) {
          node.textContent = node.textContent.replace(/\s?GBP/gi, '').trim();
        }
      }
    }, 10);
  }

  function currentVariantId() {
    var urlId = parseInt(new URLSearchParams(window.location.search).get('variant'), 10);
    if (urlId) return urlId;
    var input = document.querySelector('form[action*="/cart/add"] input[name="id"]');
    if (input) return parseInt(input.value, 10);
    return null;
  }

  /* ── Variant change events ── */
  ['variant:change', 'variant:changed', 'variantSelected', 'on:variant:change'].forEach(function(evt) {
    document.addEventListener(evt, function(e) {
      var id = e.detail && (e.detail.id || (e.detail.variant && e.detail.variant.id));
      updatePrice(id || currentVariantId());
    });
  });

  /* ── Radio / select change ── */
  document.addEventListener('change', function(e) {
    var form = e.target.closest('form[action*="/cart/add"]');
    if (!form) return;
    var input = form.querySelector('input[name="id"]:checked, input[name="id"]:not([type="radio"]), select[name="id"]');
    if (input) updatePrice(parseInt(input.value, 10));
  });

  /* ── URL polling fallback every 200ms ── */
  var _last = null;
  setInterval(function() {
    var id = currentVariantId();
    if (id && id !== _last) { _last = id; updatePrice(id); }
  }, 200);

  /* ── Init on load ── */
  var id = currentVariantId();
  if (id) { _last = id; updatePrice(id); }

})();
</script>