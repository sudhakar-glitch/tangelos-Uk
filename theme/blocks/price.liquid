    line-height: 1.1;
  }

  /* Hide .00 trailing zeros via CSS on bdi elements that end in .00 */
  product-price bdi {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 749px) {
    .price-row__comp-price { font-size: 15px; }
    .price-row__competitors { gap: 12px; }
  }
{% endstylesheet %}

<script>
(function() {
  /* Walk every text node inside an element and strip .00 */
  function stripEl(el) {
    var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null, false);
    var node;
    while ((node = walker.nextNode())) {
      if (node.textContent.indexOf('.00') !== -1) {
        node.textContent = node.textContent.replace(/\.00/g, '');
      }
    }
  }

  function stripAll() {
    var wrap = document.querySelector('.price-row-wrap');
    if (wrap) stripEl(wrap);
  }

  /* Run immediately + after DOM ready */
  stripAll();
  document.addEventListener('DOMContentLoaded', stripAll);

  /* Listen for all variant change events themes use */
  ['variant:changed', 'variantSelected', 'on:variant:change'].forEach(function(evt) {
    document.addEventListener(evt, function() { setTimeout(stripAll, 0); });
  });

  /* MutationObserver — fires on every price DOM update */
  var observer = new MutationObserver(function() { stripAll(); });

  function startObserver() {
    var wrap = document.querySelector('.price-row-wrap');
    if (wrap) {
      observer.observe(wrap, { childList: true, subtree: true, characterData: true });
    } else {
      setTimeout(startObserver, 200);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startObserver);
  } else {
    startObserver();
  }
})();
</script>

