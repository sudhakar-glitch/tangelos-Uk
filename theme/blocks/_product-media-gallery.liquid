
<div class="sdp-sticky-badge-row" aria-hidden="true" >
  <span class="sdp-badge" id="sdp-badge"></span>
</div>
{% if product.title contains 'Linen' %}
<div class="product-media-badges"> <span class="product-media-badge" style="color: #111111;background-color: #ffffff;">
    <img src="https://cdn.shopify.com/s/files/1/0647/5930/0256/files/okeo.svg?v=1788157314" alt="OEKO-TEX." width="14" height="14" loading="lazy" class="product-media-badge__icon">
    <span class="product-media-badge__text">OEKO-TEX</span> </span> 
</div>
{% else %}
<div class="product-media-badges"> <span class="product-media-badge" style="color: #111111;background-color: #ffffff;">
    <img src="https://cdn.shopify.com/s/files/1/0647/5930/0256/files/okeo.svg?v=1788157314" alt="OEKO-TEX." width="14" height="14" loading="lazy" class="product-media-badge__icon">
    <span class="product-media-badge__text">OEKO-TEX</span> </span> 
    <span class="product-media-badge" style="color: #111111;background-color: #ffffff;">
    <img src="https://cdn.shopify.com/s/files/1/0647/5930/0256/files/gots.svg?v=1788157312" alt="GOTS Certified" width="14" height="14" loading="lazy" class="product-media-badge__icon">
      <span class="product-media-badge__text">GOTS Organic</span> </span>
</div>
{% endif %}

<style data-shopify="">
    .product-media-container {
      position: relative;
    }
    .product-media-badges {
      position: absolute;
      top: 15px;
      left: 15px;
      z-index: 3;
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: 6px;
      pointer-events: none;
      
    }
    .product-media-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
      line-height: 1.2;
      white-space: nowrap;
      pointer-events: auto;
    }
    .product-media-badge__icon {
      display: block;
      width: 25px;
      height: 25px;
      object-fit: contain;
      flex-shrink: 0;
    }
    @media screen and (max-width: 749px) {
      .product-media-badges {
        top: 11px;
        left: 10px;
        gap: 4px;
      }
      
      .product-media-badge {
        padding: 2px 6px;
        font-size: 10px;
      }
      .product-media-badge__icon {
        width: 20px;
        height: 20px;
      }
    }
  </style>

{% render 'product-media-gallery-content',
  media_presentation: block.settings.media_presentation,
  block_settings: block.settings,
  block_id: block.id,
  block_shopify_attributes: block.shopify_attributes,
  block: block,
  section: section
%}

{% if block.settings.mobile_aspect_ratio != blank %}
  {% style %}
    @media screen and (max-width: 749px) {
      .product-media-container {
        --media-preview-ratio: {{ block.settings.mobile_aspect_ratio }} !important;
      }
      .product-media-container .product-media,
      .product-media-container img {
        aspect-ratio: {{ block.settings.mobile_aspect_ratio }} !important;
      }
    }
  {% endstyle %}
{% endif %}

<style>
  .sdp-sticky-badge-row {
    position: absolute;
    top: 14px;
    z-index: 2;
    height: 0;
    overflow: visible;
    pointer-events: none;
  }
  .sdp-badge {
    display: inline-block;
    background: #0fb981;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 5px 13px;
    border-radius: 4px;
    line-height: 1.3;
    text-transform: uppercase;
    margin-left: 14px;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .sdp-badge.sdp-show {
    opacity: 1;
  }
</style>


<script>
(function () {
  var badge = document.getElementById('sdp-badge');
  if (!badge) return;

  /* ── Variant data from Liquid ── */
  var variants = [
    {% for variant in product.variants %}
    { id: {{ variant.id }}, price: {{ variant.price }}, compare: {{ variant.compare_at_price | default: 0 }} }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  function calcDiscount(v) {
    if (!v || !v.compare || v.compare <= v.price) return 0;
    return Math.round((v.compare - v.price) * 100 / v.compare);
  }

  function setBadge(pct) {
    if (pct > 0) {
      badge.textContent = pct + '% OFF';
      badge.classList.add('sdp-show');
    } else {
      badge.classList.remove('sdp-show');
    }
  }

  function updateById(id) {
    id = parseInt(id, 10);
    if (!id) return;
    var v = variants.find(function (x) { return x.id === id; });
    setBadge(calcDiscount(v));
  }

  /* ── 1. Horizon native event ── */
  document.addEventListener('variant:changed', function (e) {
    if (e.detail && e.detail.variant) updateById(e.detail.variant.id);
  });

  /* ── 2. Watch URL ?variant= param — Horizon pushes state on size click ── */
  function readUrlVariant() {
    var id = new URLSearchParams(window.location.search).get('variant');
    if (id) updateById(id);
  }

  /* Intercept history.pushState / replaceState */
  (function () {
    function wrap(method) {
      var orig = history[method];
      history[method] = function () {
        orig.apply(this, arguments);
        setTimeout(readUrlVariant, 0);
      };
    }
    wrap('pushState');
    wrap('replaceState');
  })();
  window.addEventListener('popstate', readUrlVariant);

  /* ── 3. Watch hidden variant input (value attr change) ── */
  function watchInput() {
    var input = document.querySelector(
      'input[name="id"][form], .product-form input[name="id"], form[action*="/cart/add"] input[name="id"]'
    );
    if (!input) return;
    new MutationObserver(function () {
      updateById(input.value);
    }).observe(input, { attributes: true, attributeFilter: ['value'] });
  }

  /* ── 4. Watch variant-selector custom element for attribute changes ── */
  function watchVariantSelector() {
    var sel = document.querySelector('variant-selector, [data-selected-variant], .product-form');
    if (!sel) return;
    new MutationObserver(function (mutations) {
      mutations.forEach(function (m) {
        /* catches data-selected-variant attr, or child input changes */
        if (m.type === 'attributes') {
          var id = m.target.getAttribute('data-selected-variant') ||
                   m.target.getAttribute('data-variant-id');
          if (id) updateById(id);
        }
        if (m.type === 'childList') {
          var input = sel.querySelector('input[name="id"]');
          if (input) updateById(input.value);
        }
      });
    }).observe(sel, { attributes: true, subtree: true, childList: true,
                      attributeFilter: ['data-selected-variant','data-variant-id','value'] });
  }

  /* ── 5. Direct click listener on size radio buttons / swatch buttons ── */
  function watchSizeClicks() {
    document.addEventListener('click', function (e) {
      /* Horizon renders sizes as <input type=radio> labels or <button> */
      var target = e.target.closest(
        '[data-variant-id], [data-option-value], label[for], .variant__button, .size-swatch'
      );
      if (!target) return;

      /* Try data attribute first */
      var id = target.getAttribute('data-variant-id');
      if (id) { updateById(id); return; }

      /* Try the associated radio input */
      var forAttr = target.getAttribute('for');
      if (forAttr) {
        var radio = document.getElementById(forAttr);
        if (radio) { setTimeout(function(){ updateById(radio.value); }, 10); }
      }
    });

    /* Also listen to change on radio inputs directly */
    document.addEventListener('change', function (e) {
      if (e.target && e.target.name === 'id') {
        updateById(e.target.value);
      }
      /* Horizon option radios — recalculate from selected combo */
      if (e.target && (e.target.type === 'radio' || e.target.type === 'checkbox')) {
        setTimeout(function () {
          var id = new URLSearchParams(window.location.search).get('variant');
          if (id) updateById(id);
          /* also try hidden input */
          var inp = document.querySelector('input[name="id"]');
          if (inp && inp.value) updateById(inp.value);
        }, 50);
      }
    });
  }

  /* ── Init ── */
  function init() {
    watchInput();
    watchVariantSelector();
    watchSizeClicks();

    /* Initial load */
    var initId = new URLSearchParams(window.location.search).get('variant') ||
                 (variants[0] && variants[0].id);
    if (initId) updateById(initId);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{% schema %}
{
  "name": "t:names.product_media",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "media_presentation",
      "label": "t:settings.type",
      "options": [
        { "value": "grid", "label": "t:options.grid" },
        { "value": "carousel", "label": "t:options.carousel" }
      ],
      "default": "grid",
      "info": "t:info.carousel_layout_on_mobile"
    },
    {
      "type": "header",
      "content": "t:content.grid",
      "visible_if": "{{ block.settings.media_presentation == 'grid' }}"
    },
    {
      "type": "select",
      "id": "media_columns",
      "label": "t:settings.columns",
      "options": [
        { "value": "one", "label": "t:options.one_number" },
        { "value": "two", "label": "t:options.two_number" }
      ],
      "default": "one",
      "visible_if": "{{ block.settings.media_presentation == 'grid' }}"
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.media_presentation == 'grid' }}"
    },
    {
      "type": "checkbox",
      "id": "large_first_image",
      "label": "t:settings.full_width_first_image",
      "default": false,
      "visible_if": "{{ block.settings.media_presentation == 'grid' and block.settings.media_columns == 'two' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icons",
      "options": [
        { "value": "arrow", "label": "t:options.arrows" },
        { "value": "chevron", "label": "t:options.chevrons" },
        { "value": "arrows_large", "label": "t:options.large_arrows" },
        { "value": "chevron_large", "label": "t:options.large_chevrons" }
      ],
      "default": "arrow",
      "visible_if": "{{ block.settings.media_presentation == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "slideshow_controls_style",
      "label": "t:settings.desktop_pagination",
      "options": [
        { "value": "dots", "label": "t:options.dots" },
        { "value": "counter", "label": "t:options.counter" },
        { "value": "thumbnails", "label": "t:options.thumbnails" }
      ],
      "visible_if": "{{ block.settings.media_presentation == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "slideshow_mobile_controls_style",
      "label": "t:settings.mobile_pagination",
      "options": [
        { "value": "dots", "label": "t:options.dots" },
        { "value": "counter", "label": "t:options.counter" },
        { "value": "hint", "label": "t:options.hint" },
        { "value": "thumbnails", "label": "t:options.thumbnails" }
      ]
    },
    {
      "type": "header",
      "content": "t:content.thumbnails",
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' or block.settings.slideshow_mobile_controls_style == 'thumbnails' }}"
    },
    {
      "type": "select",
      "id": "thumbnail_position",
      "label": "t:settings.desktop_position",
      "options": [
        { "value": "left", "label": "t:options.left" },
        { "value": "bottom", "label": "t:options.bottom" },
        { "value": "right", "label": "t:options.right" }
      ],
      "default": "bottom",
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' }}"
    },
    {
      "type": "range",
      "id": "thumbnail_width",
      "label": "t:settings.width_desktop",
      "min": 44,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' }}"
    },
    {
      "type": "range",
      "id": "thumbnail_radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' or block.settings.slideshow_mobile_controls_style == 'thumbnails' }}"
    },
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        { "value": "adapt", "label": "t:options.auto" },
        { "value": "1/1.25", "label": "t:options.portrait" },
        { "value": "1", "label": "t:options.square" },
        { "value": "2/1", "label": "t:options.landscape" }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "mobile_aspect_ratio",
      "label": "Mobile Aspect Ratio",
      "info": "Mobile only (max 749px). Desktop ratio-ஐ மாத்தாம mobile-ல மட்டும் apply ஆகும்.",
      "options": [
        { "value": "", "label": "Same as desktop" },
        { "value": "0.8", "label": "Portrait (4:5)" },
        { "value": "1", "label": "Square (1:1)" },
        { "value": "1.33", "label": "Landscape (4:3)" },
        { "value": "0.75", "label": "Tall (3:4)" },
        { "value": "1.78", "label": "Wide (16:9)" }
      ],
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "constrain_to_viewport",
      "label": "t:settings.limit_media_to_screen_height",
      "default": false
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "t:settings.media_fit",
      "options": [
        { "value": "cover", "label": "t:options.cover" },
        { "value": "contain", "label": "t:options.contain" }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.aspect_ratio == 'adapt' and block.settings.constrain_to_viewport == true }}"
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "extend_media",
      "label": "t:settings.extend_media_to_screen_edge",
      "default": true,
      "visible_if": "{{ section.settings.content_width == 'content-center-aligned' }}"
    },
    {
      "type": "checkbox",
      "id": "zoom",
      "label": "t:settings.enable_zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:settings.enable_video_looping",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_variants",
      "default": false,
      "label": "t:settings.hide_unselected_variant_media"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    { "name": "t:names.product_media" }
  ]
}
{% endschema %}
