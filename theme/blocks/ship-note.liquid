{%- liquid
  assign s = block.settings
  assign uid = 'tg-ship-' | append: block.id

  case s.alignment
    when 'center'
      assign text_align = 'center'
    when 'flex-end'
      assign text_align = 'right'
    else
      assign text_align = 'left'
  endcase

  case s.alignment_mobile
    when 'center'
      assign text_align_m = 'center'
    when 'flex-end'
      assign text_align_m = 'right'
    else
      assign text_align_m = 'left'
  endcase
-%}

<style>
  {%- unless s.use_theme_font -%}
    {{ s.font | font_face: font_display: 'swap' }}
  {%- endunless -%}

  #{{ uid }} {
    justify-content: {{ s.alignment }};
    text-align: {{ text_align }};
    gap: {{ s.gap }}px;
    margin: {{ s.margin_top }}px 0 {{ s.margin_bottom }}px;
    padding: {{ s.padding_v }}px {{ s.padding_h }}px;
    border-radius: {{ s.radius }}px;
    background: {% if s.bg_color != blank %}{{ s.bg_color }}{% else %}transparent{% endif %};
    {%- if s.border_width > 0 %}
    border: {{ s.border_width }}px solid {{ s.border_color }};
    {%- endif %}
    color: {{ s.text_color }};
    font-size: {{ s.font_size }}px;
    {%- if s.uppercase %}
    text-transform: uppercase;
    letter-spacing: 0.04em;
    {%- endif %}
    {%- unless s.use_theme_font %}
    font-family: {{ s.font.family }}, {{ s.font.fallback_families }};
    font-weight: {{ s.font.weight }};
    font-style: {{ s.font.style }};
    {%- endunless %}
  }
  #{{ uid }} .tg-ship__icon {
    width: {{ s.icon_size }}px;
    height: {{ s.icon_size }}px;
    color: {{ s.icon_color }};
  }
  #{{ uid }} .tg-ship__hl {
    color: {{ s.highlight_color }};
    font-weight: {{ s.highlight_weight }};
    {%- if s.highlight_italic %}
    font-style: italic;
    {%- endif %}
    {%- if s.highlight_underline %}
    text-decoration: underline;
    text-underline-offset: 3px;
    {%- endif %}
  }
  @media screen and (max-width: 749px) {
    #{{ uid }} {
      justify-content: {{ s.alignment_mobile }};
      text-align: {{ text_align_m }};
      font-size: {{ s.font_size_mobile }}px;
    }
  }
</style>

<div id="{{ uid }}" class="tg-ship" {{ block.shopify_attributes }}>
  {%- case s.icon -%}
    {%- when 'box' -%}
      <svg class="tg-ship__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96 12 12.01l8.73-5.05"/><path d="M12 22.08V12"/></svg>
    {%- when 'truck' -%}
      <svg class="tg-ship__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
    {%- when 'plane' -%}
      <svg class="tg-ship__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
    {%- when 'clock' -%}
      <svg class="tg-ship__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
    {%- when 'globe' -%}
      <svg class="tg-ship__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
    {%- when 'custom' -%}
      {%- if s.custom_icon != blank -%}
        {{ s.custom_icon | image_url: width: 96 | image_tag: class: 'tg-ship__icon tg-ship__icon--img', alt: '', loading: 'lazy' }}
      {%- endif -%}
  {%- endcase -%}

  <span class="tg-ship__text">
    {{- s.text | escape -}}
    {%- if s.highlight != blank %} <span class="tg-ship__hl">{{ s.highlight | escape }}</span>{% endif -%}
    {%- if s.text_after != blank %} {{ s.text_after | escape }}{% endif -%}
  </span>
</div>

{% stylesheet %}
  .tg-ship {
    display: flex;
    align-items: center;
    width: 100%;
    line-height: 1.4;
    box-sizing: border-box;
  }
  .tg-ship__icon {
    flex-shrink: 0;
    display: block;
  }
  .tg-ship__icon--img {
    object-fit: contain;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shipping note",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "text", "label": "Text", "default": "Ships from India" },
    { "type": "text", "id": "highlight", "label": "Highlighted text", "default": "within 2 days" },
    { "type": "text", "id": "text_after", "label": "Text after highlight (optional)" },

    { "type": "header", "content": "Icon" },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "default": "box",
      "options": [
        { "value": "box", "label": "Box" },
        { "value": "truck", "label": "Truck" },
        { "value": "plane", "label": "Plane" },
        { "value": "globe", "label": "Globe" },
        { "value": "clock", "label": "Clock" },
        { "value": "custom", "label": "Upload my own" },
        { "value": "none", "label": "No icon" }
      ]
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon image",
      "visible_if": "{{ block.settings.icon == 'custom' }}"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.icon != 'none' }}"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#3d6b4f",
      "visible_if": "{{ block.settings.icon != 'none' and block.settings.icon != 'custom' }}"
    },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1a1a1a" },
    { "type": "color", "id": "highlight_color", "label": "Highlight color", "default": "#2e7d32" },
    { "type": "color", "id": "bg_color", "label": "Background color", "info": "Leave empty for transparent" },

    { "type": "header", "content": "Typography" },
    { "type": "checkbox", "id": "use_theme_font", "label": "Use theme font", "default": true },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Custom font",
      "default": "assistant_n4",
      "visible_if": "{{ block.settings.use_theme_font == false }}"
    },
    { "type": "range", "id": "font_size", "label": "Font size (desktop)", "min": 10, "max": 28, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "font_size_mobile", "label": "Font size (mobile)", "min": 10, "max": 28, "step": 1, "unit": "px", "default": 12 },
    {
      "type": "select",
      "id": "highlight_weight",
      "label": "Highlight thickness",
      "default": "700",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ]
    },
    { "type": "checkbox", "id": "highlight_italic", "label": "Highlight italic", "default": false },
    { "type": "checkbox", "id": "highlight_underline", "label": "Highlight underline", "default": false },
    { "type": "checkbox", "id": "uppercase", "label": "All caps", "default": false },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment (desktop)",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "Alignment (mobile)",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ]
    },
    { "type": "range", "id": "gap", "label": "Icon–text gap", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "margin_top", "label": "Space above", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 6 },
    { "type": "range", "id": "margin_bottom", "label": "Space below", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 6 },

    { "type": "header", "content": "Box style" },
    { "type": "range", "id": "padding_v", "label": "Padding top/bottom", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_h", "label": "Padding left/right", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "border_width", "label": "Border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 0 },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#d9e8dc",
      "visible_if": "{{ block.settings.border_width > 0 }}"
    }
  ],
      "presets": [
    {
      "name": "Shipping note"
    }
  ]
}
{% endschema %}