

{% comment %} {% if product.title contains "Butter Bean Muslin Duvet Cover" %}
  
  <div id="shipping-badge" class="shipping-badge" style="text-align:center; padding: 0px 4px;padding-bottom: 10px; border-radius: 4px; margin: 10px 0; display: none;">
    {% assign shipping_date = "2026-06-21" | date: "%s" | times: 1 %}
    {% assign today = "now" | date: "%s" | times: 1 %}
    {% assign days_remaining = shipping_date | minus: today | divided_by: 86400 | ceil %}
    
    {% if days_remaining > 0 %}
      <p style="margin: 5px 0 0 0; font-size: 13px; color: #666;">
        Perfection takes time, but it's worth it.</p>
        <p style="margin: 0px 0 0 0; font-size: 13px; color: #666;"> Pre-order | Ships in {{ days_remaining }} day{% if days_remaining != 1 %}s (20-06-2026){% endif %}</p>
    {% endif %}
  </div>

{% endif %}

<script>
document.addEventListener('DOMContentLoaded', function() {
  
  // Check size selection on page load
  checkShippingBadge();
  
  // Listen for size selector changes (radio buttons)
  document.querySelectorAll('input[type="radio"]').forEach(function(radio) {
    radio.addEventListener('change', checkShippingBadge);
  });
  
  // Listen for size selector changes (dropdown)
  var sizeSelect = document.querySelector('select[type="radio"]');
  if (sizeSelect) {
    sizeSelect.addEventListener('change', checkShippingBadge);
  }
  
  function checkShippingBadge() {
    var badge = document.getElementById('shipping-badge');
    
    // Get selected size from radio or dropdown
    var selectedSize = '';
    var radioChecked = document.querySelector('input[type="radio"]:checked');
    if (radioChecked) {
      selectedSize = radioChecked.value;
    } else {
      var dropdown = document.querySelector('select[type="radio"]');
      if (dropdown) {
        selectedSize = dropdown.value;
      }
    }
    
    // Show badge only for King or Super King
    if (selectedSize && (selectedSize.includes('King') || selectedSize.includes('Super King'))) {
      badge.style.display = 'block';
    } else {
      badge.style.display = 'none';
    }
  }
});
</script>
 {% endcomment %}





 
