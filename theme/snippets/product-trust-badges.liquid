.trust-badge__icon { color: #6b7c5e; margin-bottom: 4px; line-height: 1; }
.trust-badge__label { font-size: 9px; font-weight: 600; letter-spacing: 0.14em; color: #1a1a1a; margin: 0; line-height: 1.3; }
.trust-badge__cta { background: none; border: none; padding-block: 0!important; font-family: inherit; font-size: 8px; font-weight: 500; letter-spacing: 0.1em; color: #888; cursor: pointer; text-decoration: none; text-underline-offset: 2px; align-items: center; gap: 3px; transition: color 0.2s; }
.trust-badge__cta:hover { color: #1a1a1a; }
.trust-badge__cta-arrow { transition: transform 0.25s ease; display: inline-block; }
.trust-badge__cta[aria-expanded="true"] .trust-badge__cta-arrow { transform: rotate(180deg); }

/* ── Overlay ── */
.trust-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.35); backdrop-filter: blur(2px); z-index: 800; opacity: 0; transition: opacity 0.3s; }
.trust-overlay.is-visible { display: block; opacity: 1; }

/* ── Panel ── */
.trust-panel { position: fixed; top: 80px; right: 0; bottom: 0; width: 500px; background: #fff; border-left: 1px solid #e0ddd9; z-index: 801; display: flex; flex-direction: column; transform: translateX(100%); transition: transform 0.35s cubic-bezier(0.4,0,0.2,1); overflow: hidden; }
.trust-panel.is-open { transform: translateX(0); }

/* ── Panel Header ── */
.panel-header { padding: 32px 32px 0; border-bottom: 1px solid #eee; flex-shrink: 0; }
.panel-header-row { display: flex; justify-content: space-between; align-items: center; }
.panel-title { font-size: 20px; font-weight: 400; color: #1a1a1a; letter-spacing: 0.01em; }
.panel-x-close { background: none; border: none; font-size: 22px; color: #bbb; cursor: pointer; line-height: 1; transition: color 0.2s; padding: 0; width:20px !important }
.panel-x-close:hover { color: #1a1a1a; }

/* ── Tabs ── */
.panel-tabs { display: flex; margin-top: 0; }
.panel-tab { flex: 1; background: none; border: none; border-bottom: 1.5px solid transparent; font-family: inherit; font-size: 9px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #bbb; padding: 8px 4px 12px; cursor: pointer; transition: color 0.2s, border-color 0.2s; }
.panel-tab.active { color: #1a1a1a; border-bottom-color: #1a1a1a; }
.panel-tab:hover { color: #555; }

/* ── Panel Body ── */
.panel-body { flex: 1; overflow-y: auto; padding: 32px; }
.tab-pane { display: none; }
.tab-pane.active { display: block; }

/* ── Certs Tab ── */
.cert-card { border: 1px solid #ece9e4; border-radius: 4px; padding: 20px; margin-bottom: 14px; }
.cert-card:last-child { margin-bottom: 0; }
.cert-card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; }
.cert-card-title { font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #1a1a1a; }
.cert-status { font-size: 7px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; border: 1px solid #1a1a1a; padding: 3px 7px; color: #1a1a1a; flex-shrink: 0; }
.cert-meta { font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: #bbb; margin-bottom: 10px; }
.cert-body { font-size: 12px; line-height: 1.75; color: #777; margin-bottom: 14px; }
.cert-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid #f0ede8; }
.cert-license { font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; color: #000; font-weight: 600;}
.cert-link { font-size: 9px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #1a1a1a; text-decoration: underline; text-underline-offset: 2px; transition: opacity 0.2s; background: none; border: none; cursor: pointer; font-family: inherit; }
.cert-link:hover { opacity: 0.5; }

/* ── Report Tab ── */
.report-item { padding: 24px 0; border-bottom: 1px solid #f0ede8; }
.report-item:first-child { padding-top: 0; }
.report-item:last-child { border-bottom: none; }
.report-item-header { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 10px; }
.report-icon { width: 36px; height: 36px; border: 1px solid #e8e5e0; border-radius: 3px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #888; }
.report-icon svg { width: 16px; height: 16px; }
.report-icon--text { flex-direction: column; gap: 2px; }
.report-icon-co2 { font-size: 7px; font-weight: 600; letter-spacing: 0.05em; color: #888; line-height: 1; }
.report-icon--text svg { width: 10px; height: 10px; }
.report-meta { flex: 1; }
.report-title-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px; }
.report-name { font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #1a1a1a; }
.report-score { font-size: 13px; font-weight: 400; color: #1a1a1a; white-space: nowrap; margin-left: 12px; }
.report-method { font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: #bbb; }
.report-desc { font-size: 12px; line-height: 1.75; color: #777; }

/* ── Impact Tab ── */
.impact-item { display: flex; align-items: flex-start; gap: 16px; padding: 24px 0; border-bottom: 1px solid #f0ede8; }
.impact-item:first-child { padding-top: 0; }
.impact-item:last-child { border-bottom: none; }
.impact-icon { width: 36px; height: 36px; border: 1px solid #e8e5e0; border-radius: 3px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #888; }
.impact-icon svg { width: 16px; height: 16px; }
.impact-title { font-size: 14px; font-weight: 500; color: #1a1a1a; margin-bottom: 6px; letter-spacing: 0.01em; }
.impact-desc { font-size: 12px; line-height: 1.75; color: #777; }

/* ── Reviews Tab ── */
.review-summary { text-align: center; padding: 20px 0 32px; border-bottom: 1px solid #f0ede8; margin-bottom: 28px; }
.review-big-score { font-size: 64px; font-weight: 300; color: #1a1a1a; line-height: 1; }
.review-stars { display: flex; justify-content: center; gap: 4px; margin: 10px 0 8px; color: #1a1a1a; font-size: 16px; }
.review-stars .star-empty { color: #ddd; }
.review-count { font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: #bbb; }
.review-item { display: flex; gap: 14px; padding: 22px 0; border-bottom: 1px solid #f0ede8; }
.review-item:last-child { border-bottom: none; }
.review-avatar { width: 36px; height: 36px; border-radius: 50%; background: #ece9e4; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 600; letter-spacing: 0.05em; color: #888; flex-shrink: 0; }
.review-name { font-size: 9px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #1a1a1a; margin-bottom: 4px; }
.review-item-stars { display: flex; gap: 2px; margin-bottom: 8px; color: #1a1a1a; font-size: 11px; }
.review-text { font-size: 12px; line-height: 1.75; color: #777; }

/* ── Footer ── */
.panel-footer { padding: 16px 32px; border-top: 1px solid #eee; flex-shrink: 0; }
.panel-close-btn { width: 100%; background: #1a1a1a; color: #fff; border: none; font-family: inherit; font-size: 9px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; padding: 16px; cursor: pointer; transition: background 0.2s; }
.panel-close-btn:hover { background: #333; }

/* ── Responsive ── */
@media (max-width: 480px) {
  .trust-panel { top: 0 !important; width: 100%; }
}
.sdp-sticky-badge-row{
display:none !important;
}

</style>


<script>
(function() {
  var panel    = document.getElementById('trustPanel');
  var overlay  = document.getElementById('trustOverlay');
  var closeBtn = document.getElementById('panelCloseBtn');
  var xClose   = document.getElementById('panelXClose');
  var ctaBtns  = document.querySelectorAll('.trust-badge__cta');
  var tabs     = document.querySelectorAll('.panel-tab');
  var panes    = document.querySelectorAll('.tab-pane');

  function setPanelTop() {
    var header = document.querySelector('header')
              || document.querySelector('.site-header')
              || document.querySelector('.header');
    if (header) {
      panel.style.top = header.offsetHeight + 'px';
    }
  }

  function switchTab(tabName) {
    tabs.forEach(function(t) { t.classList.toggle('active', t.dataset.pane === tabName); });
    panes.forEach(function(p) { p.classList.toggle('active', p.id === 'pane-' + tabName); });
  }

  function openPanel(tabName) {
    setPanelTop();
    switchTab(tabName);
    panel.classList.add('is-open');
    overlay.classList.add('is-visible');
    panel.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closePanel() {
    panel.classList.remove('is-open');
    overlay.classList.remove('is-visible');
    panel.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    ctaBtns.forEach(function(b) { b.setAttribute('aria-expanded', 'false'); });
  }



  
  setPanelTop();
  window.addEventListener('resize', setPanelTop);

  ctaBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var tab    = btn.dataset.tab;
      var isOpen = btn.getAttribute('aria-expanded') === 'true';
      ctaBtns.forEach(function(b) { b.setAttribute('aria-expanded', 'false'); });
      if (isOpen) { closePanel(); }
      else { btn.setAttribute('aria-expanded', 'true'); openPanel(tab); }
    });
  });

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() { switchTab(tab.dataset.pane); });
  });

  closeBtn.addEventListener('click', closePanel);
  xClose.addEventListener('click', closePanel);
  overlay.addEventListener('click', closePanel);
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closePanel(); });

})();
</script>



