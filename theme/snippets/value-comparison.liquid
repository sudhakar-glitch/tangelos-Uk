<div id="tabp-qc_table" class="vc-wrap collapse tab-content show">
    <div class="vc-label">The Value Comparison</div>

                    <div class="py-3">
                          {% for variant in product.variants %}
                        <div class="quick_compare" 
                  data-variant-id="{{ variant.id }}"
                  {% if variant.id != product.selected_or_first_available_variant.id %}style="display:none"{% endif %}>
                        <div class="rte__table-wrapper mt-4">
                {%- liquid
assign qc = variant.metafields.custom.quick_compare.value
if product.title contains 'Duvet Set' and qc contains 'Price</td><td>'
assign new_price = variant.price | money_without_trailing_zeros
assign p_parts = qc | split: 'Price</td><td>'
assign p_cells = p_parts[1] | split: '</td>'
assign old_seg = 'Price</td><td>' | append: p_cells[0] | append: '</td>'
assign new_seg = 'Price</td><td>' | append: new_price | append: '</td>'
assign qc = qc | replace_first: old_seg, new_seg
if qc contains 'Your Savings</td>'
assign s_parts = qc | split: 'Your Savings</td>'
assign s_cells = s_parts[1] | split: '</td>'
assign old_s = 'Your Savings</td>' | append: s_cells[0] | append: '</td>' | append: s_cells[1] | append: '</td>' | append: s_cells[2] | append: '</td>'
assign c1 = p_cells[1] | remove: '<td>' | strip | slice: 1, 20 | remove: ',' | strip | times: 100
assign c2 = p_cells[2] | remove: '<td>' | strip | slice: 1, 20 | remove: ',' | strip | times: 100
assign new_s = 'Your Savings</td>' | append: s_cells[0] | append: '</td>'
if c1 > 0
assign r1 = variant.price | times: 100.0 | divided_by: c1 | round
assign r1 = 100 | minus: r1
assign new_s = new_s | append: '<td>' | append: r1 | append: '%</td>'
else
assign new_s = new_s | append: s_cells[1] | append: '</td>'
endif
if c2 > 0
assign r2 = variant.price | times: 100.0 | divided_by: c2 | round
assign r2 = 100 | minus: r2
assign new_s = new_s | append: '<td>' | append: r2 | append: '%</td>'
else
assign new_s = new_s | append: s_cells[2] | append: '</td>'
endif
assign qc = qc | replace_first: old_s, new_s
endif
endif
-%}{{ qc }}
                </div>
              </div>
            {% endfor %}       
            </div>
                </div>

<style>

.quick_compare table {
