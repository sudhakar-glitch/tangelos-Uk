    display: revert !important;
}
body .quick_compare table tr th {
    padding: 15px;
}
div#tabp-qc_table .nearly-price-table {
    display: none;
}

body .quick_compare table tr td img {
    width: 18PX;
    height: 18PX;
    font-size: 25px;
}
body .quick_compare table tr td{
padding: 15px;
}
body .quick_compare table tr td:first-child {
    text-align: start;
}

body .quick_compare table tr th {
    text-transform: lowercase;

}
body .quick_compare table tr td {
}
body .quick_compare table tr:last-child {
    border-bottom: unset;
}
body  table tr th {
          background: unset;
        border: unset !important;
}
body  table tr td {
          background: unset;
        border: unset !important;
}
body  .quick_compare table tr {
    border: unset;
}
body   .quick_compare table tr {
    border: unset;
    border-bottom: 1px solid #ccc;
}
body  .quick_compare table tr td:first-child {
    text-align: start;
}
body  .quick_compare table tr td:nth-child(2) {
    background: #cccccc5c;
}
body  .quick_compare table tr th:nth-child(2) {
    background: #cccccc5c;
}
body  .quick_compare table tr th {
    text-transform: lowercase;
}

body  .quick_compare table tr:last-child {
    border-bottom: unset;
}
.vc-wrap { margin-top: 40px; font-family: inherit; width: 100%; }
.vc-label { font-size: 10px; letter-spacing: 0.25em; color: #aaa; margin-bottom: 36px; text-transform: uppercase; text-align:center  }
.vc-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
.vc-table col.col-feature { width: 32%; }
.vc-table col.col-tangelos { width: 24%; }
.vc-table col.col-tekla { width: 22%; }
.vc-table col.col-frette { width: 22%; }
.vc-table th { font-size: 10px; letter-spacing: 0.2em; font-weight: 500; text-transform: uppercase; color: #bbb; padding: 15px 15px; text-align: left; }
.vc-table th.highlight { color: #1a1a1a; background: #ede9e2; padding: 15px 15px; border-radius: 4px 4px 0 0; }
.vc-table th:first-child { color: #1a1a1a; }
.vc-table td:first-child { color: #1a1a1a; }
.vc-table td { font-size: 10px; letter-spacing: 0.12em; color: #666; text-transform: uppercase; padding: 15px 15px; border-bottom: 1px solid #eae7e2; vertical-align: middle; }
