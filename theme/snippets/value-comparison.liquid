.vc-table tbody tr:last-child td { border-bottom: none; }
.vc-table tbody tr:last-child td.highlight { border-radius: 0 0 4px 4px; border-bottom: none; }
.check { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border: 1.5px solid #1a1a1a; border-radius: 50%; position: relative; }
.check::after { content: ''; position: absolute; left: 5px; top: 2.5px; width: 3px; height: 7px; border-right: 1.5px solid #1a1a1a; border-bottom: 1.5px solid #1a1a1a; transform: rotate(45deg); }
.check-gray { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border: 1.5px solid #bbb; border-radius: 50%; position: relative; }
.check-gray::after { content: ''; position: absolute; left: 4px; top: 2px; width: 4px; height: 7px; border-right: 1.5px solid #bbb; border-bottom: 1.5px solid #bbb; transform: rotate(45deg); }
.cross { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border: 1.5px solid #ccc; border-radius: 50%; font-size: 10px; color: #bbb; }
.vc-footnote { font-style: italic; font-size: 12.5px; color: #bbb; margin-top: 24px; text-align: center; }
</style>