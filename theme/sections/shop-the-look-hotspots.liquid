{%- comment -%}
  Tangelos · Shop the look (hotspots)
  Full-width image, centred heading/text/button, and "+" hotspots that open a
  product card. Add one "Hotspot" block per product and set its position (%).
  Put this file in  sections/shop-the-look-hotspots.liquid
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign img = section.settings.image
  assign img_m = section.settings.image_mobile | default: img
  assign focal = '50% 50%'
  if img.presentation.focal_point
    assign focal = img.presentation.focal_point
  endif
  assign focal_m = '50% 50%'
  if img_m.presentation.focal_point
    assign focal_m = img_m.presentation.focal_point
  endif
-%}

<section
  class="tg-stl tg-stl--{{ section.settings.content_align }}"
  id="tg-stl-{{ sid }}"
  data-tg-stl
  data-open-first="{{ section.settings.open_first }}"
  style="--stl-h: {{ section.settings.height }}px; --stl-h-m: {{ section.settings.height_mobile }}px; --stl-ov: {{ section.settings.overlay | divided_by: 100.0 }}; --stl-text: {{ section.settings.text_color }};"
>
  <div class="tg-stl__media">
    {%- if img != blank -%}
      {{ img | image_url: width: 3000 | image_tag:
        class: 'tg-stl__img tg-stl__img--desk',
        widths: '750, 1100, 1500, 2000, 2600, 3000',
        sizes: '100vw',
        loading: 'lazy',
        alt: img.alt | default: section.settings.heading }}
      {{ img_m | image_url: width: 1500 | image_tag:
        class: 'tg-stl__img tg-stl__img--mob',
        widths: '500, 750, 1000, 1500',
        sizes: '100vw',
        loading: 'lazy',
        alt: img_m.alt | default: section.settings.heading }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'tg-stl__img tg-stl__placeholder' }}
    {%- endif -%}
    <div class="tg-stl__overlay" aria-hidden="true"></div>
  </div>

  <div class="tg-stl__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="tg-stl__heading">{{ section.settings.heading | newline_to_br }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="tg-stl__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="tg-stl__btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>

  {%- for block in section.blocks -%}
    {%- liquid
      assign p = block.settings.product
      assign bx = block.settings.x
      assign by = block.settings.y
      assign bxm = block.settings.x_mobile | default: bx
      assign bym = block.settings.y_mobile | default: by

      assign place = block.settings.placement
      if place == 'auto'
        if bx > 60
          assign side = 'left'
        else
          assign side = 'right'
        endif
        if by < 35
          assign vert = 'below'
        else
          assign vert = 'above'
        endif
        assign place = vert | append: '-' | append: side
      endif
    -%}
    <div class="tg-stl__spot" {{ block.shopify_attributes }} data-tg-stl-spot="{{ block.id }}"
      style="--x: {{ bx }}%; --y: {{ by }}%; --xm: {{ bxm }}%; --ym: {{ bym }}%;">
      <button
        type="button"
        class="tg-stl__dot"
        aria-expanded="false"
        aria-controls="tg-stl-card-{{ block.id }}"
        aria-label="{% if p != blank %}Show {{ p.title | escape }}{% else %}Show product{% endif %}"
        data-tg-stl-dot
      >
        <span class="tg-stl__plus" aria-hidden="true"></span>
      </button>
    </div>

    <div class="tg-stl__card tg-stl__card--{{ place }}" id="tg-stl-card-{{ block.id }}" data-tg-stl-card="{{ block.id }}"
      style="--x: {{ bx }}%; --y: {{ by }}%;" hidden>
      {%- if p != blank -%}
        <a class="tg-stl__card-link" href="{{ p.url }}">
          {%- if p.featured_image -%}
            {{ p.featured_image | image_url: width: 240 | image_tag:
              class: 'tg-stl__card-img', loading: 'lazy', width: 80, height: 80, alt: p.title }}
          {%- endif -%}
          <span class="tg-stl__card-info">
            <span class="tg-stl__card-title">{{ block.settings.title_override | default: p.title }}</span>
            <span class="tg-stl__card-price">
              {%- if p.price_varies -%}
                {{ p.price_min | money_without_trailing_zeros }} – {{ p.price_max | money_without_trailing_zeros }}
              {%- else -%}
                {{ p.price | money_without_trailing_zeros }}
              {%- endif -%}
            </span>
            <span class="tg-stl__card-cta">{{ section.settings.card_cta }}</span>
          </span>
        </a>
      {%- else -%}
        <span class="tg-stl__card-info tg-stl__card-info--empty">
          <span class="tg-stl__card-title">Choose a product</span>
          <span class="tg-stl__card-price">Select one in this hotspot's settings.</span>
        </span>
      {%- endif -%}
      <button type="button" class="tg-stl__card-x" aria-label="Close" data-tg-stl-close>&times;</button>
    </div>
  {%- endfor -%}
</section>

<style>
  #tg-stl-{{ sid }} {
    position: relative;
    width: 100%;
    height: var(--stl-h);
    overflow: hidden;
    color: var(--stl-text);
    isolation: isolate;
  }
  #tg-stl-{{ sid }} .tg-stl__media { position: absolute; inset: 0; z-index: 0; }
  #tg-stl-{{ sid }} .tg-stl__img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  #tg-stl-{{ sid }} .tg-stl__img--desk { object-position: {{ focal }}; }
  #tg-stl-{{ sid }} .tg-stl__img--mob { object-position: {{ focal_m }}; display: none; }
  #tg-stl-{{ sid }} .tg-stl__placeholder { background: #d8d1c6; fill: #b9b0a3; }
  #tg-stl-{{ sid }} .tg-stl__overlay {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at center, rgba(0,0,0,calc(var(--stl-ov) * 1.4)) 0%, rgba(0,0,0,var(--stl-ov)) 55%, rgba(0,0,0,calc(var(--stl-ov) * 0.6)) 100%);
  }

  /* Content */
  #tg-stl-{{ sid }} .tg-stl__content {
    position: absolute; inset: 0; z-index: 1;
    display: flex; flex-direction: column; justify-content: center;
    padding: 40px 8%;
    pointer-events: none;
  }
  #tg-stl-{{ sid }}.tg-stl--center .tg-stl__content { align-items: center; text-align: center; }
  #tg-stl-{{ sid }}.tg-stl--left .tg-stl__content { align-items: flex-start; text-align: left; }
  #tg-stl-{{ sid }}.tg-stl--right .tg-stl__content { align-items: flex-end; text-align: right; }
  #tg-stl-{{ sid }} .tg-stl__heading {
    margin: 0 0 18px;
    font-family: {{ section.settings.heading_font }}, Georgia, 'Times New Roman', serif;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: inherit;
    text-shadow: 0 1px 18px rgba(0,0,0,0.25);
  }
  #tg-stl-{{ sid }} .tg-stl__text {
    margin: 0 0 30px; max-width: 560px;
    font-size: 17px; line-height: 1.5; color: inherit;
    text-shadow: 0 1px 12px rgba(0,0,0,0.3);
  }
  #tg-stl-{{ sid }} .tg-stl__btn {
    pointer-events: auto;
    display: inline-block;
    padding: 15px 22px;
    background: #fff; color: #1a1a1a;
    font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    text-decoration: none;
    transition: background-color .2s ease, color .2s ease;
  }
  #tg-stl-{{ sid }} .tg-stl__btn:hover { background: #1a1a1a; color: #fff; }

  /* Hotspots */
  #tg-stl-{{ sid }} .tg-stl__spot {
    position: absolute; z-index: 2;
    left: var(--x); top: var(--y);
    width: 0; height: 0;
  }
  #tg-stl-{{ sid }} .tg-stl__dot {
    position: absolute; left: 0; top: 0;
    width: 32px; height: 32px; padding: 0;
    transform: translate(-50%, -50%);
    border: 0; border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 6px rgba(255,255,255,0.35), 0 2px 8px rgba(0,0,0,0.25);
    cursor: pointer;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  #tg-stl-{{ sid }} .tg-stl__dot::after {
    content: ""; position: absolute; inset: -6px; border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.7);
    animation: tg-stl-pulse 2.4s ease-out infinite;
  }
  #tg-stl-{{ sid }} .tg-stl__dot:hover,
  #tg-stl-{{ sid }} .tg-stl__dot[aria-expanded="true"] {
    transform: translate(-50%, -50%) scale(1.08);
    box-shadow: 0 0 0 8px rgba(255,255,255,0.45), 0 2px 10px rgba(0,0,0,0.3);
  }
  #tg-stl-{{ sid }} .tg-stl__dot:focus-visible { outline: 2px solid #fff; outline-offset: 6px; }
  #tg-stl-{{ sid }} .tg-stl__plus,
  #tg-stl-{{ sid }} .tg-stl__plus::before {
    position: absolute; left: 50%; top: 50%;
    width: 12px; height: 1.5px; background: #1a1a1a;
    transform: translate(-50%, -50%);
    transition: transform .2s ease;
  }
  #tg-stl-{{ sid }} .tg-stl__plus::before { content: ""; transform: translate(-50%, -50%) rotate(90deg); }
  #tg-stl-{{ sid }} .tg-stl__dot[aria-expanded="true"] .tg-stl__plus { transform: translate(-50%, -50%) rotate(45deg); }

  /* Product card */
  #tg-stl-{{ sid }} .tg-stl__card {
    position: absolute; z-index: 3;
    left: var(--x); top: var(--y);
    width: 312px; max-width: calc(100% - 24px);
    padding: 16px 40px 16px 16px;
    background: #fff; color: #1a1a1a;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.18);
    animation: tg-stl-in .18s ease;
  }
  #tg-stl-{{ sid }} .tg-stl__card[hidden] { display: none; }
  #tg-stl-{{ sid }} .tg-stl__card--above-right { transform: translate(-28px, calc(-100% - 30px)); }
  #tg-stl-{{ sid }} .tg-stl__card--above-left  { transform: translate(calc(-100% + 28px), calc(-100% - 30px)); }
  #tg-stl-{{ sid }} .tg-stl__card--below-right { transform: translate(-28px, 30px); }
  #tg-stl-{{ sid }} .tg-stl__card--below-left  { transform: translate(calc(-100% + 28px), 30px); }

  #tg-stl-{{ sid }} .tg-stl__card-link {
    display: flex; align-items: center; gap: 14px;
    color: inherit; text-decoration: none;
  }
  #tg-stl-{{ sid }} .tg-stl__card-img {
    flex: none; width: 80px; height: 80px; object-fit: cover;
    background: #f4efe6; border-radius: 4px;
  }
  #tg-stl-{{ sid }} .tg-stl__card-info { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  #tg-stl-{{ sid }} .tg-stl__card-title {
    font-size: 14px; font-weight: 600; line-height: 1.3;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
  }
  #tg-stl-{{ sid }} .tg-stl__card-price { font-size: 13px; color: #555; }
  #tg-stl-{{ sid }} .tg-stl__card-cta {
    margin-top: 6px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    text-decoration: underline; text-underline-offset: 4px;
  }
  #tg-stl-{{ sid }} .tg-stl__card-link:hover .tg-stl__card-cta { text-decoration-thickness: 2px; }
  #tg-stl-{{ sid }} .tg-stl__card-x {
    position: absolute; top: 6px; right: 8px;
    width: 28px; height: 28px; padding: 0;
    border: 0; background: none; color: #999;
    font-size: 20px; line-height: 28px; cursor: pointer;
  }
  #tg-stl-{{ sid }} .tg-stl__card-x:hover { color: #1a1a1a; }

  @keyframes tg-stl-pulse { 0% { transform: scale(1); opacity: .9; } 100% { transform: scale(1.7); opacity: 0; } }
  @keyframes tg-stl-in { from { opacity: 0; } to { opacity: 1; } }

  /* Mobile */
  @media screen and (max-width: 749px) {
    #tg-stl-{{ sid }} { height: var(--stl-h-m); }
    #tg-stl-{{ sid }} .tg-stl__img--desk { display: {% if section.settings.image_mobile != blank %}none{% else %}block{% endif %}; }
    #tg-stl-{{ sid }} .tg-stl__img--mob { display: {% if section.settings.image_mobile != blank %}block{% else %}none{% endif %}; }
    #tg-stl-{{ sid }} .tg-stl__content { justify-content: flex-start; padding: 44px 20px; }
    #tg-stl-{{ sid }} .tg-stl__heading { font-size: {{ section.settings.heading_size | times: 0.62 | round }}px; }
    #tg-stl-{{ sid }} .tg-stl__text { font-size: 15px; margin-bottom: 22px; }
    #tg-stl-{{ sid }} .tg-stl__spot { left: var(--xm); top: var(--ym); }
    #tg-stl-{{ sid }} .tg-stl__dot { width: 28px; height: 28px; }
    /* Card sits at the bottom of the image on phones */
    #tg-stl-{{ sid }} .tg-stl__card {
      left: 12px; right: 12px; top: auto; bottom: 12px;
      width: auto; max-width: none;
      transform: none !important;
    }
    #tg-stl-{{ sid }} .tg-stl__card-img { width: 64px; height: 64px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #tg-stl-{{ sid }} .tg-stl__dot::after { animation: none; }
    #tg-stl-{{ sid }} .tg-stl__card { animation: none; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('tg-stl-{{ sid }}');
    if (!root || root.__tgStl) return;
    root.__tgStl = true;

    function cardFor(id) { return root.querySelector('[data-tg-stl-card="' + id + '"]'); }
    function dotFor(id) {
      var spot = root.querySelector('[data-tg-stl-spot="' + id + '"]');
      return spot && spot.querySelector('[data-tg-stl-dot]');
    }

    function closeAll(except) {
      root.querySelectorAll('[data-tg-stl-card]').forEach(function (c) {
        var id = c.getAttribute('data-tg-stl-card');
        if (id === except) return;
        c.hidden = true;
        var d = dotFor(id);
        if (d) d.setAttribute('aria-expanded', 'false');
      });
    }

    function open(id) {
      closeAll(id);
      var c = cardFor(id), d = dotFor(id);
      if (!c) return;
      c.hidden = false;
      if (d) d.setAttribute('aria-expanded', 'true');
    }

    function toggle(id) {
      var c = cardFor(id);
      if (c && !c.hidden) closeAll(); else open(id);
    }

    root.addEventListener('click', function (e) {
      var dot = e.target.closest('[data-tg-stl-dot]');
      if (dot) {
        var id = dot.closest('[data-tg-stl-spot]').getAttribute('data-tg-stl-spot');
        toggle(id);
        return;
      }
      if (e.target.closest('[data-tg-stl-close]')) {
        var card = e.target.closest('[data-tg-stl-card]');
        var did = card && card.getAttribute('data-tg-stl-card');
        closeAll();
        var back = did && dotFor(did);
        if (back) back.focus();
      }
    });

    // Click anywhere else on the page closes the card
    document.addEventListener('click', function (e) {
      if (!root.contains(e.target) || (!e.target.closest('[data-tg-stl-card]') && !e.target.closest('[data-tg-stl-dot]'))) {
        if (!e.target.closest('.tg-stl__btn')) closeAll();
      }
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });

    // First product card open on load (like the reference design)
    if (root.getAttribute('data-open-first') === 'true') {
      var first = root.querySelector('[data-tg-stl-spot]');
      if (first) open(first.getAttribute('data-tg-stl-spot'));
    }

    // Theme editor: selecting a hotspot block opens its card
    document.addEventListener('shopify:block:select', function (e) {
      if (e.detail && e.detail.sectionId === '{{ sid }}') open(e.detail.blockId);
    });
  })();
</script>

{% schema %}
{
  "name": "Shop the look",
  "tag": "div",
  "class": "tg-stl-section",
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Landscape, at least 2400px wide. Set the focal point so the bed stays in view." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },
    { "type": "range", "id": "height", "label": "Height (desktop)", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "height_mobile", "label": "Height (mobile)", "min": 360, "max": 800, "step": 20, "unit": "px", "default": 600 },
    { "type": "range", "id": "overlay", "label": "Darken image", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 25 },

    { "type": "header", "content": "Text" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Make your bed\nhotel-worthy" },
    { "type": "text", "id": "text", "label": "Text", "default": "Layered organic muslin, for comfort that says “do not disturb.”" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the look" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "content_align", "label": "Text position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#ffffff" },
    { "type": "text", "id": "heading_font", "label": "Heading font", "default": "Cormorant Garamond", "info": "Uses the theme's serif if this font isn't loaded." },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 80, "step": 2, "unit": "px", "default": 52 },

    { "type": "header", "content": "Product cards" },
    { "type": "text", "id": "card_cta", "label": "Card link text", "default": "Shop now" },
    { "type": "checkbox", "id": "open_first", "label": "Show the first product card when the page loads", "default": true }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title_override", "label": "Card title (optional)", "info": "Leave empty to use the product title." },
        { "type": "range", "id": "x", "label": "Left to right", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y", "label": "Top to bottom", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "select", "id": "placement", "label": "Card position",
          "options": [
            { "value": "auto", "label": "Automatic" },
            { "value": "above-right", "label": "Above, to the right" },
            { "value": "above-left", "label": "Above, to the left" },
            { "value": "below-right", "label": "Below, to the right" },
            { "value": "below-left", "label": "Below, to the left" }
          ],
          "default": "auto" },
        { "type": "header", "content": "Position on mobile" },
        { "type": "range", "id": "x_mobile", "label": "Left to right", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y_mobile", "label": "Top to bottom", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 60, "info": "Keep above about 70% so the product card (bottom of the image on phones) doesn't cover it." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop the look",
      "blocks": [
        { "type": "hotspot", "settings": { "x": 12, "y": 52, "x_mobile": 18, "y_mobile": 58 } },
        { "type": "hotspot", "settings": { "x": 39, "y": 77, "x_mobile": 48, "y_mobile": 68 } },
        { "type": "hotspot", "settings": { "x": 63, "y": 61, "x_mobile": 80, "y_mobile": 60 } }
      ]
    }
  ]
}
{% endschema %}
