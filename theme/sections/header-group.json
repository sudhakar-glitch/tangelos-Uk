      "settings": {
        "custom_liquid": "{% comment %}\n  ============================================================================\n  Tangelos — header announcement bar (<marquee> version)\n  ============================================================================\n  Uses <marquee> as requested. Notes for whoever edits this next:\n\n  - <marquee> is non-standard and removed from the HTML spec. Every current\n    browser still renders it, so this works today, but it is not guaranteed.\n  - It has no CSS pause, so hover/blur pausing is done with the element's\n    own stop()/start() methods, and the reduced-motion fallback needs JS.\n  - scrollamount is pixels-per-frame, not a duration. Higher = faster.\n  ============================================================================\n{% endcomment %}\n\n<div class=\"announcement-bar\" role=\"region\" aria-label=\"Store announcements\">\n  <marquee\n    class=\"announcement-marquee\"\n    behavior=\"scroll\"\n    direction=\"left\"\n    scrollamount=\"4\"\n    scrolldelay=\"0\"\n    onmouseover=\"this.stop()\"\n    onmouseout=\"this.start()\">\n\n    <span class=\"announcement-item\">\n      365-Day Returns & Free UK Delivery\n    </span>\n\n    <span class=\"announcement-item announcement-rating\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0647/5930/0256/files/Trustpilot_Logo_1.png?v=1787729803&amp;width=200\"\n        alt=\"Trustpilot\"\n        width=\"88\" height=\"22\"\n        class=\"announcement-logo\">\n      <strong>4.5 / 5</strong>\n    </span>\n\n  </marquee>\n</div>\n\n<style>\n  .announcement-bar {\n    color: #ffffff;\n    /* Fixed height stops the bar resizing as fonts load, which otherwise\n       shoves the page down and hurts Core Web Vitals. */\n    height: 38px;\n    display: flex;\n    align-items: center;\n    overflow: hidden;\n  }\n\n  .announcement-marquee {\n    width: 100%;\n    /* marquee is inline by default; this keeps it vertically centred\n       inside the fixed-height bar. */\n    display: block;\n    line-height: 38px;\n  }\n\n  .announcement-item {\n    display: inline-flex;\n    align-items: center;\n    vertical-align: middle;\n    font-size: 13px;\n    letter-spacing: 0.4px;\n    padding: 0 22px;\n  }\n\n  .announcement-rating strong {\n    font-weight: 700;\n    margin-left: 2px;\nmargin-top: 7px;\n  }\n\n  /* Fixed px, not a percentage. A percentage resolves against the scrolling\n     container, so the logo changed size on every screen. */\n  .announcement-logo {\n    width: 88px;\n    height: 22px;\n    margin-right: 8px;\n    display: block;\n  }\n\n  @media screen and (max-width: 640px) {\n    .announcement-item { font-size: 12px; padding: 0 14px; }\n    .announcement-logo { width: 76px; height: 19px; }\n  }\n</style>\n\n<script>\n  /* prefers-reduced-motion can't be honoured in CSS here, since marquee\n     scrolling isn't a CSS animation. Stop it on load instead, and keep\n     listening in case the OS setting changes mid-session. */\n  (function () {\n    var el = document.querySelector('.announcement-marquee');\n    if (!el || typeof el.stop !== 'function') return;\n\n    var mq = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n    function apply() {\n      if (mq.matches) {\n        el.stop();\n        el.setAttribute('scrollamount', '0');\n      } else {\n        el.setAttribute('scrollamount', '4');\n        el.start();\n      }\n    }\n\n    apply();\n    if (mq.addEventListener) mq.addEventListener('change', apply);\n    else if (mq.addListener) mq.addListener(apply);\n  })();\n</script>",
