    {
      "type": "range",
      "id": "mob_peek_width",
      "label": "Slide Width (vw)",
      "info": "How wide each card is. Lower = more cards peek in from side.",
      "min": 50, "max": 95, "step": 5, "default": 75
    },
    {
      "type": "range",
      "id": "mob_slide_gap",
      "label": "Gap Between Slides (px)",
      "min": 4, "max": 24, "step": 2, "default": 12
    },
    {
      "type": "checkbox",
      "id": "mob_show_dots",
      "label": "Show Dot Indicators",
      "default": true
    },
    {
      "type": "range",
      "id": "mob_dot_size",
      "label": "Dot Size (px)",
      "min": 4, "max": 12, "step": 1, "default": 6
    },
    {
      "type": "color",
      "id": "mob_dot_color",
      "label": "Active Dot Color",
      "default": "#1a1a18"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "limit": 20,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Image",
          "info": "Upload a photo from your Instagram post."
        },
        {
          "type": "select",
          "id": "post_type",
          "label": "Post Type",
