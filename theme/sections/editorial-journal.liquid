{%- liquid
  assign section_id = 'editorial-' | append: section.id
-%}

<section id="{{ section_id }}" class="editorial-section">

  <div class="editorial-header">
    {%- if section.settings.heading != blank -%}
      <h2 class="editorial-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="editorial-subheading">{{ section.settings.subheading | escape | upcase }}</p>
    {%- endif -%}
  </div>

  {%- comment -%} ── DESKTOP & TABLET GRID ── {%- endcomment -%}
  <div class="editorial-grid">
    {%- if section.settings.source == 'blog' and section.settings.blog != blank -%}
      {%- assign blog_handle = section.settings.blog -%}
      {%- assign articles = blogs[blog_handle].articles -%}
      {%- assign limit = section.settings.posts_limit -%}
      {%- for article in articles limit: limit -%}
        <article class="editorial-card">
          <a class="editorial-card-image-link" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
            <div class="editorial-card-image-wrap">
              {%- if article.image -%}
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.image.alt | escape | default: article.title | escape }}"
                  width="800"
                  height="{{ 800 | divided_by: article.image.aspect_ratio | round }}"
                  loading="lazy"
                  decoding="async">
              {%- else -%}
                <div class="editorial-card-image-placeholder"></div>
              {%- endif -%}
            </div>
          </a>
          <div class="editorial-card-body">
            {%- if article.tags.size > 0 -%}
              <p class="editorial-card-tag">{{ article.tags | first | upcase }}</p>
            {%- endif -%}
            <h3 class="editorial-card-title">
              <a href="{{ article.url }}">{{ article.title | escape }}</a>
            </h3>
            <a class="editorial-card-link" href="{{ article.url }}">
              {{ section.settings.cta_label | default: 'READ MORE' | upcase }}
            </a>
          </div>
        </article>
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <article class="editorial-card" {{ block.shopify_attributes }}>
            <a class="editorial-card-image-link" href="{{ block.settings.link }}" tabindex="-1" aria-hidden="true">
              <div class="editorial-card-image-wrap">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.image.alt | escape | default: block.settings.title | escape }}"
                    width="800"
                    height="{{ 800 | divided_by: block.settings.image.aspect_ratio | round }}"
                    {%- if forloop.first -%}loading="eager" fetchpriority="high"{%- else -%}loading="lazy"{%- endif -%}
                    decoding="async">
                {%- else -%}
                  <div class="editorial-card-image-placeholder"></div>
                {%- endif -%}
              </div>
            </a>
            <div class="editorial-card-body">
              {%- if block.settings.tag != blank -%}
                <p class="editorial-card-tag">{{ block.settings.tag | escape | upcase }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="editorial-card-title">
                  <a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>
                </h3>
              {%- endif -%}
              {%- if block.settings.cta_label != blank -%}
                <a class="editorial-card-link" href="{{ block.settings.link }}">
                  {{ block.settings.cta_label | escape | upcase }}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- comment -%} ── MOBILE SLIDER ── {%- endcomment -%}
  <div class="editorial-mob-slider" data-ed-slider="{{ section.id }}">
    <div class="editorial-mob-track" data-ed-track>

      {%- if section.settings.source == 'blog' and section.settings.blog != blank -%}
        {%- assign blog_handle = section.settings.blog -%}
        {%- assign articles = blogs[blog_handle].articles -%}
        {%- assign limit = section.settings.posts_limit -%}
        {%- for article in articles limit: limit -%}
          <article class="editorial-mob-slide" data-ed-slide>
            <a class="editorial-card-image-link" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              <div class="editorial-card-image-wrap">
                {%- if article.image -%}
                  <img
                    src="{{ article.image | image_url: width: 800 }}"
                    alt="{{ article.image.alt | escape | default: article.title | escape }}"
                    width="800"
                    height="{{ 800 | divided_by: article.image.aspect_ratio | round }}"
                    loading="lazy"
                    decoding="async">
                {%- else -%}
                  <div class="editorial-card-image-placeholder"></div>
                {%- endif -%}
              </div>
            </a>
            <div class="editorial-card-body">
              {%- if article.tags.size > 0 -%}
                <p class="editorial-card-tag">{{ article.tags | first | upcase }}</p>
              {%- endif -%}
              <h3 class="editorial-card-title">
                <a href="{{ article.url }}">{{ article.title | escape }}</a>
              </h3>
              <a class="editorial-card-link" href="{{ article.url }}">
                {{ section.settings.cta_label | default: 'READ MORE' | upcase }}
              </a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <article class="editorial-mob-slide" data-ed-slide {{ block.shopify_attributes }}>
              <a class="editorial-card-image-link" href="{{ block.settings.link }}" tabindex="-1" aria-hidden="true">
                <div class="editorial-card-image-wrap">
                  {%- if block.settings.image != blank -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 800 }}"
                      alt="{{ block.settings.image.alt | escape | default: block.settings.title | escape }}"
                      width="800"
                      height="auto"
                      loading="lazy"
                      decoding="async">
                  {%- else -%}
                    <div class="editorial-card-image-placeholder"></div>
                  {%- endif -%}
                </div>
              </a>
              <div class="editorial-card-body">
                {%- if block.settings.tag != blank -%}
                  <p class="editorial-card-tag">{{ block.settings.tag | escape | upcase }}</p>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="editorial-card-title">
                    <a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>
                  </h3>
                {%- endif -%}
                {%- if block.settings.cta_label != blank -%}
                  <a class="editorial-card-link" href="{{ block.settings.link }}">
                    {{ block.settings.cta_label | escape | upcase }}
                  </a>
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

    </div>

    {%- comment -%} Dots {%- endcomment -%}
    <div class="editorial-mob-dots" data-ed-dots>
      {%- if section.settings.source == 'blog' and section.settings.blog != blank -%}
        {%- for article in blogs[section.settings.blog].articles limit: section.settings.posts_limit -%}
          <button
            class="editorial-mob-dot{% if forloop.first %} is-active{% endif %}"
            data-ed-dot="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}">
          </button>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <button
              class="editorial-mob-dot{% if forloop.first %} is-active{% endif %}"
              data-ed-dot="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}">
            </button>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

</section>

<style>
  #{{ section_id }} {
    --ed-bg:           {{ section.settings.bg_color }};
    --ed-heading-color:{{ section.settings.heading_color }};
    --ed-sub-color:    {{ section.settings.subheading_color }};
    --ed-tag-color:    {{ section.settings.tag_color }};
    --ed-title-color:  {{ section.settings.title_color }};
    --ed-link-color:   {{ section.settings.link_color }};
    --ed-dot-color:    {{ section.settings.dot_color }};
    --ed-img-radius:   {{ section.settings.image_radius }}px;
    --ed-heading-size: {{ section.settings.heading_size }}px;
    --ed-title-size:   {{ section.settings.card_title_size }}px;
    --ed-section-pad:  {{ section.settings.section_padding }}px;
    --ed-gap:          {{ section.settings.card_gap }}px;
    --ed-cols-desktop: {{ section.settings.cols_desktop }};
    --ed-cols-tablet:  {{ section.settings.cols_tablet }};
    --ed-img-ratio:    {{ section.settings.image_ratio }};

    background-color: var(--ed-bg);
    padding: var(--ed-section-pad) {{ section.settings.section_padding_h }}px;
    box-sizing: border-box;
  }

  #{{ section_id }} .editorial-header {
    margin-bottom: 40px;
  }

  #{{ section_id }} .editorial-heading {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--ed-heading-size);
    font-weight: 400;
    color: var(--ed-heading-color);
    letter-spacing: -0.01em;
    margin: 0 0 10px;
    line-height: 1.15;
  }

  #{{ section_id }} .editorial-subheading {
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--ed-sub-color);
    margin: 0;
    font-weight: 400;
  }

  /* ── DESKTOP/TABLET GRID ── */
  #{{ section_id }} .editorial-mob-slider { display: none; }

  #{{ section_id }} .editorial-grid {
    display: grid;
    grid-template-columns: repeat(var(--ed-cols-desktop), 1fr);
    gap: var(--ed-gap);
  }

  #{{ section_id }} .editorial-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #{{ section_id }} .editorial-card-image-link {
    display: block;
    overflow: hidden;
    border-radius: var(--ed-img-radius);
  }

  #{{ section_id }} .editorial-card-image-wrap {
    aspect-ratio: var(--ed-img-ratio);
    overflow: hidden;
    border-radius: var(--ed-img-radius);
    background: #d8d4cd;
  }

  #{{ section_id }} .editorial-card-image-wrap img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 0.6s ease;
  }

  #{{ section_id }} .editorial-card:hover .editorial-card-image-wrap img {
    transform: scale(1.03);
  }

  #{{ section_id }} .editorial-card-image-placeholder {
    width: 100%; height: 100%; background: #ccc8c0;
  }

  #{{ section_id }} .editorial-card-body {
    display: flex; flex-direction: column; gap: 10px;
  }

  #{{ section_id }} .editorial-card-tag {
    margin: 0; font-size: 10px; letter-spacing: 0.18em;
    color: var(--ed-tag-color); font-weight: 400;
  }

  #{{ section_id }} .editorial-card-title {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--ed-title-size);
    font-weight: 400;
    color: var(--ed-title-color);
    line-height: 1.35;
  }

  #{{ section_id }} .editorial-card-title a {
    color: inherit; text-decoration: none;
  }

  #{{ section_id }} .editorial-card-title a:hover {
    text-decoration: underline;
    text-decoration-color: rgba(0,0,0,0.3);
    text-underline-offset: 3px;
  }

  #{{ section_id }} .editorial-card-link {
    display: inline-block; font-size: 10px;
    letter-spacing: 0.15em; color: var(--ed-link-color);
    text-decoration: underline; text-underline-offset: 4px;
    font-weight: 400; transition: opacity 0.2s ease;
  }

  #{{ section_id }} .editorial-card-link:hover { opacity: 0.6; }

  @media (max-width: 1023px) {
    #{{ section_id }} .editorial-grid {
      grid-template-columns: repeat(var(--ed-cols-tablet), 1fr);
    }
  }

  /* ── MOBILE: hide grid, show slider ── */
  @media (max-width: 639px) {
    #{{ section_id }} {
      padding-left: 0;
      padding-right: 0;
    }

    #{{ section_id }} .editorial-header {
      padding-left: 20px;
      padding-right: 20px;
    }

    #{{ section_id }} .editorial-grid { display: none; }
    #{{ section_id }} .editorial-mob-slider { display: block; margin-left: 15px; }

    /* Track: horizontal scroll snap */
    #{{ section_id }} .editorial-mob-track {
      display: flex;
      overflow-x: scroll;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 16px;
      padding: 0 20px;
    }
    #{{ section_id }} .editorial-mob-track::-webkit-scrollbar { display: none; }

    /* Each slide: 80vw so you peek at next card */
    #{{ section_id }} .editorial-mob-slide {
      flex: 0 0 80vw;
      width: 80vw;
      scroll-snap-align: start;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    #{{ section_id }} .editorial-mob-slide .editorial-card-image-wrap {
      aspect-ratio: var(--ed-img-ratio);
      overflow: hidden;
      border-radius: var(--ed-img-radius);
      background: #d8d4cd;
    }

    #{{ section_id }} .editorial-mob-slide .editorial-card-image-wrap img {
      width: 100%; height: 100%; object-fit: cover; display: block;
    }

    #{{ section_id }} .editorial-mob-slide .editorial-card-image-placeholder {
      width: 100%; height: 100%; background: #ccc8c0;
    }

    #{{ section_id }} .editorial-mob-slide .editorial-card-body {
      display: flex; flex-direction: column; gap: 8px;
      padding: 0 2px;
    }

    /* Dots */
    #{{ section_id }} .editorial-mob-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-top: 20px;
      padding: 0 20px;
    }

    #{{ section_id }} .editorial-mob-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: rgba(0,0,0,0.18);
      border: none; padding: 0; cursor: pointer;
      transition: background 0.3s ease, transform 0.3s ease;
      flex-shrink: 0;
    }

    #{{ section_id }} .editorial-mob-dot.is-active {
      background: var(--ed-dot-color, #111);
      transform: scale(1.5);
    }
  }
</style>

<script>
(function() {
  /* Use section-specific ID so multiple sections on page work independently */
  var section = document.querySelector('[data-ed-slider="{{ section.id }}"]');
  if (!section) return;

  var track  = section.querySelector('[data-ed-track]');
  var slides = section.querySelectorAll('[data-ed-slide]');
  var dots   = section.querySelectorAll('[data-ed-dot]');

  if (!track || !slides.length) return;

  function setActive(idx) {
    dots.forEach(function(d, i) {
      d.classList.toggle('is-active', i === idx);
    });
  }

  /* IntersectionObserver syncs dots as user swipes */
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        var idx = Array.from(slides).indexOf(entry.target);
        if (idx > -1) setActive(idx);
      }
    });
  }, { root: track, threshold: 0.55 });

  slides.forEach(function(slide) { observer.observe(slide); });

  /* Dot click scrolls to that slide */
  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      var idx = parseInt(dot.getAttribute('data-ed-dot'), 10);
      var slide = slides[idx];
      if (!slide) return;
      track.scrollTo({
        left: slide.offsetLeft - track.offsetLeft - 20,
        behavior: 'smooth'
      });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Editorial Journal",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Notes on Rest"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size (px)",
      "min": 20, "max": 72, "step": 1, "default": 42
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Label",
      "default": "Editorial Journal"
    },
    {
      "type": "header",
      "content": "Content Source"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Content Source",
      "options": [
        { "value": "manual", "label": "Manual Cards (blocks below)" },
        { "value": "blog",   "label": "Blog Articles (auto)" }
      ],
      "default": "manual"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog (if source = Blog Articles)"
    },
    {
      "type": "range",
      "id": "posts_limit",
      "label": "Max Blog Posts to Show",
      "min": 1, "max": 12, "step": 1, "default": 3
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Blog CTA Label",
      "default": "Read More"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#f2ede6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1a1a18"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading / Label",
      "default": "#8c8880"
    },
    {
      "type": "color",
      "id": "tag_color",
      "label": "Card Tag",
      "default": "#8c8880"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Card Title",
