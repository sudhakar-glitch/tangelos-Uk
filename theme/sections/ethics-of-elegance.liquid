{%- comment -%}
  Fabric-aware section.
  Finds the block whose Fabric Name appears in the product's title,
  type, or tags (case-insensitive). Falls back to the first block.
{%- endcomment -%}

{%- assign matched_block = blank -%}
{%- assign product_title = product.title | downcase -%}
{%- assign product_type = product.type | downcase -%}
{%- assign product_tags = product.tags | join: ',' | downcase -%}

{%- for block in section.blocks -%}
  {%- assign fabric = block.settings.fabric_name | downcase | strip -%}
  {%- if fabric != blank -%}
    {%- if product_title contains fabric or product_type contains fabric or product_tags contains fabric -%}
      {%- assign matched_block = block -%}
      {%- break -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- if matched_block == blank -%}
  {%- assign matched_block = section.blocks.first -%}
{%- endif -%}

{%- if matched_block != blank -%}
<section
  class="ethics-section"
  style="
    --bg-color: {{ section.settings.background_color }};
    --text-color: {{ section.settings.text_color }};
    --heading-color: {{ section.settings.heading_color }};
    --tag-color: {{ section.settings.tag_color }};
    --img-ratio: {{ section.settings.image_ratio }};
    --content-width: {{ section.settings.content_width }}%;
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --layout-gap: {{ section.settings.layout_gap }}px;
  "
  id="ethics-{{ section.id }}"
>
  <div class="ethics-inner{% if section.settings.layout_reverse %} ethics-inner--reverse{% endif %}">

    <!-- Content Column -->
    <div class="ethics-content" {{ matched_block.shopify_attributes }}>

      {%- if section.settings.eyebrow != blank -%}
        <p class="ethics-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if matched_block.settings.heading != blank -%}
        <h2 class="ethics-heading">{{ matched_block.settings.heading }}</h2>
      {%- endif -%}

      {%- if matched_block.settings.body_1 != blank -%}
        <p class="ethics-body">{{ matched_block.settings.body_1 }}</p>
      {%- endif -%}

      {%- if matched_block.settings.body_2 != blank -%}
        <p class="ethics-body">{{ matched_block.settings.body_2 }}</p>
      {%- endif -%}

      {%- if matched_block.settings.tag != blank -%}
        <p class="ethics-tag">{{ matched_block.settings.tag }}</p>
      {%- endif -%}

      {%- if matched_block.settings.button_label != blank and matched_block.settings.button_url != blank -%}
        <a id="certssss" data-tab="certs" href="{{ matched_block.settings.button_url }}" class="ethics-btn{% if section.settings.button_style == 'outline' %} ethics-btn--outline{% endif %}">
          {{ matched_block.settings.button_label }}
        </a>
      {%- endif -%}

    </div>

    <!-- Image Column -->
    <div class="ethics-image-wrap">
 
      
{% if product.title contains 'Linen Flat Sheet' %}
<img class="flat_sheet" src="https://cdn.shopify.com/s/files/1/0647/5930/0256/files/flat_ad5d0a20-f50f-4948-b0e3-f1ac6e192dd9.png" 
