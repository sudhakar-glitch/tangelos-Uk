      {%- if matched_block.settings.image != blank -%}
        {{
          matched_block.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            class: 'ethics-image',
            alt: matched_block.settings.image.alt | default: matched_block.settings.fabric_name,
