    </div>

  </div>
</section>
{%- endif -%}

{% stylesheet %}

#certssss {
    border: unset;
    text-align: start;
    text-decoration: underline;
    font-size: 10px;
    background: unset;
    color: #000;
    padding: 0;
}
.panel-tab {
    flex: 1;
    background: none;
    border: none;
    border-bottom: 1.5px solid transparent;
    font-family: inherit;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #bbb;
    padding: 8px 4px 12px;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
}

.ethics-section {
  background-color: var(--bg-color, #d4dbc8);
  padding-top: var(--section-padding-top, 80px);
  padding-bottom: var(--section-padding-bottom, 80px);
  overflow: hidden;
}

.ethics-inner {
  display: grid;
  grid-template-columns: var(--content-width, 40%) 1fr;
  gap: var(--layout-gap, 48px);
  align-items: center;
  max-width: 100%;
}

.ethics-inner--reverse {
  grid-template-columns: 1fr var(--content-width, 40%);
  direction: rtl;
}

.ethics-inner--reverse > * {
  direction: ltr;
}

/* Content */
.ethics-content {
  padding: 40px 48px 40px 64px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.ethics-inner--reverse .ethics-content {
  padding: 40px 64px 40px 48px;
  order: 2;
}

.ethics-inner--reverse .ethics-image-wrap {
  order: 1;
}

.ethics-eyebrow {
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text-color, #4a5a3a);
  margin: 0;
  font-weight: 500;
}

.ethics-heading {
  font-size: clamp(2rem, 4vw, 3.2rem);
  font-weight: 300;
  line-height: 1.1;
  color: var(--heading-color, #1a1a1a);
  margin: 0;
  letter-spacing: -0.02em;
}

.ethics-body {
  font-size: 13px;
  line-height: 1.75;
  color: var(--text-color, #4a5a3a);
  margin: 0;
  max-width: 38ch;
}

.ethics-tag {
  font-size: 9px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--tag-color, #4a5a3a);
  margin: 0;
  margin-top: 12px;
  font-weight: 500;
}

.ethics-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  background: var(--heading-color, #1a1a1a);
  color: #fff;
  padding: 14px 28px;
  text-decoration: none;
  transition: opacity 0.2s ease;
  width: fit-content;
  margin-top: 8px;
}

.ethics-btn:hover { opacity: 0.8; }

.ethics-btn--outline {
  background: transparent;
  color: var(--heading-color, #1a1a1a);
  border: 1px solid var(--heading-color, #1a1a1a);
}

.ethics-btn--outline:hover {
  background: var(--heading-color, #1a1a1a);
  color: #fff;
  opacity: 1;
}

/* Image */
.ethics-image-wrap {
  position: relative;
  overflow: hidden;
  aspect-ratio: var(--img-ratio, 4/3);
  height: 100%;
  min-height: 400px;
}

.ethics-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.ethics-image-placeholder {
  width: 100%;
  height: 100%;
  min-height: 400px;
  background: rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ethics-placeholder-svg {
  width: 60px;
  height: 60px;
  opacity: 0.2;
}

/* Mobile */
@media (max-width: 749px) {
  .ethics-inner,
  .ethics-inner--reverse {
    grid-template-columns: 1fr;
    direction: ltr;
    gap: 0;
  }

  .ethics-inner--reverse > * {
    order: unset;
  }

  .ethics-image-wrap {
    order: -1 !important;
    min-height: 280px;
    aspect-ratio: 4/3;
    margin-top: 0;
  }

  .ethics-content,
  .ethics-inner--reverse .ethics-content {
    order: 1 !important;
    padding: 40px 24px;
  }

  .ethics-body {
    max-width: 100%;
  }

  .ethics-section {
    padding-top: 0;
  }
}
{% endstylesheet %}

<script>
document.addEventListener('DOMContentLoaded', function() {
 var panel    = document.getElementById('trustPanel');
  var overlay  = document.getElementById('trustOverlay');
  document.getElementById('certssss') &&
  document.getElementById('certssss').addEventListener('click', function(e) {
    panel.classList.add('is-open');
    overlay.classList.add('is-visible');
    panel.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  });

});
</script>



{% schema %}
{
  "name": "Ethics of Elegance",
  "tag": "div",
  "class": "ethics-section-wrapper",
  "enabled_on": {
    "templates": ["product"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "paragraph",
      "content": "The block whose Fabric Name matches the product's title, type, or tags will be shown automatically. If nothing matches, the first block is shown."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Our Philosophy"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        { "value": "filled", "label": "Filled" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "filled"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "16/9", "label": "Wide (16:9)" },
        { "value": "auto", "label": "Auto" }
      ],
      "default": "4/3"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "layout_reverse",
      "label": "Reverse Layout (Image Left)",
      "default": false
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content Column Width",
      "min": 25,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "layout_gap",
      "label": "Gap Between Columns",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#d4dbc8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body Text Color",
      "default": "#4a5a3a"
    },
    {
      "type": "color",
      "id": "tag_color",
      "label": "Tag Color",
      "default": "#4a5a3a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "fabric",
      "name": "Fabric",
      "settings": [
        {
          "type": "text",
          "id": "fabric_name",
          "label": "Fabric Name (used for matching)",
          "info": "Shown if this word appears in the product's title, type, or tags. Example: Muslin",
          "default": "Muslin"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The Ethics of Elegance"
        },
        {
          "type": "textarea",
          "id": "body_1",
          "label": "Paragraph 1",
          "default": "Luxury redefined through transparency. We invest directly in the fiber and the artisans who weave it, bypassing traditional retail overhead."
        },
        {
          "type": "textarea",
          "id": "body_2",
          "label": "Paragraph 2",
          "default": "Sourced from wind-powered farms in the Aegean, grown without synthetic pesticides. Our process is a study in restraint and architectural rigor."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag / Label",
          "default": "Radical Transparency"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fabric Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ethics of Elegance",
      "category": "Image with Text",
      "blocks": [
        { "type": "fabric", "settings": { "fabric_name": "Muslin" } },
        { "type": "fabric", "settings": { "fabric_name": "Percale" } },
        { "type": "fabric", "settings": { "fabric_name": "Sateen" } },
        { "type": "fabric", "settings": { "fabric_name": "Linen" } }
      ]
    }
  ]
}
{% endschema %}
