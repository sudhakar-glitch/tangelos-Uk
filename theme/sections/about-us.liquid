  ],
  "presets": [
    {
      "name": "About Us",
      "category": "Pages",
      "blocks": [
        { "type": "hero" },
        { "type": "why" },
        { "type": "feature_image_left" },
        { "type": "feature_image_right" },
        { "type": "divider" },
        { "type": "feature_image_left" },
        { "type": "community" }
      ]
    }
  ]
}
