<style>
*,*::before,*::after{box-sizing:border-box;}
:root{
  --color-bg:#ffffff;
  --color-bg-light:#f7f5f3;
  --color-text:#000;
  --color-text-muted:#555555;
  --spacing-section:80px;
  --container-narrow:780px;
}
.about-page{color:var(--color-text);background:var(--color-bg);}
.container{margin:0 auto;padding:0 24px;}
.container--narrow{max-width:var(--container-narrow);}
.text-center{text-align:center;}
.section-padding{padding:var(--spacing-section) 0;}
div.bar{width:1300px;margin:auto;display:block;background:#ccc;padding:1px;}
.about-hero{position:relative;width:100%;height:320px;background-size:cover;background-position:center;display:flex;align-items:center;justify-content:center;overflow:hidden;}
.about-hero__overlay{position:absolute;inset:0;background:rgba(0,0,0,0.38);}
.about-hero__content{position:relative;z-index:2;text-align:center;color:#fff;}
nav.breadcrumb.g-breadcrumb.text-left{display:none;}
.about-hero__label{font-size:18px;text-transform:lowercase;margin:0 0 10px;opacity:0.9;color:#fff;}
.about-hero__title{font-weight:400;margin:0;text-transform:uppercase;color:#fff;font-size:35px;}
.about-why{background:var(--color-bg);}
.about-why__heading{font-weight:400;margin:0 0 28px;color:#000;}
.about-why__text p{font-size:18px;line-height:1.85;color:#555555;margin:0 0 14px;}
.about-why__tagline{font-size:15px;font-weight:600;color:var(--color-text);margin-top:20px !important;}
.about-feature__grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;background:#f7f5f3;border-top-right-radius:10px;border-bottom-right-radius:10px;}
.about-feature__grid--image-left .about-feature__image-wrap{order:1;}
.about-feature__grid--image-left .about-feature__content{order:2;}
.about-feature__grid--image-right .about-feature__content{order:1;}
.about-feature__grid--image-right .about-feature__image-wrap{order:2;}
.about-feature__image-wrap{position:relative;border-radius:4px;overflow:hidden;line-height:0;}
.about-feature__image{width:100%;height:auto;object-fit:cover;display:block;border-radius:4px;}
.about-feature__image--placeholder{background:#e0dbd5;height:auto;}
.about-feature__title{font-size:clamp(20px,2.5vw,28px);font-weight:400;line-height:1.35;margin:0 0 20px;color:var(--color-text);}
.about-feature__text p{font-size:18px;line-height:1.85;color:var(--color-text-muted);margin:0 0 12px;}
.about-feature__text{padding-right:26px;}
.about-feature__badges{display:flex;align-items:center;gap:20px;margin-top:24px;}
.badge-item__img{height:56px;width:auto;object-fit:contain;}
.badge-item__placeholder{display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;text-transform:uppercase;padding:10px;text-align:center;}
.badge-item__placeholder--gots{width:56px;height:56px;background:#2e7d32;color:#fff;border-radius:50%;}
.badge-item__placeholder--oeko{background:transparent;border:2px solid #b8a000;color:#b8a000;padding:8px 12px;border-radius:4px;font-size:10px;line-height:1.4;}
.about-community{background:var(--color-bg-light);}
.about-community__heading{font-size:clamp(20px,2.8vw,28px);font-weight:400;margin:0 0 24px;color:var(--color-text);}
.about-community__text p{font-size:18px;line-height:1.85;color:var(--color-text-muted);margin:0;}
.about-community__text strong{color:var(--color-text);}
@media(max-width:860px){
  :root{--spacing-section:56px;}
  .about-feature__grid{background:#fff !important;grid-template-columns:1fr;gap:32px;}
  .about-feature__grid--image-left .about-feature__image-wrap,
  .about-feature__grid--image-left .about-feature__content,
  .about-feature__grid--image-right .about-feature__content,
  .about-feature__grid--image-right .about-feature__image-wrap{order:unset;}
  .about-hero{height:240px;}
  .about-feature__image{height:300px;}
}
@media(max-width:520px){
  .about-hero{height:200px;}
  .about-feature__grid{background:#fff !important;}
  .about-feature__image{height:auto;}
  .about-feature__grid.about-feature__grid--image-right {
    display: grid;
}
.about-feature__grid--image-right .about-feature__content {
    order: 2;
}
.about-feature__grid--image-right .about-feature__image-wrap {
    order: 1;
}
}
</style>

<div class="about-page">
  {% for block in section.blocks %}
    {% case block.type %}

    {% when 'hero' %}
    <section class="about-hero" {{ block.shopify_attributes }} style="background-image: url('{{ block.settings.hero_image | img_url: '1600x600', crop: 'center' }}');">
      <div class="about-hero__overlay"></div>
      <div class="about-hero__content">
        <p class="about-hero__label">{{ block.settings.label }}</p>
        <h1 class="about-hero__title">{{ block.settings.title }}</h1>
      </div>
    </section>

    {% when 'why' %}
    <section class="about-why section-padding" {{ block.shopify_attributes }}>
      <div class="container container--narrow text-center">
        <h2 class="about-why__heading">{{ block.settings.heading }}</h2>
        <div class="about-why__text">
          <p>{{ block.settings.text }}</p>
          <p class="about-why__tagline">{{ block.settings.tagline }}</p>
        </div>
      </div>
    </section>

    {% when 'feature_image_left' %}
    <section class="about-feature section-padding" {{ block.shopify_attributes }}>
      <div class="container">
        <div class="about-feature__grid about-feature__grid--image-left">
          <div class="about-feature__image-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '', crop: '' }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" class="about-feature__image">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'about-feature__image about-feature__image--placeholder' }}
            {% endif %}
          </div>
          <div class="about-feature__content">
            <h2 class="about-feature__title">{{ block.settings.heading }}</h2>
            <div class="about-feature__text"><p>{{ block.settings.text }}</p></div>
            {% if block.settings.show_badges %}
            <div class="about-feature__badges">
              <div class="badge-item">
                {% if block.settings.badge_1 != blank %}
                  <img src="{{ block.settings.badge_1 | img_url: '80x80' }}" alt="{{ block.settings.badge_1_alt }}" class="badge-item__img">
                {% else %}
                  <div class="badge-item__placeholder badge-item__placeholder--gots"><span>GOTS</span></div>
                {% endif %}
              </div>
              <div class="badge-item">
                {% if block.settings.badge_2 != blank %}
                  <img src="{{ block.settings.badge_2 | img_url: '120x60' }}" alt="{{ block.settings.badge_2_alt }}" class="badge-item__img">
                {% else %}
                  <div class="badge-item__placeholder badge-item__placeholder--oeko"><span>OEKO-TEX®<br><small>STANDARD 100</small></span></div>
                {% endif %}
              </div>
            </div>
            {% endif %}
          </div>
        </div>
      </div>
    </section>

    {% when 'feature_image_right' %}
    <section class="about-feature section-padding" {{ block.shopify_attributes }}>
      <div class="container">
        <div class="about-feature__grid about-feature__grid--image-right" style="background:#fff;">
          <div class="about-feature__content">
            <h2 class="about-feature__title">{{ block.settings.heading }}</h2>
            <div class="about-feature__text"><p>{{ block.settings.text }}</p></div>
          </div>
          <div class="about-feature__image-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '', crop: '' }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" class="about-feature__image">
            {% else %}
              {{ 'collection-2' | placeholder_svg_tag: 'about-feature__image about-feature__image--placeholder' }}
            {% endif %}
          </div>
        </div>
      </div>
    </section>

    {% when 'divider' %}
    <div class="bar" {{ block.shopify_attributes }}></div>

    {% when 'community' %}
   <div class="au-community">
  <div class="au-community__inner">
    <p class="au-community__label">Our Community</p>
    <h2 class="au-community__heading">Join A Community That Shares Your Values</h2>
    <hr class="au-community__divider">
    <div class="au-community__text"><p>tangelos isn't just a bedding - it's a thoughtful lifestyle choice. We unite people who value honest materials, genuine craftsmanship, and ethical practices. <strong>Join thousands across the UK who trust us, reflected in our 4.6 rating,</strong> and who believe in making sleep restorative, responsible, and personal.</p></div><div class="au-community__rating">
        <span class="au-community__stars">★★★★★</span>
        <span>4.6 rating</span>
      </div></div>
</div>

    {% endcase %}
  {% endfor %}
</div>

<style class="">
  /* ── Container system ── */
  .au-container {
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    padding-left: 20px;
    padding-right: 20px;
    max-width: 1200px; /* theme container */
  }
  .au-container--fluid {
    max-width: 100%;
    padding-left: 0;
    padding-right: 0;
  }

  /* ── Hero ── */
  .au-hero {
    position: relative;
    height: 320px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .au-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .au-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.38);
  }
  .au-hero__text {
    position: relative;
    z-index: 1;
    color: #fff;
  }
  /* Design: eyebrow ~12px, title ~48px */
  .au-hero__eyebrow {
    font-size: 0.75rem;        /* 12px */
    letter-spacing: 0.15em;
    text-transform: lowercase;
    margin: 0 0 8px;
    opacity: 0.9;
  }
  .au-hero__title {
    font-size: clamp(2.5rem, 6vw, 3.5rem); /* ~40–56px */
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.1;
  }

  /* ── Why section ── */
  .au-why {
    max-width: 700px;
    margin: 64px auto;
    padding: 0 20px;
    text-align: center;
  }
  /* Design: heading ~22px, body ~14px, tagline ~13px bold */
  .au-why__heading {
    font-size: 1.375rem;       /* 22px */
    font-weight: 600;
    margin: 0 0 20px;
    line-height: 1.3;
  }
  .au-why__body {
    font-size: 0.875rem;       /* 14px */
    line-height: 1.8;
    color: #444;
    margin: 0 0 16px;
  }
  .au-why__tagline {
    font-size: 0.8125rem;      /* 13px */
    font-weight: 700;
    margin: 0;
    color: #222;
  }

  /* ── Feature rows shared ── */
  .au-wrap {
    margin-bottom: 56px;
  }
  .au-feature,
  .au-f2 {
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  /* Container mode: gap + rounded card */
  .au-feature {
    gap: 0;
    background: #f7f6f4;
    border-radius: 12px;
  }
  .au-f2 {
    gap: 0;
    background: transparent;
    border-radius: 12px;
  }

  /* Images */
  .au-feature__img {
    flex-shrink: 0;
    width: 44%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
  }
  /* Container mode: image gets radius on outer corners */
  .au-feature .au-feature__img {
    border-radius: 12px 0 0 12px;
  }
  .au-f2 .au-feature__img {
    order: 2;
    border-radius: 0 12px 12px 0;
  }

  /* Full-width mode: flush, 50/50 */
  .au-feature--fluid .au-feature__img,
  .au-f2--fluid .au-feature__img {
    width: 50%;
    border-radius: 0;
  }
  .au-feature--fluid,
  .au-f2--fluid {
    border-radius: 0;
    background: transparent;
  }
  .au-feature--fluid {
    background: #f7f6f4;
  }

  /* Body padding */
  .au-feature__body {
    flex: 1;
    padding: 40px 48px;
  }
  .au-f2 .au-feature__body {
    padding: 40px 48px;
  }
  /* Fluid: more breathing room */
  .au-feature--fluid .au-feature__body,
  .au-f2--fluid .au-feature__body {
    padding: 56px 72px;
  }

  /* Design: feature heading ~22px, body ~13.5px */
  .au-feature__heading {
    font-size: 1.375rem;       /* 22px */
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 14px;
    color: #1a1a1a;
  }
  .au-feature__text {
    font-size: 0.84375rem;     /* 13.5px */
    line-height: 1.75;
    color: #555;
    margin: 0 0 18px;
  }
  .au-badges {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .au-badges img {
    height: 46px;
    width: auto;
  }

  /* ── Community ── */
  .au-community {
    background: #f0ece6;
    padding: 80px 20px;
    text-align: center;
  }
  .au-community__inner {
    max-width: 580px;
    margin: 0 auto;
  }
  /* Design: label ~11px, heading ~28px, body ~14px */
  .au-community__label {
    font-size: 0.6875rem;      /* 11px */
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #999;
    margin: 0 0 16px;
  }
  .au-community__heading {
    font-size: clamp(1.5rem, 3vw, 1.75rem); /* 24–28px */
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 18px;
    color: #1a1a1a;
  }
  .au-community__divider {
    width: 36px;
    height: 2px;
    background: #c8a97e;
    margin: 0 auto 22px;
    border: none;
  }
  .au-community__text {
    font-size: 0.875rem;       /* 14px */
    line-height: 1.8;
    color: #555;
    margin: 0 auto 28px;
  }
  .au-community__text strong {
    color: #1a1a1a;
    font-weight: 600;
  }
  .au-community__rating {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border-radius: 40px;
    padding: 10px 22px;
    font-size: 0.8125rem;      /* 13px */
    font-weight: 600;
    color: #333;
    box-shadow: 0 2px 14px rgba(0,0,0,0.08);
  }
  .au-community__stars {
    color: #00b67a;
    font-size: 0.9rem;
    letter-spacing: 2px;
  }

  /* ── Mobile ── */
  @media (max-width: 680px) {
    .au-feature,
    .au-f2,
    .au-feature--fluid,
    .au-f2--fluid {
      flex-direction: column;
      border-radius: 8px;
    }
    .au-feature__img,
    .au-f2 .au-feature__img,
    .au-feature--fluid .au-feature__img,
    .au-f2--fluid .au-feature__img {
      width: 100%;
      border-radius: 8px 8px 0 0;
      order: unset;
      aspect-ratio: 16/9;
    }
    .au-feature__body,
    .au-f2 .au-feature__body,
    .au-feature--fluid .au-feature__body,
    .au-f2--fluid .au-feature__body {
      padding: 28px 20px !important;
    }
    .au-hero { height: 240px; }
    .au-community { padding: 56px 20px; }
    .au-why { margin: 48px auto; }
  }
</style>
{% schema %}
