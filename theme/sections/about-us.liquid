        { "type": "textarea", "id": "text", "label": "Body Text", "default": "Good bedding is an investment." },
        { "type": "checkbox", "id": "show_badges", "label": "Show Badges", "default": false },
        { "type": "image_picker", "id": "badge_1", "label": "Badge 1 Image" },
