    },
    {
      "type": "header",
      "content": "Scroll CTA"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_cta",
      "label": "Show scroll CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "Scroll label",
      "default": "SCROLL"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
