{% comment %} templates/customers/reset_password.liquid {% endcomment %}

<div class="reset-page-bg">
  <div class="reset-card">

    <div class="reset-logo">
      {%- assign brand_logo = settings.logo | default: shop.brand.logo -%}
      {%- if brand_logo -%}
        <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {{ brand_logo | image_url: width: 400 | image_tag:
             loading: 'eager',
             widths: '120, 200, 300, 400',
             sizes: '160px',
             alt: shop.name,
             class: 'reset-logo__image' }}
        </a>
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </div>

    <div class="reset-title">Reset your password</div>
    <div class="reset-subtitle">
      Enter a new password{% if email != blank %} for {{ email }}{% endif %}
    </div>

    {%- form 'reset_customer_password' -%}

      {%- if form.errors -%}
        <div class="reset-errors">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="reset-input-group">
        <label for="ResetPassword" class="reset-visually-hidden">New password</label>
        <input
          type="password"
          name="customer[password]"
          id="ResetPassword"
          placeholder="New password"
          autocomplete="new-password"
          required
          {% if form.errors contains 'password' %}class="reset-input--error"{% endif %}
        />
      </div>

      <div class="reset-input-group">
        <label for="PasswordConfirmation" class="reset-visually-hidden">Confirm password</label>
        <input
          type="password"
          name="customer[password_confirmation]"
          id="PasswordConfirmation"
          placeholder="Confirm password"
          autocomplete="new-password"
          required
          {% if form.errors contains 'password_confirmation' %}class="reset-input--error"{% endif %}
        />
      </div>

      <button type="submit" class="reset-btn">Reset password</button>

    {%- endform -%}

    <div class="reset-back">
      <a href="{{ routes.account_login_url }}">Back to sign in</a>
    </div>

  </div>
</div>

<style>
.reset-page-bg {
  min-height: 100vh;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 1rem;
}
.reset-page-bg *,
.reset-page-bg *::before,
.reset-page-bg *::after {
  box-sizing: border-box;
}
.reset-card {
  background: #fff;
  border-radius: 12px;
  padding: 2.5rem 2.25rem 2rem;
  width: 100%;
  max-width: 420px;
}
.reset-logo {
  text-align: center;
  margin-bottom: 1.75rem;
  font-size: 2.2rem;
  font-family: Georgia, 'Times New Roman', serif;
  font-weight: 700;
  letter-spacing: -1px;
  color: #111;
  text-transform: lowercase;
}
.reset-logo__image {
  display: block;
  width: 160px;
  height: auto;
  margin: 0 auto;
}
.reset-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: #111;
  margin-bottom: 0.25rem;
}
.reset-subtitle {
  font-size: 0.875rem;
  color: #888;
  margin-bottom: 1.5rem;
  word-break: break-word;
}
.reset-input-group {
  margin-bottom: 0.9rem;
}
.reset-input-group input {
  width: 100%;
  padding: 0.75rem 1rem;
  border: 1.5px solid #cce0ff;
  border-radius: 8px;
  font-size: 0.95rem;
  color: #222;
  outline: none;
  background: #fff;
  transition: border-color 0.15s;
}
.reset-input-group input:focus {
  border-color: #2563eb;
}
.reset-input-group input::placeholder {
  color: #aaa;
}
.reset-input-group input.reset-input--error {
  border-color: #dc2626;
}
.reset-visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}
.reset-btn {
  width: 100%;
  padding: 0.85rem;
  background: #2563eb;
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  margin-top: 0.25rem;
  margin-bottom: 1rem;
  transition: background 0.15s;
}
.reset-btn:hover {
  background: #1d4ed8;
}
.reset-errors {
  background: #fee2e2;
  color: #991b1b;
  padding: 0.75rem 1rem;
  border-radius: 8px;
  font-size: 0.85rem;
  margin-bottom: 1rem;
}
.reset-errors ul {
  margin: 0;
  padding-left: 1.1rem;
}
.reset-back {
  text-align: center;
  font-size: 0.85rem;
}
.reset-back a {
  color: #2563eb;
  font-weight: 500;
  text-decoration: none;
}
</style>

