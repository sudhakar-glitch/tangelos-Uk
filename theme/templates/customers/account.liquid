<style>
*,
*::before,
*::after {
  box-sizing: border-box;
}
.dashboard-wrap {
  min-height: 100vh;
  background: #f0f0f0;
  padding: 2rem 1rem;
  font-family: inherit;
}
.dashboard-inner {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 1.5rem;
  align-items: start;
}
@media (max-width: 768px) {
  .dashboard-inner {
    grid-template-columns: 1fr;
  }
  .side-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 1rem !important;
  }
  .nav-item {
    flex: 1 1 auto;
    text-align: center !important;
    padding: 0.6rem 1rem !important;
    border-left: none !important;
    border-radius: 8px !important;
    border: 1px solid #e5e5e5 !important;
  }
  .nav-item.active {
    border-color: #2563eb !important;
  }
}

/* Side Nav */
.side-nav {
  background: #fff;
  border-radius: 12px;
  padding: 1.5rem 0;
  position: sticky;
  top: 1.5rem;
}
.nav-logo {
  font-size: 1.5rem;
  font-family: Georgia, 'Times New Roman', serif;
  font-weight: 700;
  letter-spacing: -1px;
  color: #111;
  text-transform: lowercase;
  text-decoration: none;
  display: block;
  text-align: center;
  padding: 0 1.5rem 1.25rem;
  border-bottom: 1px solid #e5e5e5;
  margin-bottom: 0.75rem;
}
.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0.7rem 1.5rem;
  font-size: 0.875rem;
  color: #555;
  text-decoration: none;
  cursor: pointer;
  border-left: 3px solid transparent;
  transition: all 0.15s;
  background: none;
  border-top: none;
  border-right: none;
  border-bottom: none;
  width: 100%;
  text-align: left;
}
.nav-item:hover {
  color: #111;
  background: #f5f5f5;
}
.nav-item.active {
  color: #2563eb;
  font-weight: 600;
  border-left-color: #2563eb;
  background: #f0f5ff;
}
.nav-item svg {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}
.nav-divider {
  border: none;
  border-top: 1px solid #e5e5e5;
  margin: 0.75rem 0;
}
.nav-logout {
  color: #dc2626 !important;
}
.nav-logout:hover {
  background: #fef2f2 !important;
}
.nav-user {
  padding: 0.75rem 1.5rem;
  margin-bottom: 0.5rem;
}
.nav-user-name {
  font-size: 0.9rem;
  font-weight: 600;
  color: #111;
}
.nav-user-email {
  font-size: 0.78rem;
  color: #888;
  margin-top: 2px;
}

/* Main Content */
.dashboard-main {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.dash-section {
  display: none;
}
.dash-section.active {
  display: block;
}
.section-card {
  background: #fff;
  border-radius: 12px;
  padding: 1.75rem 2rem;
  margin-bottom: 1.5rem;
}
.section-card:last-child {
  margin-bottom: 0;
}
.section-title {
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #111;
  margin-bottom: 1.25rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid #e5e5e5;
}

/* Stats */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-bottom: 1.5rem;
}
@media (max-width: 580px) {
  .stats-grid { grid-template-columns: 1fr 1fr; }
}
.stat-card {
  background: #f8f9fa;
  border-radius: 10px;
  padding: 1.25rem;
  text-align: center;
}
.stat-value {
  font-size: 1.5rem;
  font-weight: 700;
  color: #111;
}
.stat-label {
  font-size: 0.78rem;
  color: #888;
  margin-top: 4px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

/* Orders Table */
.orders-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.875rem;
}
.orders-table th {
  text-align: left;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #888;
  padding: 0 0 0.75rem;
  border-bottom: 1px solid #e5e5e5;
}
.orders-table td {
  padding: 0.85rem 0;
  border-bottom: 1px solid #f0f0f0;
  color: #444;
  vertical-align: middle;
}
.orders-table tr:last-child td {
  border-bottom: none;
}
.order-link {
  color: #2563eb;
  text-decoration: none;
  font-weight: 600;
}
.order-link:hover { text-decoration: underline; }
.badge {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 600;
  padding: 3px 9px;
  border-radius: 20px;
  text-transform: capitalize;
}
.badge-paid { background: #dcfce7; color: #166534; }
.badge-pending { background: #fef9c3; color: #854d0e; }
.badge-refunded { background: #fee2e2; color: #991b1b; }
.badge-fulfilled { background: #dbeafe; color: #1e40af; }
.badge-unfulfilled { background: #f3f4f6; color: #374151; }
.no-data {
  color: #aaa;
  font-size: 0.9rem;
  padding: 1rem 0;
}

/* Address Cards */
.address-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}
@media (max-width: 580px) {
  .address-grid { grid-template-columns: 1fr; }
}
.address-card {
  border: 1.5px solid #e5e5e5;
  border-radius: 10px;
  padding: 1.25rem;
  position: relative;
}
.address-card.is-default {
  border-color: #2563eb;
}
.default-badge {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 600;
  background: #dbeafe;
  color: #1e40af;
  padding: 2px 9px;
  border-radius: 20px;
  margin-bottom: 0.6rem;
}
.address-name {
  font-size: 0.9rem;
  font-weight: 600;
  color: #111;
  margin-bottom: 0.35rem;
}
.address-lines {
  font-size: 0.85rem;
  color: #555;
  line-height: 1.7;
}
.address-lines p { margin: 0; }
.address-actions {
  display: flex;
  gap: 0.75rem;
  margin-top: 0.9rem;
}
.btn-link {
  font-size: 0.8rem;
  color: #2563eb;
  text-decoration: none;
  font-weight: 500;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
}
.btn-link:hover { text-decoration: underline; }
.btn-link-danger {
  color: #dc2626;
}

/* Profile Form */
.profile-form .form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.9rem;
  margin-bottom: 0.9rem;
}
@media (max-width: 580px) {
  .profile-form .form-row { grid-template-columns: 1fr; }
}
.profile-form .form-group {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.profile-form .form-group.full {
  grid-column: 1 / -1;
}
.profile-form label {
  font-size: 0.8rem;
  font-weight: 600;
  color: #555;
}
.profile-form input {
  padding: 0.7rem 1rem;
  border: 1.5px solid #cce0ff;
  border-radius: 8px;
  font-size: 0.9rem;
  color: #222;
  outline: none;
  background: #fff;
  transition: border-color 0.15s;
}
.profile-form input:focus { border-color: #2563eb; }
.profile-form input::placeholder { color: #aaa; }
.btn-primary {
  background: #2563eb;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 0.7rem 1.5rem;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s;
  margin-top: 0.5rem;
}
.btn-primary:hover { background: #1d4ed8; }
.form-errors {
  background: #fee2e2;
  color: #991b1b;
  padding: 0.75rem 1rem;
  border-radius: 8px;
  font-size: 0.85rem;
  margin-bottom: 1rem;
}
</style>

<div class="dashboard-wrap">
  <div class="dashboard-inner">

    <!-- Side Nav -->
    <nav class="side-nav">
      <a href="/" class="nav-logo">{{ shop.name }}</a>

      <div class="nav-user">
        <div class="nav-user-name">{{ customer.first_name }} {{ customer.last_name }}</div>
        <div class="nav-user-email">{{ customer.email }}</div>
      </div>

      <button class="nav-item active" onclick="showSection('dashboard', this)">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Dashboard
      </button>

      <button class="nav-item" onclick="showSection('orders', this)">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
        Orders
      </button>

      <button class="nav-item" onclick="showSection('addresses', this)">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Addresses
      </button>

      <button class="nav-item" onclick="showSection('profile', this)">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        Profile
      </button>

      <hr class="nav-divider">

      <a href="/account/logout" class="nav-item nav-logout">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        Sign out
      </a>
    </nav>

    <!-- Main Content -->
    <div class="dashboard-main">

      <!-- Dashboard Section -->
      <div class="dash-section active" id="section-dashboard">

        <div class="section-card">
          <div class="section-title">Overview</div>
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-value">{{ customer.orders_count }}</div>
              <div class="stat-label">Total orders</div>
            </div>
            <div class="stat-card">
              <div class="stat-value">{{ customer.total_spent | money }}</div>
              <div class="stat-label">Total spent</div>
            </div>
            <div class="stat-card">
              <div class="stat-value">{{ customer.addresses.size }}</div>
              <div class="stat-label">Addresses</div>
            </div>
          </div>
        </div>

        <div class="section-card">
          <div class="section-title">Recent orders</div>
          {%- if customer.orders.size > 0 -%}
            <table class="orders-table">
              <thead>
                <tr>
                  <th>Order</th>
                  <th>Date</th>
                  <th>Payment</th>
                  <th>Fulfillment</th>
                  <th>Total</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders limit: 5 -%}
                <tr>
                  <td><a href="{{ order.customer_url }}" class="order-link">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: "%b %d, %Y" }}</td>
                  <td>
                    <span class="badge badge-{{ order.financial_status }}">
                      {{ order.financial_status | replace: '_', ' ' | capitalize }}
                    </span>
                  </td>
                  <td>
                    <span class="badge badge-{{ order.fulfillment_status | default: 'unfulfilled' }}">
                      {{ order.fulfillment_status | default: 'Unfulfilled' | replace: '_', ' ' | capitalize }}
                    </span>
                  </td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- else -%}
            <p class="no-data">No orders yet.</p>
          {%- endif -%}
        </div>

        <div class="section-card">
          <div class="section-title">Default address</div>
          {%- if customer.default_address -%}
            <div class="address-lines">
              <p>{{ customer.default_address.name }}</p>
              <p>{{ customer.default_address.address1 }}</p>
              {%- if customer.default_address.address2 != blank -%}
                <p>{{ customer.default_address.address2 }}</p>
              {%- endif -%}
              <p>{{ customer.default_address.city }}, {{ customer.default_address.province_code }} {{ customer.default_address.zip }}</p>
              <p>{{ customer.default_address.country }}</p>
            </div>
          {%- else -%}
            <p class="no-data">No default address set.</p>
          {%- endif -%}
        </div>

      </div>

      <!-- Orders Section -->
      <div class="dash-section" id="section-orders">
        <div class="section-card">
          <div class="section-title">All orders</div>
          {%- if customer.orders.size > 0 -%}
            <table class="orders-table">
              <thead>
                <tr>
                  <th>Order</th>
                  <th>Date</th>
                  <th>Payment</th>
                  <th>Fulfillment</th>
                  <th>Total</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}" class="order-link">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: "%b %d, %Y" }}</td>
                  <td>
                    <span class="badge badge-{{ order.financial_status }}">
                      {{ order.financial_status | replace: '_', ' ' | capitalize }}
                    </span>
                  </td>
                  <td>
                    <span class="badge badge-{{ order.fulfillment_status | default: 'unfulfilled' }}">
                      {{ order.fulfillment_status | default: 'Unfulfilled' | replace: '_', ' ' | capitalize }}
                    </span>
                  </td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- else -%}
            <p class="no-data">You haven't placed any orders yet.</p>
          {%- endif -%}
        </div>
      </div>

      <!-- Addresses Section -->
      <div class="dash-section" id="section-addresses">
        <div class="section-card">
          <div class="section-title">My addresses</div>
          {%- if customer.addresses.size > 0 -%}
            <div class="address-grid">
              {%- for address in customer.addresses -%}
                <div class="address-card {% if address == customer.default_address %}is-default{% endif %}">
                  {%- if address == customer.default_address -%}
                    <span class="default-badge">Default</span>
                  {%- endif -%}
                  <div class="address-name">{{ address.name }}</div>
                  <div class="address-lines">
                    <p>{{ address.address1 }}</p>
                    {%- if address.address2 != blank -%}<p>{{ address.address2 }}</p>{%- endif -%}
                    <p>{{ address.city }}, {{ address.province_code }} {{ address.zip }}</p>
                    <p>{{ address.country }}</p>
                    {%- if address.phone != blank -%}<p>{{ address.phone }}</p>{%- endif -%}
                  </div>
                  <div class="address-actions">
                    <a href="/account/addresses/{{ address.id }}" class="btn-link">Edit</a>
                    {%- form 'customer_address', address, id: "del-{{ address.id }}" -%}
                      <input type="hidden" name="_method" value="delete" />
                      <button type="submit" class="btn-link btn-link-danger" onclick="return confirm('Delete this address?')">Delete</button>
                    {%- endform -%}
                    {%- unless address == customer.default_address -%}
                      {%- form 'customer_address', address, id: "def-{{ address.id }}" -%}
                        <input type="hidden" name="_method" value="put" />
                        <input type="hidden" name="address[default]" value="true" />
                        <button type="submit" class="btn-link" style="color:#555;">Set default</button>
                      {%- endform -%}
                    {%- endunless -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- else -%}
            <p class="no-data">No addresses saved yet.</p>
          {%- endif -%}
          <div style="margin-top:1.25rem;">
            <a href="/account/addresses" class="btn-primary" style="display:inline-block; text-decoration:none;">+ Add address</a>
          </div>
        </div>
      </div>

      <!-- Profile Section -->
      <div class="dash-section" id="section-profile">
        <div class="section-card">
          <div class="section-title">Profile details</div>
          {%- form 'customer', customer -%}
            {%- if form.errors -%}
              <div class="form-errors">{{ form.errors | default_errors }}</div>
            {%- endif -%}
            <div class="profile-form">
              <div class="form-row">
                <div class="form-group">
                  <label for="ProfileFirstName">First name</label>
                  <input type="text" id="ProfileFirstName" name="customer[first_name]" value="{{ customer.first_name }}" placeholder="First name" autocomplete="given-name" />
                </div>
                <div class="form-group">
                  <label for="ProfileLastName">Last name</label>
                  <input type="text" id="ProfileLastName" name="customer[last_name]" value="{{ customer.last_name }}" placeholder="Last name" autocomplete="family-name" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group full">
                  <label for="ProfileEmail">Email</label>
                  <input type="email" id="ProfileEmail" name="customer[email]" value="{{ customer.email }}" placeholder="Email" autocomplete="email" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group full">
                  <label for="ProfilePhone">Phone (optional)</label>
                  <input type="tel" id="ProfilePhone" name="customer[phone]" value="{{ customer.phone }}" placeholder="Phone" autocomplete="tel" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="ProfilePassword">New password</label>
                  <input type="password" id="ProfilePassword" name="customer[password]" placeholder="New password" autocomplete="new-password" />
                </div>
                <div class="form-group">
                  <label for="ProfilePasswordConfirm">Confirm password</label>
                  <input type="password" id="ProfilePasswordConfirm" name="customer[password_confirmation]" placeholder="Confirm password" />
                </div>
              </div>
              <button type="submit" class="btn-primary">Save changes</button>
            </div>
          {%- endform -%}
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  function showSection(name, el) {
    document.querySelectorAll('.dash-section').forEach(function(s) {
      s.classList.remove('active');
    });
    document.querySelectorAll('.nav-item').forEach(function(n) {
      n.classList.remove('active');
    });
    document.getElementById('section-' + name).classList.add('active');
    el.classList.add('active');
  }
</script>
