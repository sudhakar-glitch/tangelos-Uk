              "name": "t:names.heading",
              "settings": {
                "text": "<h2>Declutter and Add Personal Touches</h2>",
                "width": "fit-content",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
