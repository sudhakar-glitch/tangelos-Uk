              "settings": {
                "heading": "Does a percale duvet cover get softer over time?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_KGXwk6": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes, percale duvet covers get softer over time. With each wash, the crisp fabric naturally relaxes, becoming smoother and more comfortable while still retaining its breathable, lightweight feel.          </p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "paragraph",
