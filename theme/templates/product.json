              ]
            },
            "accordion_row_LneNPW": {
              "type": "_accordion-row",
              "disabled": true,
              "settings": {
                "heading": "Is percale better than sateen for summer?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_wcFN8y": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes, percale is better than sateen for summer. Its crisp, lightweight, and breathable weave allows more airflow, keeping you cool and comfortable on warm nights.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "paragraph",
