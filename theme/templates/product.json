              "name": "t:names.accordion_row",
              "disabled": true,
              "settings": {
                "heading": "Are percale duvet covers good for sensitive skin?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_XDJgXy": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Yes, percale duvet covers are great for sensitive skin. Their smooth, breathable cotton weave is gentle, non-irritating, and free from heavy finishes, making them ideal for those with delicate or allergy-prone skin.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
